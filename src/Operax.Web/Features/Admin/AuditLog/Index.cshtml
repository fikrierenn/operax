@page
@model Operax.Web.Features.Admin.AuditLog.IndexModel
@{
    ViewData["Title"] = "Denetim Kayıtları";
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-2 mb-2 text-xs">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Ayarlar
            </a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Sistem</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-600 font-semibold">Denetim Kayıtları</span>
        </div>
        <h1>Denetim Kayıtları</h1>
        <p class="page-hdr-sub">Sistem üzerinde gerçekleştirilen tüm işlemlerin güvenli denetim geçmişi</p>
    </div>
</div>

<!-- Filtre Paneli -->
<form method="get" class="card mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 p-4 bg-slate-50/50 border-b border-slate-200">
        <div class="form-group mb-0">
            <label class="form-label">Kullanıcı</label>
            <input type="text" name="user" value="@Model.FilterUser"
                   placeholder="Kullanıcı adı..."
                   class="form-ctrl w-full" />
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Aksiyon</label>
            <input type="text" name="action" value="@Model.FilterAction"
                   placeholder="CREATE, UPDATE, DELETE..."
                   class="form-ctrl w-full" />
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Kayıt Tipi</label>
            <input type="text" name="entity" value="@Model.FilterEntity"
                   placeholder="ReceivingHeader, Item..."
                   class="form-ctrl w-full" />
        </div>
        <div class="flex gap-2 self-end h-[38px]">
            <button type="submit" class="btn btn-primary flex-1">Filtrele</button>
            <a asp-page="./Index" class="btn btn-secondary flex-1">Temizle</a>
        </div>
    </div>
</form>

<!-- Kayıt Listesi -->
<div class="card mb-4">
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Tarih / Saat</th>
                    <th>Kullanıcı</th>
                    <th class="text-center">Aksiyon</th>
                    <th>Kayıt Tipi</th>
                    <th>Kayıt ID</th>
                    <th>Detay</th>
                    <th class="text-right">IP Adresi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entries)
                {
                    <tr>
                        <td class="whitespace-nowrap text-xs text-slate-500 font-mono">
                            @e.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")
                        </td>
                        <td class="font-semibold text-slate-800">@e.UserName</td>
                        <td class="text-center">
                            @{
                                var badgeClass = e.Action switch
                                {
                                    "CREATE"  => "b-green",
                                    "UPDATE"  => "b-blue",
                                    "DELETE"  => "b-red",
                                    "POST"    => "b-purple",
                                    "LOGIN"   => "b-amber",
                                    _ => "b-gray"
                                };
                            }
                            <span class="badge @badgeClass">@e.Action</span>
                        </td>
                        <td class="text-xs font-mono text-indigo-600">@e.EntityType</td>
                        <td class="text-xs font-mono text-slate-400">
                            @(e.EntityId?.ToString("D")[..8])...
                        </td>
                        <td class="text-xs text-slate-600 max-w-[280px] truncate" title="@e.Details">
                            @e.Details
                        </td>
                        <td class="text-right text-xs font-mono text-slate-400">@e.IpAddress</td>
                    </tr>
                }
                @if (!Model.Entries.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="w-10 h-10 text-slate-300">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z"/>
                                </svg>
                                <p class="text-slate-400 font-medium">Uyumlu denetim kaydı bulunamadı.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Entries.Any())
{
    <p class="text-[11px] text-slate-400 font-semibold tracking-wide text-right uppercase">
        Son 200 denetim kaydı gösterilmektedir
    </p>
}

