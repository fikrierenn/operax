@page
@model Operax.Web.Features.Admin.Dictionary.IndexModel
@{
    ViewData["Title"] = "Sözlük Yönetimi";
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-2 mb-2 text-xs">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Ayarlar
            </a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Sistem</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-600 font-semibold">Sözlük</span>
        </div>
        <h1>Sözlük Tanımları (Dictionary)</h1>
        <p class="page-hdr-sub">Sistem genelindeki tip tanımları, birimler ve statü değerleri</p>
    </div>
    <div class="page-hdr-r">
        <button class="btn btn-primary" data-shortcut="Alt+N">
            <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Yeni Tip
        </button>
    </div>
</div>

<div class="card">
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Ad (TR)</th>
                    <th>Ad (EN)</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in Model.Types)
                {
                    <tr class="group">
                        <td class="text-xs font-mono font-bold text-indigo-600">@type.Code</td>
                        <td class="font-semibold text-slate-800">@type.NameTr</td>
                        <td class="text-xs text-slate-400">@type.NameEn</td>
                        <td class="text-right">
                            <a asp-page="./Values" asp-route-typeId="@type.Id" class="btn btn-secondary btn-sm">
                                Değerleri Yönet
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
</div>

