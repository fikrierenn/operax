@page "{typeId:guid}"
@model Operax.Web.Features.Admin.Dictionary.ValuesModel
@{
    ViewData["Title"] = $"{Model.Type?.NameTr} Değerleri";
    var t = Model.Type!;
}

<div class="page" data-screen-label="Sözlük Değerleri">

    <div class="stmt-toolbar no-print" style="margin-bottom:14px;">
        <a asp-page="./Index" class="btn btn-ghost">‹ Geri (Sözlük)</a>
        <div>
            <h1 style="margin:0;">@t.NameTr</h1>
            <div class="muted">Tip Kodu: <span class="mono text-brand">@t.Code</span>
                @if (t.AllowValueCrud) { <span class="badge badge-info">Dinamik — tam yönetim</span> }
                else { <span class="badge badge-neutral">Sistem tipi — yalnız etiket</span> }
            </div>
        </div>
    </div>

    @if (TempData["Success"] is string ok) { <div class="alert-banner alert-info" style="margin-bottom:12px;">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert-banner alert-danger" style="margin-bottom:12px;">@err</div> }

    @if (!t.AllowValueCrud)
    {
        <div class="alert-banner alert-warn" style="margin-bottom:12px;">
            Bu tip iş mantığında (SP/ledger) kullanılır — kod eklenemez/silinemez (kayıtlar bozulur).
            Yalnız görünen <strong>etiket</strong> (Türkçe/İngilizce ad, sıra) düzenlenebilir; etiket değişikliği her ekrana yansır.
        </div>
    }

    @* ───── Yeni değer (yalnız dinamik tipte) ───── *@
    @if (t.AllowValueCrud)
    {
        <div class="card" style="margin-bottom:14px;">
            <form method="post" asp-page-handler="Add" class="card-body">
                @Html.AntiForgeryToken()
                <input type="hidden" name="typeId" value="@t.Id" />
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Kod <span class="req">*</span></label>
                        <input name="code" class="form-ctrl" placeholder="örn. NET45" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Türkçe Ad <span class="req">*</span></label>
                        <input name="nameTr" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">İngilizce Ad</label>
                        <input name="nameEn" class="form-ctrl" />
                    </div>
                </div>
                <div class="form-row" style="margin-top:8px;align-items:end;">
                    <div class="form-group" style="max-width:120px;">
                        <label class="form-label">Sıra</label>
                        <input name="orderNo" type="number" class="form-ctrl" value="100" />
                    </div>
                    <div class="form-group" style="align-self:end;">
                        <button type="submit" class="btn btn-primary">Değer Ekle</button>
                    </div>
                </div>
            </form>
        </div>
    }

    @* ───── Değer listesi ───── *@
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:60px;">Sıra</th>
                    <th>Kod</th>
                    <th>Ad (TR)</th>
                    <th>Ad (EN)</th>
                    <th>Durum</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Values)
                {
                    @* Satır-içi düzenleme toggle'ı vanilla JS ile (CSP'de unsafe-eval yok → Alpine x-data/x-show sessizce kırıktı). *@
                    <tr>
                        @* ── Görüntüleme modu (6 hücre) ── *@
                        <td data-dict-view class="mono muted">@v.OrderNo</td>
                        <td data-dict-view class="mono text-brand">@v.Code
                            @if (v.IsGlobal) { <span class="badge badge-neutral" style="margin-left:4px;">global</span> }
                        </td>
                        <td data-dict-view class="row-strong">@v.NameTr</td>
                        <td data-dict-view class="muted">@(string.IsNullOrEmpty(v.NameEn) ? "—" : v.NameEn)</td>
                        <td data-dict-view>
                            @if (v.IsActive) { <span class="badge badge-success">AKTİF</span> }
                            else { <span class="badge badge-neutral">PASİF</span> }
                        </td>
                        <td data-dict-view class="text-right">
                            <button type="button" class="btn btn-secondary btn-sm" onclick="dictRowEdit(this, true)">Düzenle</button>
                            <form method="post" asp-page-handler="ToggleActive" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="typeId" value="@t.Id" />
                                <input type="hidden" name="valueId" value="@v.Id" />
                                <button type="submit" class="btn btn-ghost btn-sm">@(v.IsActive ? "Pasife Al" : "Aktif Et")</button>
                            </form>
                            @if (t.AllowValueCrud)
                            {
                                <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Bu değer silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="typeId" value="@t.Id" />
                                    <input type="hidden" name="valueId" value="@v.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm text-danger">Sil</button>
                                </form>
                            }
                        </td>

                        @* ── Düzenleme modu (tüm satırı kaplar; CODE değişmez) ── *@
                        <td data-dict-edit colspan="6" style="display:none;">
                            <form method="post" asp-page-handler="Edit" class="row" style="gap:8px;align-items:end;flex-wrap:wrap;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="typeId" value="@t.Id" />
                                <input type="hidden" name="valueId" value="@v.Id" />
                                <div class="form-group" style="max-width:80px;">
                                    <label class="form-label">Kod</label>
                                    <input class="form-ctrl mono" value="@v.Code" readonly />
                                </div>
                                <div class="form-group" style="max-width:80px;">
                                    <label class="form-label">Sıra</label>
                                    <input name="orderNo" type="number" class="form-ctrl" value="@v.OrderNo" />
                                </div>
                                <div class="form-group" style="flex:1;min-width:150px;">
                                    <label class="form-label">Türkçe Ad</label>
                                    <input name="nameTr" class="form-ctrl" value="@v.NameTr" required />
                                </div>
                                <div class="form-group" style="flex:1;min-width:150px;">
                                    <label class="form-label">İngilizce Ad</label>
                                    <input name="nameEn" class="form-ctrl" value="@v.NameEn" />
                                </div>
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary btn-sm">Kaydet</button>
                                    <button type="button" class="btn btn-ghost btn-sm" onclick="dictRowEdit(this, false)">Vazgeç</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Values.Any())
                {
                    <tr><td colspan="6" class="muted" style="text-align:center;padding:24px;">Henüz değer tanımlanmamış.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Satır-içi düzenleme toggle — vanilla (CSP unsafe-eval yok; Alpine yerine).
   Düzenle → görüntü hücrelerini gizle, edit hücresini göster; Vazgeç → tersi. *@
<script>
    function dictRowEdit(btn, on) {
        var tr = btn.closest('tr');
        if (!tr) return;
        // Görüntüleme hücreleri (6 adet) açık/kapalı
        tr.querySelectorAll('[data-dict-view]').forEach(function (el) {
            el.style.display = on ? 'none' : 'table-cell';
        });
        // Tam-genişlik düzenleme hücresi
        var ed = tr.querySelector('[data-dict-edit]');
        if (ed) ed.style.display = on ? 'table-cell' : 'none';
    }
</script>
