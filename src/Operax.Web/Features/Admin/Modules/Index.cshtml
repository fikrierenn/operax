@page
@model Operax.Web.Features.Admin.Modules.IndexModel
@{
    ViewData["Title"] = "Modül Aktivasyonu";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <a asp-page="/Admin/Settings/Index" class="breadcrumb-item">Sistem</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Modüller</span>
        </div>
        <h1>Modül Aktivasyonu</h1>
        <p class="page-hdr-sub">Şirketiniz için platform özelliklerini etkinleştirin veya devre dışı bırakın</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Ayarlar
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var m in Model.Modules)
    {
        <div class="card p-6 flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <span class="text-[10px] font-bold text-[var(--text-4)] uppercase tracking-widest">@m.Code</span>
                    <h3 class="font-bold text-lg text-[var(--text)]">@m.NameTr</h3>
                    <p class="text-xs text-[var(--text-3)] mt-1">@m.NameEn</p>
                </div>
                <div class="w-10 h-10 bg-[var(--surface-2)] rounded-lg flex items-center justify-center text-[var(--text-4)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </div>
            </div>

            <div class="flex items-center justify-between mt-6 pt-6 border-t border-[var(--border)]">
                @if (m.IsActive) { <span class="badge badge-success"><span class="badge-dot"></span>AKTİF</span> }
                else { <span class="badge badge-neutral"><span class="badge-dot"></span>PASİF</span> }
                <form method="post">
                    <input type="hidden" name="moduleId" value="@m.Id" />
                    @* Bool değil string olarak yaz: Razor bool attribute minimization value="@(true)" → value="value" üretir, bool bind kırılır (enable çalışmaz) *@
                    <input type="hidden" name="active" value="@((!m.IsActive).ToString().ToLowerInvariant())" />
                    <button type="submit" class="btn btn-sm @(m.IsActive ? "btn-ghost" : "btn-primary")">
                        @(m.IsActive ? "Devre Dışı Bırak" : "Etkinleştir")
                    </button>
                </form>
            </div>
        </div>
    }
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
