@page
@using Operax.Web.Lib
@model Operax.Web.Features.Admin.NumberSeries.IndexModel
@{
    ViewData["Title"] = "Belge Serileri";
    var header = new PageHeaderVm(
        Title: "Belge Serileri",
        Crumbs: new[] { "Anasayfa", "Yönetim", "Belge Serileri" },
        Sub: "Otomatik numaralama önekleri ve sıraları — cari, fatura, sipariş, çek/senet"
    );
}

<div class="page" data-screen-label="Belge Serileri">
    <partial name="_PageHeader" model="header" />

    @if (TempData["Success"] is string ok) { <div class="alert-banner alert-info">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert-banner alert-danger">@err</div> }

    @* Her satır için ayrı form (tablo dışı) — inputlar form="" ile bağlanır (geçerli HTML) *@
    @foreach (var s in Model.Series)
    {
        <form id="f_@s.Id" method="post" asp-page-handler="Save">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@s.Id" />
        </form>
        <form id="d_@s.Id" method="post" asp-page-handler="Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@s.Id" />
        </form>
    }

    @* Yeni belge serisi — yalnızca tanımlı olmayan katalog tipleri eklenebilir *@
    <div class="card">
        <div class="card-hdr">
            <div class="card-title">Yeni Belge Serisi</div>
            <div class="card-sub">Tanımlı olmayan belge tipi için seri ekle</div>
        </div>
        @if (Model.AvailableDocTypes.Count == 0)
        {
            <p class="card-sub">Tüm belge tipleri için seri tanımlı.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Create">
                @Html.AntiForgeryToken()
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Belge Tipi <span class="req">*</span></label>
                        <select name="docType" class="form-ctrl" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var o in Model.AvailableDocTypes)
                            {
                                <option value="@o.Code">@o.Label</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Önek <span class="req">*</span></label>
                        <input name="prefix" class="form-ctrl" maxlength="15" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ayraç</label>
                        <input name="separator" class="form-ctrl" maxlength="3" value="-" />
                    </div>
                </div>
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Sonraki No</label>
                        <input name="nextNo" type="number" min="1" value="1" class="form-ctrl" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Dolgu</label>
                        <input name="padding" type="number" min="1" max="9" value="6" class="form-ctrl" />
                    </div>
                    <div class="form-group" style="display:flex;align-items:flex-end;">
                        <button type="submit" class="btn btn-primary">Ekle</button>
                    </div>
                </div>
            </form>
        }
    </div>

    <div class="card">
        <div class="card-hdr">
            <div class="card-title">Seriler</div>
            <div class="card-sub">@Model.Series.Count belge tipi</div>
        </div>
        @if (Model.Series.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateVm("Seri yok", "Tanımlı belge serisi bulunamadı. migrate ile seed edilir."))" />
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Belge Tipi</th><th>Önek</th><th>Ayraç</th>
                        <th class="num">Sonraki No</th><th class="num">Dolgu</th>
                        <th>Önizleme</th><th>Aktif</th><th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Series)
                    {
                        var preview = s.Prefix + s.Separator + (s.NextNo.ToString().PadLeft(s.Padding, '0'));
                        var fid = $"f_{s.Id}";
                        <tr>
                            <td class="row-strong">@Operax.Web.Features.Admin.NumberSeries.IndexModel.DocTypeLabel(s.DocType)</td>
                            <td><input form="@fid" name="prefix" value="@s.Prefix" class="form-ctrl" style="width:90px;" maxlength="15" /></td>
                            <td><input form="@fid" name="separator" value="@s.Separator" class="form-ctrl" style="width:50px;" maxlength="3" /></td>
                            <td class="num"><input form="@fid" name="nextNo" type="number" min="1" value="@s.NextNo" class="form-ctrl" style="width:90px;" /></td>
                            <td class="num"><input form="@fid" name="padding" type="number" min="1" max="9" value="@s.Padding" class="form-ctrl" style="width:64px;" /></td>
                            <td class="mono muted">@preview</td>
                            <td>
                                <label class="chk-row">
                                    <span class="chk"><input form="@fid" name="isActive" type="checkbox" value="true" checked="@s.IsActive" /><span class="chk-box"></span></span>
                                </label>
                            </td>
                            <td>
                                <button type="submit" form="@fid" class="btn btn-primary btn-sm">Kaydet</button>
                                @if (s.NextNo == 1)
                                {
                                    <button type="submit" form="d_@s.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu belge serisini silmek istediğinize emin misiniz?');">Sil</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
</div>
