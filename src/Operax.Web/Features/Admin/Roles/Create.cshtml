@page
@model Operax.Web.Features.Admin.Roles.CreateModel
@{
    ViewData["Title"] = "Yeni Yetki Grubu";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <a asp-page="./Index" class="breadcrumb-item">Sistem</a>
            <span class="breadcrumb-sep">/</span>
            <a asp-page="./Index" class="breadcrumb-item">Yetki Grupları</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Yeni</span>
        </div>
        <h1>Yeni Yetki Grubu</h1>
        <p class="page-hdr-sub">Sisteme yeni bir rol / erişim seviyesi tanımlayın</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Index" class="btn btn-secondary btn-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Geri
        </a>
    </div>
</div>

<div class="card" style="max-width:500px;margin:0 auto">
    <div class="card-hdr">
        <span class="card-title">Rol Bilgileri</span>
    </div>
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="All" class="form-error" style="margin-bottom:12px"></div>

            <div class="form-group">
                <label class="form-label">Rol Adı <span class="req">*</span></label>
                <input name="RoleName" class="form-ctrl" type="text" placeholder="ör. Depo Personeli" required autofocus />
                <span class="form-hint">Boşluk kullanmayın, İngilizce tercih edin (ör. WarehouseStaff)</span>
            </div>

            <div class="form-row" style="margin-top:20px">
                <button type="submit" class="btn btn-primary" style="justify-content:center">Oluştur</button>
                <a asp-page="./Index" class="btn btn-secondary" style="justify-content:center">İptal</a>
            </div>
        </form>
    </div>
</div>
