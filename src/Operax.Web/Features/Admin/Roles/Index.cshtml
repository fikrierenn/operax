@page
@model Operax.Web.Features.Admin.Roles.IndexModel
@{
    ViewData["Title"] = "Yetki Grupları";
}

<div class="page-hdr">
    <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Ayarlar
            </a>
            <span style="font-size:11px;color:#64748b">Sistem / Yetki Grupları</span>
        </div>
        <h1>Yetki Grupları (Roles)</h1>
        <p>Erişim seviyeleri ve modül bazlı yetkilendirme yönetimi</p>
    </div>
    <div class="page-hdr-r">
        <button class="btn btn-primary" data-shortcut="Alt+N">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Rol
        </button>
    </div>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>Rol Adı</th>
                <th>Yetki Seviyesi</th>
                <th style="text-align:right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Roles)
            {
                <tr class="group">
                    <td>
                        <div style="display:flex;align-items:center;gap:10px">
                            <div style="width:10px;height:10px;border-radius:50%;background:#818cf8"></div>
                            <div style="font-weight:700;font-size:13px;letter-spacing:0.5px">@r.Name</div>
                        </div>
                    </td>
                    <td>
                        <span style="font-size:12.5px;color:#94a3b8;font-style:italic">Tüm Modüller</span>
                    </td>
                    <td style="text-align:right">
                        <button class="btn btn-secondary btn-sm" style="color:#818cf8">Yetkileri Düzenle</button>
                        <button class="btn btn-secondary btn-sm" style="color:#f87171;margin-left:4px">Sil</button>
                    </td>
                </tr>
            }
            @if (!Model.Roles.Any())
            {
                <tr>
                    <td colspan="3">
                        <div class="empty-state">
                            <p>Henüz rol tanımlanmamış</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
