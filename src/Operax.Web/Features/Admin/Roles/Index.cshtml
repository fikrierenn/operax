@page
@model Operax.Web.Features.Admin.Roles.IndexModel
@{
    ViewData["Title"] = "Yetki Grupları";
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-2 mb-2 text-xs">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Ayarlar
            </a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Sistem</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-600 font-semibold">Yetki Grupları</span>
        </div>
        <h1>Yetki Grupları</h1>
        <p class="page-hdr-sub">Erişim seviyeleri ve modül bazlı yetkilendirme yönetimi</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Create" class="btn btn-primary" data-shortcut="Alt+N">
            <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Yeni Rol
        </a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert-banner alert-danger mb-4"></div>
}

<div class="card">
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Rol Adı</th>
                    <th>Yetki Seviyesi</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Roles)
                {
                    <tr class="group">
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="w-2.5 h-2.5 rounded-full bg-indigo-500 animate-pulse"></div>
                                <span class="font-bold text-xs tracking-wider text-slate-800 uppercase">@r.Name</span>
                            </div>
                        </td>
                        <td>
                            <span class="text-xs font-medium text-slate-400 italic">Tüm Modüller</span>
                        </td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-2">
                                @if (r.Name != "Administrator")
                                {
                                    <a asp-page="./Permissions" asp-route-id="@r.Id"
                                       class="btn btn-secondary btn-sm">
                                        Modül İzinleri
                                    </a>
                                    <form method="post" class="inline"
                                          onsubmit="return confirm('@r.Name rolünü silmek istediğinizden emin misiniz?')">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button asp-page-handler="Delete"
                                                class="btn btn-secondary btn-sm !text-red-500 hover:!bg-red-50/50 hover:!border-red-200 transition">
                                            Sil
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-[11px] font-semibold text-slate-400 tracking-wide uppercase bg-slate-100 py-1 px-2.5 rounded-md border border-slate-200">
                                        Sistem Rolü
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Roles.Any())
                {
                    <tr>
                        <td colspan="3">
                            <div class="empty-state">
                                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="w-10 h-10 text-slate-300">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 15l3-3m0 0l-3-3m3 3h-7.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <p class="text-slate-400 font-medium">Henüz herhangi bir yetki grubu tanımlanmamış.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
</div>

