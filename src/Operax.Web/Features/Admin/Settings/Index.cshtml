@page
@model Operax.Web.Features.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "Sistem Ayarları";
    var header = new PageHeaderVm(
        Title: "Sistem Ayarları",
        Crumbs: new[] { "Anasayfa", "Yönetim", "Sistem Ayarları" },
        Sub: "Platform parametreleri, kullanıcı yetkileri ve genel tanımlar");
}

<div class="page" data-screen-label="Sistem Ayarları">
    <partial name="_PageHeader" model="header" />

    <div class="settings-hub">

        <!-- Sistem Tanımları -->
        <div class="card settings-card">
            <div class="card-hdr">
                <div>
                    <span class="card-title">Sistem Tanımları</span>
                    <p class="card-sub">Global ve modül bazlı parametre yönetimi</p>
                </div>
                <span class="settings-card-icon">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                </span>
            </div>
            <div class="card-body">
                <a asp-page="/Admin/Dictionary/Index" class="nav-tile">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    </span>
                    <span class="nav-tile-title">Sözlük (Dictionary) Yönetimi</span>
                    <svg class="nav-tile-chevron" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-page="/Admin/Parameters/Index" class="nav-tile">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.07 4.93l-1.41 1.41M4.93 4.93l1.41 1.41M4.93 19.07l1.41-1.41M19.07 19.07l-1.41-1.41M1 12h2M21 12h2M12 1v2M12 21v2"/>
                        </svg>
                    </span>
                    <span class="nav-tile-title">Sistem Parametreleri</span>
                    <svg class="nav-tile-chevron" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-page="/Admin/CompanyProfile/Index" class="nav-tile">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3"/></svg>
                    </span>
                    <span class="nav-tile-title">Şirket Profili</span>
                    <svg class="nav-tile-chevron" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
        </div>

        <!-- Personel & Güvenlik -->
        <div class="card settings-card accent-success">
            <div class="card-hdr">
                <div>
                    <span class="card-title">Personel & Güvenlik</span>
                    <p class="card-sub">Kullanıcı erişimi ve yetki seviyeleri</p>
                </div>
                <span class="settings-card-icon">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
            </div>
            <div class="card-body">
                <a asp-page="/Admin/Users/Index" class="nav-tile">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                    </span>
                    <span class="nav-tile-title">Kullanıcı Yönetimi</span>
                    <svg class="nav-tile-chevron" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-page="/Admin/Roles/Index" class="nav-tile">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </span>
                    <span class="nav-tile-title">Yetki Grupları (Roles)</span>
                    <svg class="nav-tile-chevron" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
                <a asp-page="/Admin/AuditLog/Index" class="nav-tile">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 17H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/><path d="M13 21l2 2 4-4"/><path d="M9 7h6M9 11h4"/></svg>
                    </span>
                    <span class="nav-tile-title">Denetim Kayıtları</span>
                    <svg class="nav-tile-chevron" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
        </div>

        <!-- Organizasyon -->
        <div class="card settings-card accent-warn">
            <div class="card-hdr">
                <div>
                    <span class="card-title">Organizasyon</span>
                    <p class="card-sub">Şirket yapılandırması ve genel ayarlar</p>
                </div>
                <span class="settings-card-icon">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                    </svg>
                </span>
            </div>
            <div class="card-body">
                <div class="nav-tile is-disabled">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 21h18M3 7v14M21 7v14M9 21V11h6v10m-8-14l5-5 5 5"/></svg>
                    </span>
                    <span class="nav-tile-body">
                        <span class="nav-tile-title">Şirket Bilgileri</span>
                        <span class="nav-tile-note">Yakında Aktif Edilecek</span>
                    </span>
                </div>
                <div class="nav-tile is-disabled">
                    <span class="nav-tile-icon">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    </span>
                    <span class="nav-tile-body">
                        <span class="nav-tile-title">Şube & Lokasyonlar</span>
                        <span class="nav-tile-note">Yakında Aktif Edilecek</span>
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>
