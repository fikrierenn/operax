@page
@model Operax.Web.Features.Admin.Settings.IndexModel
@{
    ViewData["Title"] = "Sistem Ayarları";
}

<div class="page-hdr">
    <div>
        <h1>Sistem Ayarları</h1>
        <p class="page-hdr-sub">Platform parametreleri, kullanıcı yetkileri ve genel tanımlar</p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Sistem Tanımları -->
    <div class="card">
        <div class="card-hdr bg-indigo-50/30">
            <div>
                <span class="card-ttl">Sistem Tanımları</span>
                <p class="text-[11px] text-slate-500 font-normal mt-0.5">Global ve modül bazlı parametre yönetimi</p>
            </div>
            <div class="text-indigo-500">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
            </div>
        </div>
        <div class="card-body p-4 flex flex-col gap-2.5">
            <a asp-page="/Admin/Dictionary/Index" class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:border-indigo-200 hover:bg-indigo-50/10 transition group text-slate-700 hover:text-indigo-600">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 group-hover:bg-indigo-100 transition">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold">Sözlük (Dictionary) Yönetimi</span>
                <svg class="ml-auto w-3 h-3 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </a>
            
            <a asp-page="/Admin/Parameters/Index" class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:border-indigo-200 hover:bg-indigo-50/10 transition group text-slate-700 hover:text-indigo-600">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-500 group-hover:bg-indigo-100 transition">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.07 4.93l-1.41 1.41M4.93 4.93l1.41 1.41M4.93 19.07l1.41-1.41M19.07 19.07l-1.41-1.41M1 12h2M21 12h2M12 1v2M12 21v2"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold">Sistem Parametreleri</span>
                <svg class="ml-auto w-3 h-3 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </a>
        </div>
    </div>

    <!-- Personel & Güvenlik -->
    <div class="card">
        <div class="card-hdr bg-emerald-50/30">
            <div>
                <span class="card-ttl">Personel & Güvenlik</span>
                <p class="text-[11px] text-slate-500 font-normal mt-0.5">Kullanıcı erişimi ve yetki seviyeleri</p>
            </div>
            <div class="text-emerald-500">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
        </div>
        <div class="card-body p-4 flex flex-col gap-2.5">
            <a asp-page="/Admin/Users/Index" class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:border-emerald-200 hover:bg-emerald-50/10 transition group text-slate-700 hover:text-emerald-600">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-500 group-hover:bg-emerald-100 transition">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold">Kullanıcı Yönetimi</span>
                <svg class="ml-auto w-3 h-3 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </a>
            
            <a asp-page="/Admin/Roles/Index" class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:border-emerald-200 hover:bg-emerald-50/10 transition group text-slate-700 hover:text-emerald-600">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-500 group-hover:bg-emerald-100 transition">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold">Yetki Grupları (Roles)</span>
                <svg class="ml-auto w-3 h-3 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </a>
            
            <a asp-page="/Admin/AuditLog/Index" class="flex items-center gap-3 p-3 rounded-xl border border-slate-200 hover:border-emerald-200 hover:bg-emerald-50/10 transition group text-slate-700 hover:text-emerald-600">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-500 group-hover:bg-emerald-100 transition">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 17H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3"/>
                        <path d="M13 21l2 2 4-4"/>
                        <path d="M9 7h6M9 11h4"/>
                    </svg>
                </div>
                <span class="text-xs font-semibold">Denetim Kayıtları</span>
                <svg class="ml-auto w-3 h-3 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </a>
        </div>
    </div>

    <!-- Organizasyon -->
    <div class="card">
        <div class="card-hdr bg-amber-50/30">
            <div>
                <span class="card-ttl">Organizasyon</span>
                <p class="text-[11px] text-slate-500 font-normal mt-0.5">Şirket yapılandırması ve genel ayarlar</p>
            </div>
            <div class="text-amber-500">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8M12 17v4"/>
                </svg>
            </div>
        </div>
        <div class="card-body p-4 flex flex-col gap-2.5">
            <div class="flex items-center gap-3 p-3 rounded-xl border border-slate-100 bg-slate-50/50 text-slate-400 cursor-not-allowed">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 21h18M3 7v14M21 7v14M9 21V11h6v10m-8-14l5-5 5 5"/>
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-xs font-semibold">Şirket Bilgileri</span>
                    <span class="text-[10px] text-slate-400 font-medium">Yakında Aktif Edilecek</span>
                </div>
            </div>
            
            <div class="flex items-center gap-3 p-3 rounded-xl border border-slate-100 bg-slate-50/50 text-slate-400 cursor-not-allowed">
                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400">
                    <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                </div>
                <div class="flex flex-col">
                    <span class="text-xs font-semibold">Şube & Lokasyonlar</span>
                    <span class="text-[10px] text-slate-400 font-medium">Yakında Aktif Edilecek</span>
                </div>
            </div>
        </div>
    </div>
</div>

