@page
@model Operax.Web.Features.Admin.StatusTransitions.IndexModel
@{
    ViewData["Title"] = "Statü Geçişleri";
}

<div class="page-hdr">
    <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Ayarlar
            </a>
            <span style="font-size:11px;color:#64748b">Sistem / Statü Geçişleri</span>
        </div>
        <h1>Statü Geçişleri</h1>
        <p>Belge yaşam döngüsü ve iş akışı kurallarını tanımlayın</p>
    </div>
    <div class="page-hdr-r">
        <button class="btn btn-primary" data-shortcut="Alt+N">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Geçiş
        </button>
    </div>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>Belge Tipi</th>
                <th style="text-align:center">Kaynak Statü</th>
                <th style="text-align:center"></th>
                <th style="text-align:center">Hedef Statü</th>
                <th>Aksiyon Adı</th>
                <th style="text-align:right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Transitions)
            {
                <tr class="hover:bg-slate-50 transition-colors group">
                    <td style="font-weight:700;font-size:13px">@t.DocumentType</td>
                    <td style="text-align:center">
                        <span class="badge b-gray" style="font-family:monospace">@t.FromStatusCode</span>
                    </td>
                    <td style="text-align:center;color:#cbd5e1">
                        <svg class="w-4 h-4 mx-auto" style="display:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </td>
                    <td style="text-align:center">
                        <span class="badge b-blue" style="font-family:monospace">@t.ToStatusCode</span>
                    </td>
                    <td style="font-size:13px;font-weight:500">@t.ActionNameTr</td>
                    <td style="text-align:right">
                        <button class="btn btn-secondary btn-sm" style="color:#f87171">Sil</button>
                    </td>
                </tr>
            }
            @if (!Model.Transitions.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <p>Henüz statü geçişi tanımlanmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
