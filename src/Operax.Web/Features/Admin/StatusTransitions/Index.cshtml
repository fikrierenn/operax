@page
@model Operax.Web.Features.Admin.StatusTransitions.IndexModel
@{
    ViewData["Title"] = "Statü Geçişleri";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <a asp-page="/Admin/Settings/Index" class="breadcrumb-item">Sistem</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Statü Geçişleri</span>
        </div>
        <h1>Statü Geçişleri</h1>
        <p class="page-hdr-sub">Belge yaşam döngüsü ve iş akışı kurallarını tanımlayın</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Ayarlar
        </a>
        <button class="btn btn-primary" data-shortcut="Alt+N">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Geçiş
        </button>
    </div>
</div>

<div class="card">
    <table class="data-table w-full">
        <thead>
            <tr>
                <th>Belge Tipi</th>
                <th class="text-center">Kaynak Statü</th>
                <th class="text-center"></th>
                <th class="text-center">Hedef Statü</th>
                <th>Aksiyon Adı</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Transitions)
            {
                <tr>
                    <td class="row-strong">@t.DocumentType</td>
                    <td class="text-center">
                        <span class="badge b-gray mono">@t.FromStatusCode</span>
                    </td>
                    <td class="text-center text-[var(--text-mute)]">
                        <svg class="w-4 h-4 mx-auto inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </td>
                    <td class="text-center">
                        <span class="badge b-blue mono">@t.ToStatusCode</span>
                    </td>
                    <td>@t.ActionNameTr</td>
                    <td class="text-right">
                        <button class="btn btn-ghost btn-sm text-[var(--danger)]">Sil</button>
                    </td>
                </tr>
            }
            @if (!Model.Transitions.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <p>Henüz statü geçişi tanımlanmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
