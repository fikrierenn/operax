@page
@model Operax.Web.Features.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-2 mb-2 text-xs">
            <a asp-page="./Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Geri
            </a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Sistem</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Kullanıcılar</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-600 font-semibold">Yeni</span>
        </div>
        <h1>Yeni Kullanıcı Oluştur</h1>
        <p class="page-hdr-sub">Sisteme yeni bir personel hesabı tanımlayın</p>
    </div>
</div>

<div class="max-w-xl mx-auto">
    <div class="card">
        <div class="card-hdr bg-slate-50/50">
            <span class="card-ttl">Kullanıcı Bilgileri</span>
        </div>
        <div class="card-body p-6">
            <form method="post" class="flex flex-col gap-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert-banner alert-danger"></div>
                }

                <div class="form-group">
                    <label class="form-label">E-Posta (Giriş Adı)</label>
                    <input asp-for="Input.Email" type="email" placeholder="örn. admin@operax.com" class="form-ctrl w-full" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Geçici Şifre</label>
                    <input asp-for="Input.Password" type="password" placeholder="••••••••" class="form-ctrl w-full" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Yetki Grubu</label>
                    <select asp-for="Input.Role" class="form-ctrl w-full">
                        <option value="">Kullanıcı (Rol Yok)</option>
                        <option value="Administrator">Yönetici (Administrator)</option>
                    </select>
                </div>

                <div class="flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary flex-1">Hesabı Oluştur</button>
                    <a asp-page="./Index" class="btn btn-secondary flex-1">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>
