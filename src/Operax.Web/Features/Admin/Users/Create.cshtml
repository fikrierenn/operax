@page
@model Operax.Web.Features.Admin.Users.CreateModel
@{
    ViewData["Title"] = "Yeni Kullanıcı";
}

<div class="page-hdr">
    <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <a asp-page="./Index" class="btn btn-secondary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Geri
            </a>
            <span style="font-size:11px;color:#64748b">Sistem / Kullanıcılar / Yeni</span>
        </div>
        <h1>Yeni Kullanıcı Oluştur</h1>
        <p>Sisteme yeni bir personel hesabı tanımlayın</p>
    </div>
</div>

<div class="card" style="max-width:500px;margin:0 auto">
    <div class="card-hdr">
        <span class="card-ttl">Kullanıcı Bilgileri</span>
    </div>
    <div class="card-body">
        <form method="post" style="display:flex;flex-direction:column;gap:16px">
            <div asp-validation-summary="All" style="color:var(--red);font-size:12px;margin-bottom:10px"></div>

            <div class="form-group">
                <label>E-Posta (Giriş Adı)</label>
                <input asp-for="Input.Email" type="email" placeholder="orn. admin@operax.com" required />
            </div>

            <div class="form-group">
                <label>Geçici Şifre</label>
                <input asp-for="Input.Password" type="password" placeholder="••••••••" required />
            </div>

            <div style="margin-top:20px;display:flex;gap:10px">
                <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center">Hesabı Oluştur</button>
                <a asp-page="./Index" class="btn btn-secondary" style="flex:1;justify-content:center">İptal</a>
            </div>
        </form>
    </div>
</div>
