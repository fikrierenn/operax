@page "{id}"
@model Operax.Web.Features.Admin.Users.EditModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="page-hdr">
    <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <a asp-page="./Index" class="btn btn-secondary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Geri
            </a>
            <span style="font-size:11px;color:#64748b">Sistem / Kullanıcılar / Düzenle</span>
        </div>
        <h1>Kullanıcıyı Düzenle</h1>
        <p>Erişim yetkilerini ve hesap bilgilerini güncelleyin</p>
    </div>
</div>

<div class="card" style="max-width:500px;margin:0 auto">
    <div class="card-hdr">
        <span class="card-ttl">Hesap Detayları</span>
    </div>
    <div class="card-body">
        <form method="post" style="display:flex;flex-direction:column;gap:16px">
            <input type="hidden" asp-for="Input.Id" />
            <div asp-validation-summary="All" style="color:var(--red);font-size:12px;margin-bottom:10px"></div>

            <div class="form-group">
                <label>Kullanıcı Adı</label>
                <input asp-for="Input.UserName" readonly style="opacity:0.6;background:var(--bg)" />
            </div>

            <div class="form-group">
                <label>E-Posta</label>
                <input asp-for="Input.Email" type="email" required />
            </div>

            <div class="form-group">
                <label>Yeni Şifre (Değiştirmek istemiyorsanız boş bırakın)</label>
                <input asp-for="Input.NewPassword" type="password" placeholder="••••••••" />
            </div>

            <div style="margin-top:20px;display:flex;gap:10px">
                <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center">Değişiklikleri Kaydet</button>
                <a asp-page="./Index" class="btn btn-secondary" style="flex:1;justify-content:center">İptal</a>
            </div>
        </form>
    </div>
</div>
