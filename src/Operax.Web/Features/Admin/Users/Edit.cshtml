@page "{id}"
@model Operax.Web.Features.Admin.Users.EditModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-2 mb-2 text-xs">
            <a asp-page="./Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Geri
            </a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Sistem</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Kullanıcılar</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-600 font-semibold">Düzenle</span>
        </div>
        <h1>Kullanıcıyı Düzenle</h1>
        <p class="page-hdr-sub">Erişim yetkilerini ve hesap bilgilerini güncelleyin</p>
    </div>
</div>

<div class="max-w-xl mx-auto">
    <div class="card">
        <div class="card-hdr bg-slate-50/50">
            <span class="card-ttl">Hesap Detayları</span>
        </div>
        <div class="card-body p-6">
            <form method="post" class="flex flex-col gap-4">
                <input type="hidden" asp-for="Input.Id" />
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert-banner alert-danger"></div>
                }

                <div class="form-group">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input asp-for="Input.UserName" readonly class="form-ctrl w-full opacity-60 bg-slate-100 cursor-not-allowed select-none" />
                </div>

                <div class="form-group">
                    <label class="form-label">E-Posta</label>
                    <input asp-for="Input.Email" type="email" class="form-ctrl w-full" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Yeni Şifre</label>
                    <input asp-for="Input.NewPassword" type="password" placeholder="•••••••• (Değiştirmek istemiyorsanız boş bırakın)" class="form-ctrl w-full" />
                </div>

                <div class="form-group">
                    <label class="form-label">Yetki Grubu</label>
                    <select asp-for="Input.Role" class="form-ctrl w-full">
                        <option value="">Kullanıcı (Rol Yok)</option>
                        <option value="Administrator">Yönetici (Administrator)</option>
                    </select>
                </div>

                <div class="flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary flex-1">Değişiklikleri Kaydet</button>
                    <a asp-page="./Index" class="btn btn-secondary flex-1">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>
