@page
@model Operax.Web.Features.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-2 mb-2 text-xs">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Ayarlar
            </a>
            <span class="text-slate-400">/</span>
            <span class="text-slate-400 font-medium">Sistem</span>
            <span class="text-slate-400">/</span>
            <span class="text-slate-600 font-semibold">Kullanıcılar</span>
        </div>
        <h1>Kullanıcı Yönetimi</h1>
        <p class="page-hdr-sub">Platform erişimi, personel hesapları ve güvenlik ayarları</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Create" class="btn btn-primary" data-shortcut="Alt+N">
            <svg fill="none" class="w-4 h-4" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Yeni Kullanıcı
        </a>
    </div>
</div>

<div class="card">
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>E-Posta</th>
                    <th>Yetki Grupları</th>
                    <th>Durum</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand to-brand-light flex items-center justify-center text-xs font-bold text-white shadow-sm shadow-indigo-100">
                                    @u.Email.Substring(0, 1).ToUpper()
                                </div>
                                <span class="font-semibold text-slate-800">@u.UserName</span>
                            </div>
                        </td>
                        <td>
                            <span class="text-xs font-medium text-slate-500">@u.Email</span>
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var role in u.Roles)
                                {
                                    <span class="badge b-blue">@role</span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge b-green">AKTİF</span>
                        </td>
                        <td class="text-right">
                            <a asp-page="./Edit" asp-route-id="@u.Id" class="btn btn-secondary btn-sm">Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

