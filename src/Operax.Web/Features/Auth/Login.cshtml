@page "/login"
@model Operax.Web.Features.Auth.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş";
}
<!DOCTYPE html>
<html lang="tr" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş — OPERAX</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full flex items-center justify-center p-6 bg-slate-100">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200">
            <div class="bg-slate-900 p-8 text-center">
                <div class="w-12 h-12 bg-indigo-600 rounded-lg mx-auto flex items-center justify-center text-white font-bold text-xl mb-4">OX</div>
                <h2 class="text-2xl font-bold text-white tracking-tight uppercase">OPERAX</h2>
                <p class="text-slate-400 text-sm mt-1">Hesabınıza giriş yapın</p>
            </div>

            <form method="post" class="p-8 space-y-6">
                @if (!ModelState.IsValid)
                {
                    <div class="bg-red-50 border-l-4 border-red-500 p-4 text-red-700 text-sm">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div>
                    <label asp-for="Input.Email" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">E-posta Adresi</label>
                    <input asp-for="Input.Email" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:border-transparent outline-none transition-all placeholder:text-slate-400" placeholder="ad@sirket.com" />
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Şifre</label>
                    <input asp-for="Input.Password" type="password" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-600 focus:border-transparent outline-none transition-all placeholder:text-slate-400" placeholder="••••••••" />
                </div>

                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer group">
                        <input type="checkbox" asp-for="Input.RememberMe" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" />
                        <span class="text-sm text-slate-600 group-hover:text-slate-900 transition-colors">Beni hatırla</span>
                    </label>
                    <a href="#" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">Şifremi unuttum</a>
                </div>

                <button type="submit" class="w-full bg-slate-900 text-white font-bold py-3.5 rounded-lg hover:bg-slate-800 active:scale-[0.98] transition-all shadow-lg">
                    Giriş Yap
                </button>
            </form>

            <div class="p-6 bg-slate-50 border-t border-slate-200 text-center">
                <p class="text-xs text-slate-500 uppercase tracking-widest font-medium">Çok Şirketli Mimari v2.2</p>
            </div>
        </div>

        <p class="text-center text-slate-500 text-xs mt-8">
            &copy; 2026 Operax Platform. Tüm hakları saklıdır.
        </p>
    </div>
</body>
</html>
