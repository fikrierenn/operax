@page "/login"
@model Operax.Web.Features.Auth.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş";
}
<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş — OPERAX</title>
    <!-- Premium Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full flex items-center justify-center p-6 bg-[hsl(220,14%,97%)] font-sans antialiased text-slate-900">
    <div class="w-full max-w-[400px] fade-in">
        <div class="text-center mb-8 flex flex-col items-center">
            <!-- Standalone Logo Brand Mark -->
            <div class="side-brand-mark w-12 h-12 rounded-xl mb-3 flex items-center justify-center text-white font-extrabold text-base shadow-lg shadow-indigo-200">
                OX
            </div>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight uppercase leading-none">OPERAX</h1>
            <p class="text-slate-400 text-[9px] uppercase tracking-widest font-bold mt-1.5">ERP & WMS Platformu</p>
        </div>

        <div class="card p-8 bg-white border border-slate-200 shadow-lg">
            <h2 class="text-lg font-bold text-slate-800 tracking-tight mb-1">Sistem Girişi</h2>
            <p class="text-xs text-slate-500 mb-6">Lütfen kullanıcı kimlik bilgilerinizi giriniz.</p>

            <form method="post" class="flex flex-col gap-4">
                @if (!ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert-banner alert-danger text-xs font-semibold py-2.5 px-3.5 mb-2"></div>
                }

                <div class="form-group mb-0">
                    <label class="form-label text-[10px] tracking-wider font-bold text-slate-400" asp-for="Input.Email">E-POSTA ADRESİ</label>
                    <input asp-for="Input.Email" type="email" class="form-ctrl w-full text-xs font-semibold" placeholder="ad.soyad@operax.com" required autofocus />
                </div>

                <div class="form-group mb-0">
                    <div class="flex justify-between items-center mb-1">
                        <label class="form-label text-[10px] tracking-wider font-bold text-slate-400 mb-0" asp-for="Input.Password">ŞİFRE</label>
                        <a href="#" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">Şifremi Unuttum</a>
                    </div>
                    <input asp-for="Input.Password" type="password" class="form-ctrl w-full text-xs" placeholder="••••••••" required />
                </div>

                <div class="flex items-center justify-between my-2">
                    <label class="flex items-center gap-2 cursor-pointer group select-none">
                        <input type="checkbox" asp-for="Input.RememberMe" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                        <span class="text-xs text-slate-600 font-medium group-hover:text-slate-900 transition-colors">Beni Hatırla</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-full btn-lg font-bold shadow-brand mt-2 text-sm">
                    Giriş Yap
                </button>
            </form>
        </div>

        <div class="text-center mt-8">
            <p class="text-[9px] text-slate-400 uppercase tracking-widest font-bold">
                Çok Şirketli Mimari &bull; &copy; 2026 Operax v3.0
            </p>
        </div>
    </div>
</body>
</html>

