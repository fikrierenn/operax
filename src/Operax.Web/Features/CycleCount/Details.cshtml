@page "{id:guid?}"
@model Operax.Web.Features.CycleCount.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Sayım Oturumu" : $"Sayım Belgesi {Model.Header.DocNo}";
}

<form method="post" class="fade-in">
    @* Mevcut belgede Id round-trip etmeli; yoksa POST'ta IsNew=true → yeni Guid ile sessiz duplicate draft. *@
    <input type="hidden" asp-for="Header.Id" />
    <div class="page-hdr">
        <div>
            <div class="flex items-center gap-2 mb-2 text-xs">
                <a asp-page="./Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                    <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                    Sayım Listesi
                </a>
                <span class="text-[var(--text-4)]">/</span>
                <span class="text-[var(--text-2)] font-semibold">Sayım Girişi</span>
            </div>
            <h1>@(Model.IsNew ? "Yeni Sayım Oturumu" : $"Sayım Oturumu: {Model.Header.DocNo}")</h1>
            <p class="page-hdr-sub">Fiziksel envanterinizi sistem kayıtları ile karşılaştırın ve doğrulayın</p>
        </div>
        <div class="page-hdr-r flex gap-2">
            <a asp-page="./Index" class="btn btn-secondary">
                İptal
            </a>
            @if (Model.IsNew)
            {
                <button type="submit" class="btn btn-primary" data-shortcut="Alt+S">
                    Sayımı Başlat
                </button>
            }
            @if (!Model.IsNew && Model.Header.Status != DocStatus.Completed)
            {
                <button type="submit" asp-page-handler="PostAdjustments" class="btn btn-success" data-shortcut="Alt+P">
                    Sayımı Kesinleştir ve Kapat
                </button>
            }
            @if (!Model.IsNew && Model.Header.Status == DocStatus.Completed)
            {
                <button type="submit" asp-page-handler="Reverse" class="btn btn-danger"
                        onclick="return confirm('Bu sayım iptal edilecek ve ters düzeltme hareketi yazılacak. Onaylıyor musunuz?');">
                    Sayımı İptal Et
                </button>
            }
        </div>
    </div>

    @if (Model.IsNew)
    {
        <div class="card p-8 max-w-lg mx-auto bg-[var(--surface)]">
            <div class="flex flex-col gap-4">
                <div class="form-group mb-0">
                    <label class="form-label">Sayım Yapılacak Depo</label>
                    <select asp-for="Header.WarehouseId" class="form-ctrl w-full" required>
                        <option value="">Depo Seçiniz...</option>
                        @foreach (var wh in Model.Warehouses)
                        {
                            <option value="@wh.Id">@wh.Code - @wh.Name</option>
                        }
                    </select>
                </div>
                <p class="text-xs text-[var(--text-4)] italic">Not: Bir sayım oturumu başlatmak, seçilen alandaki sistem stok hareketlerini geçici olarak kilitleyecektir.</p>
            </div>
        </div>
    }
</form>

@if (!Model.IsNew)
{
    <!-- Sayım Satırları -->
    <div class="card mb-6">
        <div class="card-hdr bg-[var(--bg-2)]">
            <span class="card-ttl">SAYIM SATIRLARI</span>
            @if (Model.Header.Status != DocStatus.Completed)
            {
                <button onclick="document.getElementById('add-cnt-modal').classList.remove('hidden')" class="btn btn-primary btn-sm" type="button" data-shortcut="Alt+N">
                    + Sayım Kaydet
                </button>
            }
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Raf</th>
                        <th class="text-right">Sistem Miktarı</th>
                        <th class="text-right">Sayım Miktarı</th>
                        <th class="text-right">Fark</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <div class="font-bold text-[var(--text)]">@line.ItemName</div>
                                <div class="text-xs text-[var(--text-4)] font-mono">@line.ItemCode</div>
                            </td>
                            <td><span class="font-mono text-xs text-[var(--text-2)] bg-[var(--bg-2)] px-2 py-0.5 rounded font-bold">@line.BinCode</span></td>
                            <td class="text-right font-mono italic text-[var(--text-4)] font-semibold">@line.QtySystem.ToString("N2")</td>
                            <td class="text-right font-mono font-bold text-[var(--text-2)]">@line.QtyCounted.ToString("N2")</td>
                            <td class="text-right">
                                @{
                                    var diffColor = line.QtyDifference == 0 ? "text-[var(--text-4)]"
                                                  : (line.QtyDifference > 0 ? "bg-[var(--success-bg)] text-[var(--success-text)]" : "bg-[var(--danger-bg)] text-[var(--danger)]");
                                }
                                <span class="font-mono font-bold px-2 py-0.5 rounded @diffColor">
                                    @(line.QtyDifference > 0 ? "+" : "")@line.QtyDifference.ToString("N2")
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Lines.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="w-10 h-10 text-[var(--text-mute)]">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                                    </svg>
                                    <p class="text-[var(--text-4)] font-medium">Bu sayım oturumunda henüz kayıt bulunmamaktadır. Başlamak için "+ Sayım Kaydet" düğmesine tıklayın.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Ürün Sayım Kaydet Modalı (Simple Modal) -->
    <div id="add-cnt-modal" class="hidden fixed inset-0 bg-[var(--overlay)] backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-[var(--surface)] rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200 border border-[var(--border)]">
            <div class="p-5 border-b border-[var(--border)] flex justify-between items-center bg-[var(--bg-2)]">
                <h3 class="font-bold text-base text-[var(--text)]">Fiziksel Sayım Kaydet</h3>
                <button onclick="document.getElementById('add-cnt-modal').classList.add('hidden')" class="text-[var(--text-4)] hover:text-[var(--text-2)] transition-all text-2xl font-light" type="button">&times;</button>
            </div>
            <form method="post" asp-page-handler="AddLine">
                <div class="p-6 space-y-4">
                    <div class="form-group mb-0">
                        <label class="form-label">Sayım Yapılan Raf</label>
                        <select name="binId" class="form-ctrl w-full" required>
                            <option value="">Raf Seçiniz...</option>
                            @foreach (var bin in Model.Bins)
                            {
                                <option value="@bin.Id">@bin.Code</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Ürün</label>
                        <select name="itemId" class="form-ctrl w-full" required>
                            <option value="">Ürün Seçiniz...</option>
                            @foreach (var item in Model.Items)
                            {
                                <option value="@item.Id">[@item.Code] @item.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Sayım Miktarı (ADET)</label>
                        <input name="qtyCounted" type="number" step="0.0001" class="form-ctrl w-full font-bold text-lg text-center" placeholder="0.0000" required />
                    </div>
                </div>
                <div class="p-5 bg-[var(--bg-2)] border-t border-[var(--border)] flex justify-end gap-3">
                    <button type="button" onclick="document.getElementById('add-cnt-modal').classList.add('hidden')" class="btn btn-secondary">İptal</button>
                    <button type="submit" class="btn btn-primary">Sayım Kaydını Ekle</button>
                </div>
            </form>
        </div>
    </div>
}
