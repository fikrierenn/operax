@page
@model Operax.Web.Features.CycleCount.IndexModel
@{
    ViewData["Title"] = "Döngüsel Sayım";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item hover:text-indigo-600">Stok Kontrol</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Döngüsel Sayım</span>
        </div>
        <h1>Döngüsel Sayım</h1>
        <p class="page-hdr-sub">Fiziksel stok doğrulama, envanter sayım oturumları ve sapma analizleri</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" class="btn btn-primary px-8">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Sayım Oturumu
        </a>
    </div>
</div>

<!-- Physical Inventory KPI Row -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-glow brand"></div>
        <span class="kpi-label text-indigo-600">
            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            Toplam Sayım Oturumu
        </span>
        <div class="kpi-value text-indigo-600">
            @Model.TotalSessions
            <span class="kpi-unit">oturum</span>
        </div>
        <div class="kpi-foot">
            <span class="kpi-trend text-slate-400">Şirket genelinde açılan oturumlar</span>
        </div>
    </div>
    
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <span class="kpi-label text-emerald-600">
            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            Aktif Sayılan Depolar
        </span>
        <div class="kpi-value text-emerald-600">
            @Model.ActiveCountingWarehouses
            <span class="kpi-unit">depo</span>
        </div>
        <div class="kpi-foot">
            @if (Model.ActiveCountingWarehouses > 0)
            {
                <span class="kpi-delta up">Canlı Sayım</span>
            }
            else
            {
                <span class="kpi-delta flat">Beklemede</span>
            }
        </div>
    </div>
    
    <div class="kpi">
        <div class="kpi-glow warn"></div>
        <span class="kpi-label text-amber-600">
            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
            Sayılan Toplam Satır
        </span>
        <div class="kpi-value text-amber-600">
            @Model.TotalCountedLines.ToString("N0")
            <span class="kpi-unit">satır</span>
        </div>
        <div class="kpi-foot">
            <span class="kpi-trend text-slate-400">Doğrulanan stok kalem adedi</span>
        </div>
    </div>
</div>

<div class="card overflow-hidden">
    <table class="data-table">
        <thead>
            <tr>
                <th>Sayım No</th>
                <th>Depo</th>
                <th class="num">Sayılan Satır</th>
                <th>Oluşturma Tarihi</th>
                <th>Durum</th>
                <th class="num"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Counts)
            {
                <tr>
                    <td class="font-mono font-bold text-indigo-600">#@c.DocNo</td>
                    <td class="font-semibold text-slate-700">@c.WarehouseCode</td>
                    <td class="num text-slate-600">@c.LineCount.ToString("N0")</td>
                    <td class="font-mono text-xs text-slate-500">@c.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="badge @(c.Status switch {
                            "COMPLETED" => "b-green",
                            "COUNTING"  => "b-indigo",
                            _           => "b-gray"
                        })">
                            @(c.Status switch {
                                "COMPLETED" => "Tamamlandı",
                                "COUNTING"  => "Sayılıyor",
                                _           => "Taslak"
                            })
                        </span>
                    </td>
                    <td class="num">
                        <a asp-page="./Details" asp-route-id="@c.Id" class="btn btn-xs btn-secondary">Detay</a>
                    </td>
                </tr>
            }
            @if (!Model.Counts.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                            </svg>
                            <p>Henüz sayım oturumu oluşturulmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
