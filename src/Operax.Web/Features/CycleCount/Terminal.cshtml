@page
@model Operax.Web.Features.CycleCount.TerminalModel
@{
    Layout = "_TerminalLayout";
    ViewData["Title"] = "Sayım Terminali";
}

<div class="h-full overflow-y-auto p-4 space-y-4">

@if (Model.ActiveCount == null)
{
    <div class="bg-slate-800 rounded-2xl p-4">
        <h2 class="text-xs font-bold uppercase text-slate-400 tracking-widest mb-3">Aktif Sayım Seç</h2>
        <div class="space-y-2">
            @foreach (var c in Model.PendingCounts)
            {
                var pct = c.TotalLines == 0 ? 0 : (int)((double)c.CountedLines / c.TotalLines * 100);
                <a href="?countId=@c.Id" class="block bg-slate-700 hover:bg-slate-600 active:bg-slate-500 rounded-xl p-4 transition-colors">
                    <div class="flex justify-between mb-2">
                        <span class="font-black text-white">@c.DocNo</span>
                        <span class="text-indigo-400 font-bold text-sm">@c.CountedLines/@c.TotalLines</span>
                    </div>
                    <div class="h-1.5 bg-slate-600 rounded-full">
                        <div class="h-full bg-green-500 rounded-full" style="width: @pct%"></div>
                    </div>
                </a>
            }
            @if (!Model.PendingCounts.Any())
            {
                <div class="text-center py-8 text-slate-500 italic text-sm">Aktif sayım bulunamadı.</div>
            }
        </div>
    </div>
}
else
{
    var count = Model.ActiveCount;

    @if (TempData["Success"] != null) { <div class="bg-green-500 rounded-xl p-3 text-center font-bold text-white">✓ @TempData["Success"]</div> }

    <!-- Başlık -->
    <div class="bg-indigo-900 rounded-2xl p-4 border border-indigo-700">
        <div class="flex justify-between items-start">
            <div>
                <div class="text-[10px] text-indigo-300 uppercase font-bold">Sayım</div>
                <div class="text-2xl font-black text-white">@count.DocNo</div>
                <div class="text-indigo-300 text-sm">@count.WhCode · @count.CountedLines/@count.TotalLines sayıldı</div>
            </div>
            <a href="?" class="bg-slate-700 text-slate-300 text-xs px-3 py-1.5 rounded-lg font-bold">← Geri</a>
        </div>
        <div class="mt-3 h-1.5 bg-indigo-800 rounded-full">
            <div class="h-full bg-green-400 rounded-full transition-all" style="width: @(count.TotalLines == 0 ? 0 : count.CountedLines * 100 / count.TotalLines)%"></div>
        </div>
    </div>

    <!-- Sayılmamış satırlar -->
    @foreach (var line in count.Lines.Where(l => !l.IsCounted))
    {
        <div class="bg-slate-800 rounded-2xl p-4">
            <div class="mb-1 text-[10px] font-bold text-amber-400 uppercase">Sayılacak</div>
            <div class="font-bold text-white text-lg">@line.BinCode → @line.ItemCode</div>
            <div class="text-slate-400 text-sm mb-1">@line.ItemName</div>
            @if (line.LotNo != null) { <div class="text-indigo-300 text-xs font-mono">Lot: @line.LotNo</div> }
            <div class="text-slate-500 text-xs mt-1">Sistem bakiyesi: @line.QtySystem.ToString("N2")</div>

            <form method="post" asp-page-handler="EnterCount" asp-route-countId="@count.Id" class="mt-3 flex gap-2">
                <input type="hidden" name="lineId" value="@line.Id" />
                <input name="qtyCounted" type="number" inputmode="decimal" step="0.001" min="0" autofocus autocomplete="off" required
                       class="flex-1 bg-slate-700 border border-amber-500 rounded-xl px-4 py-3 text-white font-mono text-xl focus:outline-none focus:border-green-500"
                       placeholder="Sayılan adet..." />
                <button type="submit" class="bg-green-600 hover:bg-green-500 active:scale-95 text-white px-6 py-3 rounded-xl font-black text-lg transition-all">✓</button>
            </form>
        </div>
        break; @* Bir seferde sadece bir satır göster *@
    }

    <!-- Sayılmış satırlar özeti -->
    @if (count.Lines.Any(l => l.IsCounted))
    {
        <div class="bg-slate-800 rounded-2xl overflow-hidden">
            <div class="px-4 py-3 border-b border-slate-700">
                <h3 class="text-xs font-bold uppercase text-green-400 tracking-widest">Sayılanlar (@count.CountedLines)</h3>
            </div>
            <div class="divide-y divide-slate-700 max-h-48 overflow-y-auto">
                @foreach (var line in count.Lines.Where(l => l.IsCounted))
                {
                    var diff = line.QtyCounted - line.QtySystem;
                    <div class="px-4 py-2 flex items-center justify-between">
                        <div>
                            <div class="text-white text-sm font-bold">@line.BinCode · @line.ItemCode</div>
                        </div>
                        <div class="text-right">
                            <div class="font-mono text-sm text-green-400">@line.QtyCounted.ToString("N2")</div>
                            @if (diff != 0)
                            {
                                <div class="text-[10px] font-mono @(diff > 0 ? "text-green-400" : "text-red-400")">
                                    @(diff > 0 ? "+" : "")@diff.ToString("N2")
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!count.Lines.Any(l => !l.IsCounted))
    {
        <div class="bg-green-900 border border-green-700 rounded-2xl p-8 text-center">
            <div class="text-5xl mb-3">✅</div>
            <div class="text-green-300 font-black text-xl uppercase tracking-widest">Sayım Tamamlandı!</div>
            <p class="text-green-400 text-sm mt-2">Masaüstünden belgeyi onaylayın.</p>
            <a href="?" class="mt-4 inline-block bg-slate-700 text-white px-6 py-3 rounded-xl font-bold text-sm">Ana Menüye Dön</a>
        </div>
    }
}
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const inp = document.querySelector('input[type="number"][name="qtyCounted"]');
        if (inp) inp.focus();
    });
</script>
}
