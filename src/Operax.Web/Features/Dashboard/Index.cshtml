@page
@model Operax.Web.Features.Dashboard.IndexModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = "Anasayfa";

    // Sales-kartları için aylık GERÇEK seriler (MonthlyPerformance, son 6 ay).
    var posSeries    = Model.MonthlyPerformance.Select(m => m.PostedAmount).ToList();
    var draftSeries  = Model.MonthlyPerformance.Select(m => m.DraftAmount).ToList();
    var cancelSeries = Model.MonthlyPerformance.Select(m => m.CancelledAmount).ToList();

    // Üst satır kart tanımları (başlık + seri + anlam varyantı). 3 sales kartına karşılık.
    var salesCards = new[]
    {
        (Title: "Onaylı Satınalma", Series: posSeries,    Variant: "success"),
        (Title: "Taslak Satınalma", Series: draftSeries,  Variant: "warn"),
        (Title: "İptal Satınalma",  Series: cancelSeries, Variant: "danger"),
    };
}
@functions {
    // Sparkline SVG polyline noktaları — değer serisini 100x36 viewBox'a oturtur (y ekseni ters,
    // 2px üst/alt pay). Sales kartındaki mini çizgi grafiğinin gerçek-veri karşılığı.
    static string Spark(System.Collections.Generic.IReadOnlyList<decimal> v)
    {
        if (v == null || v.Count == 0) return "";
        decimal max = 1m;
        foreach (var x in v) if (x > max) max = x;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < v.Count; i++)
        {
            var px = v.Count == 1 ? 0d : (double)i / (v.Count - 1) * 100d;
            var py = 34d - (double)(v[i] / max) * 32d; // tabandan yükseklik, 2px üst pay
            sb.Append(px.ToString("0.#", inv)).Append(',').Append(py.ToString("0.#", inv)).Append(' ');
        }
        return sb.ToString().Trim();
    }

    // Son ay / önceki ay yüzde değişimi → (metin, yön). Yön: +1 artış, -1 düşüş, 0 nötr/yetersiz.
    // Yeşil/kırmızı delta pill'in gerçek-veri kaynağı.
    static (string Text, int Dir) Delta(System.Collections.Generic.IReadOnlyList<decimal> v)
    {
        if (v == null || v.Count < 2) return ("", 0);
        decimal last = v[v.Count - 1], prev = v[v.Count - 2];
        if (prev == 0) return last > 0 ? ("yeni", 1) : ("", 0);
        var pct = (last - prev) / prev * 100m;
        var dir = pct > 0 ? 1 : (pct < 0 ? -1 : 0);
        var sign = pct > 0 ? "+" : "";
        return ($"{sign}{pct.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))}%", dir);
    }
}
@* ============================================================================
   ANASAYFA — kanonik tasarım sistemi (semantic class). Sales kartları .stat-card:
   mikro-etiket + büyük mono değer + anlam-renkli delta pill + sparkline (hepsi GERÇEK
   aylık seriden — hardcoded delta YOK). İçerik panelleri .card. Renk/görsel kabuk
   semantic (token); yalnız yerleşim (grid/gap/flex) Tailwind utility. Sparkline saf
   SVG + CSS renk (Chart.js yok, CSP güvenli). Kabuk (sidebar/topbar) _Layout'tan.
   ============================================================================ *@
<div class="mx-auto w-full max-w-[1640px] px-4 py-5 md:px-6" data-screen-label="Anasayfa">

    @* --- Üst başlık: solda sayfa adı + şirket/tarih, sağda birincil aksiyonlar. --- *@
    <div class="flex flex-col gap-3 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[var(--text)]">Anasayfa</h1>
            <p class="text-sm text-[var(--text-3)] mt-0.5">@Model.CompanyName · @DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                Rapor İndir
            </button>
            <a href="/PurchaseOrders/Details" class="btn btn-primary btn-sm" data-shortcut="Alt+N">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Yeni Sipariş<span class="btn-kbd">Alt+N</span>
            </a>
        </div>
    </div>

    @* ========================================================================
       SALES KART SATIRI (3) — .stat-card: başlık + TUTAR etiketi + mono toplam +
       son/önceki ay % delta pill + anlam-renkli sparkline.
       ======================================================================== *@
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 mb-4">
        @foreach (var c in salesCards)
        {
            var total = c.Series.Sum();
            var d = Delta(c.Series);
            var pts = Spark(c.Series);
            // Delta yönü → pill modifier (artış=up yeşil, düşüş=down kırmızı, nötr boş gri).
            var pillMod = d.Dir > 0 ? "up" : d.Dir < 0 ? "down" : "";

            <div class="stat-card">
                <h3 class="stat-card-title">@c.Title</h3>
                <span class="stat-label">Tutar</span>
                <div class="stat-row">
                    <span class="stat-value">@Operax.Web.Lib.UiHelpers.FmtTL(total)</span>
                    @if (!string.IsNullOrEmpty(d.Text))
                    {
                        <span class="delta-pill @pillMod">@d.Text</span>
                    }
                </div>
                @* Sparkline: anlam-renkli çizgi + hafif dolgu. Renk modifier (is-*) ile CSS'ten. *@
                @if (!string.IsNullOrEmpty(pts))
                {
                    <div class="stat-spark is-@c.Variant">
                        <svg viewBox="0 0 100 36" preserveAspectRatio="none">
                            <polygon class="spark-area" points="@pts 100,36 0,36" />
                            <polyline class="spark-line" points="@pts" />
                        </svg>
                    </div>
                }
            </div>
        }
    </div>

    @* ========================================================================
       MİNİ-KPI ŞERİDİ (4) — .stat-card (sparkline yok, sade operasyonel metrik).
       ======================================================================== *@
    <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-4">

        @* Onaylı PO adedi *@
        <div class="stat-card">
            <span class="stat-label">Onaylı Sipariş</span>
            <div class="stat-value">@Model.ApprovedPoCount</div>
            <div class="stat-sub">@Model.DraftPoCount taslak bekliyor</div>
        </div>

        @* Depo doluluk + ince ilerleme barı (gerçek oran, data-driven genişlik) *@
        <div class="stat-card">
            <span class="stat-label">Depo Doluluk</span>
            <div class="stat-value">%@Model.WarehouseFillRate.ToString("0.#")</div>
            <div class="stat-bar">
                <div class="stat-bar-fill" style="width:@(Math.Min(Model.WarehouseFillRate, 100))%"></div>
            </div>
        </div>

        @* Stoklu konum *@
        <div class="stat-card">
            <span class="stat-label">Stoklu Konum</span>
            <div class="stat-value">@Model.StockLocations</div>
            <div class="stat-sub">dolu hücre sayısı</div>
        </div>

        @* Min-altı stok — 0'dan büyükse danger tonu *@
        <div class="stat-card">
            <span class="stat-label">Min-Altı Stok</span>
            <div class="stat-value@(Model.LowStockSkuCount > 0 ? " danger" : "")">@Model.LowStockSkuCount</div>
            <div class="stat-sub@(Model.LowStockSkuCount > 0 ? " danger" : "")">
                @(Model.LowStockSkuCount > 0 ? "ürün kritik seviyede" : "kritik ürün yok")
            </div>
        </div>
    </div>

    @* ========================================================================
       ANA SATIR: solda aylık performans stacked-bar (2/3), sağda aktivite feed (1/3).
       ======================================================================== *@
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-4">

        @* ---- AYLIK SATINALMA PERFORMANSI — saf-CSS stacked bar (gerçek MonthlyPerformance) ---- *@
        <div class="card xl:col-span-2 flex flex-col">
            <div class="card-hdr">
                <div>
                    <div class="card-title">Aylık Satınalma Performansı</div>
                    <div class="card-sub">Son 6 ay · onaylı / taslak / iptal kırılımı</div>
                </div>
                <div class="hidden sm:flex items-center gap-3 text-xs text-[var(--text-3)]">
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--success)]"></span>Onaylı</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--warn)]"></span>Taslak</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--danger)]"></span>İptal</span>
                </div>
            </div>
            <div class="card-body flex-1">
                @if (Model.MonthlyPerformance != null && Model.MonthlyPerformance.Any())
                {
                    var maxTotal = Model.MonthlyPerformance.Max(m => m.PostedAmount + m.DraftAmount + m.CancelledAmount);
                    if (maxTotal <= 0) { maxTotal = 1; }
                    <div class="flex items-end justify-between gap-3 h-52">
                        @foreach (var m in Model.MonthlyPerformance)
                        {
                            var postedPct = (double)(m.PostedAmount / maxTotal) * 100;
                            var draftPct = (double)(m.DraftAmount / maxTotal) * 100;
                            var cancelPct = (double)(m.CancelledAmount / maxTotal) * 100;
                            <div class="flex-1 flex flex-col items-center gap-2">
                                <div class="w-full flex flex-col justify-end h-44 rounded-md bg-[var(--neutral-bg)] overflow-hidden"
                                     title="@m.MonthName — Onaylı @Operax.Web.Lib.UiHelpers.FmtTL(m.PostedAmount)">
                                    @if (cancelPct > 0)
                                    {
                                        <div class="w-full bg-[var(--danger)]" style="height:@cancelPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    }
                                    @if (draftPct > 0)
                                    {
                                        <div class="w-full bg-[var(--warn)]" style="height:@draftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    }
                                    @if (postedPct > 0)
                                    {
                                        <div class="w-full bg-[var(--success)]" style="height:@postedPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    }
                                </div>
                                <span class="text-xs text-[var(--text-3)] font-medium">@m.MonthName</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex items-center justify-center h-52 text-sm text-[var(--text-4)]">Henüz performans verisi yok.</div>
                }
            </div>
        </div>

        @* ---- SON AKTİVİTE FEED'İ ---- Kind rengine göre nokta + Action + zaman. *@
        <div class="card flex flex-col">
            <div class="card-hdr">
                <div class="card-title">Son Aktivite</div>
            </div>
            <div class="card-body flex-1">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    <ul class="flex flex-col gap-4">
                        @foreach (var act in Model.RecentActivities)
                        {
                            // Kind → token rengi (success/danger/warn/info). --info base yok → --info-text.
                            var dotColor = act.Kind switch
                            {
                                "success" => "bg-[var(--success)]",
                                "danger" => "bg-[var(--danger)]",
                                "warn" => "bg-[var(--warn)]",
                                "info" => "bg-[var(--info-text)]",
                                _ => "bg-[var(--neutral-text)]"
                            };
                            <li class="flex gap-3">
                                <span class="mt-1.5 w-2 h-2 rounded-full shrink-0 @dotColor"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm text-[var(--text-2)] leading-snug">@act.Action</p>
                                    <p class="text-xs text-[var(--text-4)] mt-0.5">@act.Who · @act.TimeLabel</p>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-sm text-[var(--text-4)] py-8 text-center">Henüz aktivite kaydı yok.</div>
                }
            </div>
        </div>
    </div>

    @* ========================================================================
       ALT SATIR: solda Son Siparişler tablosu (2/3), sağda Yaklaşan Sevkiyat (1/3).
       ======================================================================== *@
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">

        @* ---- SON SİPARİŞLER tablosu ---- *@
        <div class="card xl:col-span-2 flex flex-col">
            <div class="card-hdr">
                <div class="card-title">Son Siparişler</div>
                <a href="/PurchaseOrders" class="text-xs font-semibold text-[var(--brand-500)] hover:text-[var(--brand-400)]">Tümünü gör</a>
            </div>
            @if (Model.RecentPOs != null && Model.RecentPOs.Any())
            {
                <div class="card-body-flush overflow-x-auto">
                    <table class="w-full min-w-[640px] text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wide text-[var(--text-4)] border-b border-[var(--border)]">
                                <th class="font-semibold px-5 py-3">Sipariş No</th>
                                <th class="font-semibold px-5 py-3">Tedarikçi</th>
                                <th class="font-semibold px-5 py-3">Tarih</th>
                                <th class="font-semibold px-5 py-3 text-right">Tutar</th>
                                <th class="font-semibold px-5 py-3">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in Model.RecentPOs)
                            {
                                <tr class="border-b border-[var(--border)] last:border-0 hover:bg-[var(--surface-2)] transition-colors">
                                    <td class="px-5 py-3 [font-family:var(--font-mono)] text-[var(--text)] font-medium">@po.OrderNo</td>
                                    <td class="px-5 py-3">
                                        <div class="text-[var(--text-2)]">@po.SupplierName</div>
                                        @if (!string.IsNullOrEmpty(po.SupplierCity))
                                        {
                                            <div class="text-xs text-[var(--text-4)]">@po.SupplierCity</div>
                                        }
                                    </td>
                                    <td class="px-5 py-3 text-[var(--text-3)]">@po.OrderDate.ToString("dd MMM")</td>
                                    <td class="px-5 py-3 text-right [font-family:var(--font-mono)] text-[var(--text)]">@Operax.Web.Lib.UiHelpers.FmtTL(po.TotalAmount)</td>
                                    <td class="px-5 py-3">@Html.Raw(Dict.StatusBadge(po.Status))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-sm text-[var(--text-4)] py-12 text-center">Henüz sipariş kaydı yok.</div>
            }
        </div>

        @* ---- YAKLAŞAN SEVKİYATLAR ---- liste kartı (LPN + tedarikçi + ETA + dok). *@
        <div class="card flex flex-col">
            <div class="card-hdr">
                <div class="card-title">Yaklaşan Sevkiyatlar</div>
            </div>
            <div class="card-body flex-1" style="padding:12px;">
                @if (Model.IncomingShipments != null && Model.IncomingShipments.Any())
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var sh in Model.IncomingShipments)
                        {
                            <li class="flex items-center gap-3 px-2 py-2.5 rounded-lg hover:bg-[var(--surface-2)] transition-colors">
                                <span class="shrink-0 px-2 py-1 rounded-md [font-family:var(--font-mono)] text-xs bg-[var(--brand-tint-15)] text-[var(--brand-500)] font-medium">@sh.Lpn</span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm text-[var(--text-2)] truncate">@sh.Supplier</div>
                                    <div class="text-xs text-[var(--text-4)] truncate">@sh.Sku · @sh.Qty.ToString("0.##") @sh.Uom</div>
                                </div>
                                <div class="text-right shrink-0">
                                    <div class="text-xs font-medium text-[var(--text-2)]">@sh.Eta.ToString("dd MMM")</div>
                                    <div class="text-xs text-[var(--text-4)]">Dok @sh.Dock</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-sm text-[var(--text-4)] py-12 text-center">Yaklaşan sevkiyat yok.</div>
                }
            </div>
        </div>
    </div>

</div>
