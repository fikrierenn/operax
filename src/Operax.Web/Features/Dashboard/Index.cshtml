@page
@model Operax.Web.Features.Dashboard.IndexModel
@{
    ViewData["Title"] = L.T("Yönetim Paneli", "Dashboard");
}

<div class="page" data-screen-label="Dashboard" style="max-width:1640px">
    <!-- Page Header -->
    <div class="page-hdr">
        <div class="page-hdr-l">
            <div class="breadcrumb">
                <span class="breadcrumb-item" onclick="window.location.href='/Dashboard'">Anasayfa</span>
                <span class="breadcrumb-sep">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
                <span class="breadcrumb-current">Yönetici Görünümü</span>
            </div>
            <h1>Anasayfa</h1>
            <p>
                Aydın Endüstri A.Ş. · @DateTime.Now.ToString("yyyy-MM-dd") · @DateTime.Now.ToString("dd MMMM yyyy dddd", new System.Globalization.CultureInfo("tr-TR"))
            </p>
        </div>
        <div class="page-hdr-r">
            <button class="btn btn-secondary btn-sm" onclick="window.print()">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                @L.T("Rapor İndir", "Download Report")
            </button>
            <a href="/PurchaseOrders/Details" class="btn btn-primary btn-sm" data-shortcut="Alt+N">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                @L.T("Yeni Sipariş", "New Order")
                <span class="btn-kbd">Alt+N</span>
            </a>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="kpi-grid">
        
        <!-- Açık Satınalma Tutarı -->
        <div class="kpi">
            <div class="kpi-glow brand"></div>
            <div class="kpi-label">Açık Satınalma Tutarı</div>
            <div class="kpi-value" style="font-size:22px;">₺@Model.TotalPoAmount.ToString("N0")</div>
            <div class="kpi-trend" style="margin-top:8px;">
                <span class="kpi-delta up">
                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
                    %18.4
                </span>
                <span class="kpi-trend">vs geçen ay</span>
            </div>
        </div>

        <!-- Bu Ay Onaylanan -->
        <div class="kpi">
            <div class="kpi-glow success"></div>
            <div class="kpi-label">Bu Ay Onaylanan</div>
            <div class="kpi-value">@Model.ApprovedPoCount<span class="kpi-unit">evrak</span></div>
            <div class="kpi-trend" style="margin-top:8px;">
                <span class="kpi-delta up">
                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>
                    %9.2
                </span>
                <span class="kpi-trend">@Model.DraftPoCount taslak bekliyor</span>
            </div>
        </div>

        <!-- Depo Doluluk -->
        <div class="kpi">
            <div class="kpi-glow warn"></div>
            <div class="kpi-label">Depo Doluluk</div>
            <div class="kpi-value">%@Model.WarehouseFillRate.ToString("F1")</div>
            <div class="kpi-trend" style="margin-top:8px;">
                <span class="kpi-delta flat">
                    <span class="dot" style="background:var(--text-4); width:6px; height:6px; border-radius:50%; display:inline-block;"></span>
                    sabit
                </span>
                <span class="kpi-trend">@Model.StockLocations aktif konum</span>
            </div>
        </div>

        <!-- Düşük Stoklu SKU -->
        <div class="kpi">
            <div class="kpi-glow danger"></div>
            <div class="kpi-label">Düşük Stoklu SKU</div>
            <div class="kpi-value" style="color:var(--danger-text)">@Model.LowStockSkuCount<span class="kpi-unit">ürün</span></div>
            <div class="kpi-trend" style="margin-top:8px;">
                <span class="kpi-delta down">
                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    %4.0
                </span>
                <span class="kpi-trend">acil müdahale önerilir</span>
            </div>
        </div>

    </div>

    <!-- Main Row: Chart + Son Aktivite -->
    <div style="display:grid;grid-template-columns:1fr 360px;gap:14px;margin-bottom:14px;">
        
        <!-- Stacked Bar Chart -->
        <div class="card">
            <div class="card-hdr">
                <div>
                    <div class="card-title">Aylık Satınalma Performansı</div>
                    <div class="card-sub">Onaylı + Taslak + İptal · Son 6 ay</div>
                </div>
                <div style="display:flex;gap:4px">
                    <button class="btn btn-secondary btn-xs">Aylık</button>
                    <button class="btn btn-ghost btn-xs">Çeyrek</button>
                    <button class="btn btn-ghost btn-xs">Yıl</button>
                </div>
            </div>
            <div class="card-body" style="padding:18px">
                <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:14px;align-items:flex-end;height:200px">
                    @foreach (var bar in Model.MonthlyPerformance)
                    {
                        var maxT = 1910000m; // May total
                        var pH = (int)(bar.PostedAmount / maxT * 100);
                        var dH = (int)(bar.DraftAmount / maxT * 100);
                        var cH = (int)(bar.CancelledAmount / maxT * 100);
                        bool isLast = bar.MonthName == "May";
                        
                        <div style="display:flex;flex-direction:column;align-items:center;gap:8px;height:100%">
                            <div class="mono" style="font-size:10.5px;color:var(--text-3);font-weight:600">₺@((bar.PostedAmount + bar.DraftAmount + bar.CancelledAmount)/1000000m).ToString("F1")M</div>
                            <div style="flex:1;width:100%;max-width:56px;display:flex;flex-direction:column;justify-content:flex-end;gap:2px">
                                <div style="height:@cH%;background:var(--danger);opacity:.85;border-radius:4px 4px 0 0;min-height:@(cH > 0 ? 2 : 0)px"></div>
                                <div style="height:@dH%;background:var(--warn);opacity:.85;min-height:2px"></div>
                                <div style="height:@pH%;background:@(isLast ? "var(--brand-grad)" : "hsl(243 75% 59% / 0.85)");border-radius:0 0 4px 4px;min-height:4px;@(isLast ? "box-shadow:0 4px 12px hsl(243 75% 59% / 0.3)" : "")"></div>
                            </div>
                            <div style="font-size:11px;color:@(isLast ? "var(--text)" : "var(--text-3)");font-weight:@(isLast ? 700 : 500)">@bar.MonthName</div>
                        </div>
                    }
                </div>
                <div style="display:flex;gap:16px;margin-top:14px;padding-top:12px;border-top:1px solid var(--border);font-size:11.5px">
                    <div style="display:flex;align-items:center;gap:6px"><span class="dot" style="background:var(--brand-500)"></span><span style="color:var(--text-2)">Onaylanmış</span></div>
                    <div style="display:flex;align-items:center;gap:6px"><span class="dot" style="background:var(--warn)"></span><span style="color:var(--text-2)">Taslak</span></div>
                    <div style="display:flex;align-items:center;gap:6px"><span class="dot" style="background:var(--danger)"></span><span style="color:var(--text-2)">İptal</span></div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="card" style="width:360px;">
            <div class="card-hdr"><div class="card-title">Son Aktivite</div></div>
            <div class="card-body" style="padding:6px 14px 12px">
                @foreach (var act in Model.RecentActivities)
                {
                    var initials = act.Who;
                    var avatarColor = act.Kind == "success" ? "var(--success)" : act.Kind == "danger" ? "var(--danger)" : act.Kind == "info" ? "var(--brand-500)" : "hsl(215 16% 47%)";
                    
                    <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
                        <div class="avatar" style="width:28px;height:28px;font-size:11px;background:@avatarColor">@initials</div>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:12px;line-height:1.4">
                                <span style="font-weight:600">@act.Who</span>
                                <span style="color:var(--text-2)">@act.Action</span>
                            </div>
                            <div class="mono" style="font-size:10.5px;color:var(--text-4);margin-top:1px">@act.TimeLabel</div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Grid 2: Yaklaşan Sevkiyatlar + Düşük Stoklu Ürünler -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
        
        <!-- Yaklaşan Sevkiyatlar -->
        <div class="card">
            <div class="card-hdr">
                <div class="card-title">Yaklaşan Sevkiyatlar</div>
                <a href="/Receiving/Index" class="btn btn-ghost btn-xs">
                    Tümünü gör
                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
            <div class="card-body-flush">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>LPN</th>
                            <th>Tedarikçi</th>
                            <th>SKU</th>
                            <th class="num">Miktar</th>
                            <th>ETA</th>
                            <th>Dock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sh in Model.IncomingShipments)
                        {
                            <tr>
                                <td><span class="mono row-strong" style="color:var(--brand-500)">@sh.Lpn</span></td>
                                <td>@sh.Supplier</td>
                                <td><span class="mono">@sh.Sku</span></td>
                                <td class="num"><span class="row-strong">@sh.Qty.ToString("N0")</span> <span class="muted">@sh.Uom</span></td>
                                <td class="mono">@sh.Eta.ToString("dd MMM")</td>
                                <td><span class="badge badge-brand"><span class="badge-dot"></span>@sh.Dock</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Düşük Stoklu Ürünler -->
        <div class="card">
            <div class="card-hdr">
                <div class="card-title">Düşük Stoklu Ürünler</div>
                <button class="btn btn-ghost btn-xs">
                    Sipariş öner
                    <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                </button>
            </div>
            <div class="card-body-flush">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Ürün</th>
                            <th class="num">Mevcut</th>
                            <th class="num">Min</th>
                            <th>Doluluk</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ls in Model.IncomingShipments.Select((s, i) => new { 
                            Sku = s.Sku, 
                            Name = s.Sku == "PR-0103" ? "Hidrolik Silindir" : s.Sku == "PR-0612" ? "Reçine PA66" : s.Sku == "PR-0840" ? "Koli Bandı" : "M8 Somun", 
                            Onhand = s.Sku == "PR-0103" ? 2m : s.Sku == "PR-0612" ? 4m : s.Sku == "PR-0840" ? 1m : 9m,
                            Min = s.Sku == "PR-0103" ? 10m : s.Sku == "PR-0612" ? 10m : s.Sku == "PR-0840" ? 10m : 10m,
                            Uom = s.Uom
                        }))
                        {
                            var fillPct = (int)(ls.Onhand / ls.Min * 100);
                            var gaugeColor = fillPct < 25 ? "var(--danger)" : fillPct < 50 ? "var(--warn)" : fillPct < 90 ? "var(--success)" : "var(--brand-500)";
                            var gaugeTextColor = fillPct < 25 ? "var(--danger-text)" : fillPct < 50 ? "var(--warn-text)" : fillPct < 90 ? "var(--success-text)" : "var(--brand-600)";
                            <tr style="cursor:pointer" onclick="window.location.href='/MasterData/Items/Index'">
                                <td><span class="mono row-strong" style="color:var(--brand-500)">@ls.Sku</span></td>
                                <td>@ls.Name</td>
                                <td class="num"><span class="row-strong">@ls.Onhand.ToString("N0")</span> <span class="muted">@ls.Uom</span></td>
                                <td class="num muted mono">@ls.Min.ToString("N0")</td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px">
                                        <div style="width:60px">
                                            <div style="width:100%;height:5px;background:var(--bg-2);border-radius:2.5px;overflow:hidden">
                                                <div style="width:@fillPct%;height:100%;background:@gaugeColor;border-radius:2.5px;transition:width .4s"></div>
                                            </div>
                                        </div>
                                        <span class="mono" style="font-size:11px;color:@gaugeTextColor;font-weight:600">%@fillPct</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Bottom card: Son Satınalma Siparişleri -->
    <div class="card">
        <div class="card-hdr">
            <div class="card-title">Son Satınalma Siparişleri</div>
            <a href="/PurchaseOrders/Index" class="btn btn-ghost btn-xs">
                Hepsini gör
                <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        </div>
        <div class="card-body-flush">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Evrak No</th>
                        <th>Tedarikçi</th>
                        <th>Tarih</th>
                        <th class="num">Tutar</th>
                        <th>Durum</th>
                        <th style="width:36px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in Model.RecentPOs)
                    {
                        var initials = po.SupplierCode;
                        <tr>
                            <td style="cursor:pointer" onclick="window.location.href='/PurchaseOrders/Details?id=@po.OrderNo'"><span class="mono row-strong" style="color:var(--brand-500)">@po.OrderNo</span></td>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div class="avatar" style="width:24px;height:24px;font-size:10px;">@initials</div>
                                    <div>
                                        <div class="row-strong">@po.SupplierName</div>
                                        <div class="row-sub">@po.SupplierCity</div>
                                    </div>
                                </div>
                            </td>
                            <td class="mono muted">@po.OrderDate.ToString("dd MMM")</td>
                            <td class="num"><span class="row-strong">₺@po.TotalAmount.ToString("N0")</span></td>
                            <td>
                                @if (po.Status == "POSTED" || po.Status == "posted")
                                {
                                    <span class="badge badge-success"><span class="badge-dot"></span>Onaylandı</span>
                                }
                                else if (po.Status == "CANCELLED" || po.Status == "cancelled")
                                {
                                    <span class="badge badge-danger"><span class="badge-dot"></span>İptal</span>
                                }
                                else
                                {
                                    <span class="badge badge-warn"><span class="badge-dot"></span>Taslak</span>
                                }
                            </td>
                            <td>
                                <a href="/PurchaseOrders/Details?id=@po.OrderNo" style="color:var(--text-4)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
