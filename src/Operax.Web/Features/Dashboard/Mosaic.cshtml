@page
@model Operax.Web.Features.Dashboard.MosaicModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = "Anasayfa (Mosaic Denemesi)";
}
@* ============================================================================
   ALTERNATİF ANASAYFA — Cruip "Mosaic" tasarım dili denemesi.
   Açık-gri zemin + beyaz kartlar + ince ayraçlar + sert tipografi hiyerarşisi.
   Tüm renkler token (:root değişkenleri), layout saf Tailwind utility (özel CSS yok).
   Grafik = saf CSS (Model.MonthlyPerformance gerçek verisinden stacked-bar).
   Bu sayfa gerçek Dashboard'a dokunmaz — yalnızca tasarım denemesidir.
   Sayfa kabuğu (sidebar/topbar) _Layout'tan gelir; burası yalnız içerik gövdesi.
   ============================================================================ *@
<div class="mx-auto w-full max-w-[1640px] px-4 py-5 md:px-6" data-screen-label="Anasayfa (Mosaic Denemesi)">

    @* --- Üst başlık: şirket adı + kısa açıklama. Mosaic'te sayfa başlığı sade. --- *@
    <div class="flex flex-col gap-1 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-[var(--text)]">@Model.CompanyName</h1>
            <p class="text-sm text-[var(--text-3)] mt-0.5">Genel bakış · @DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>
    </div>

    @* ========================================================================
       STAT-KART SATIRI (4 kart) — Mosaic'in imzası: küçük uppercase gri etiket,
       altında büyük mono sayı, en altta gerçek veriden türeyen alt-metin.
       Mobil tek kolon → tablet 2 → geniş ekran 4 kolon.
       ======================================================================== *@
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4">

        @* Kart 1 — Açık satınalma toplamı (₺). Alt-metin: onaylı/taslak PO adedi. *@
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] p-5">
            <div class="flex items-start justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-[var(--text-4)]">Açık Satınalma</span>
                @* 3-nokta menü ikonu — Mosaic kart başlığı klişesi (şimdilik dekoratif). *@
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[var(--text-4)]"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
            <div class="text-3xl font-bold [font-family:var(--font-mono)] text-[var(--text)] mt-3">@Operax.Web.Lib.UiHelpers.FmtTL(Model.TotalPoAmount)</div>
            <div class="text-xs text-[var(--text-3)] mt-2">@Model.ApprovedPoCount onaylı · @Model.DraftPoCount taslak bekliyor</div>
        </div>

        @* Kart 2 — Onaylı PO adedi. Alt-metin: taslak adedi. *@
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] p-5">
            <div class="flex items-start justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-[var(--text-4)]">Onaylı Sipariş</span>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[var(--text-4)]"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
            <div class="text-3xl font-bold [font-family:var(--font-mono)] text-[var(--text)] mt-3">@Model.ApprovedPoCount</div>
            <div class="text-xs text-[var(--text-3)] mt-2">@Model.DraftPoCount taslak henüz onaylanmadı</div>
        </div>

        @* Kart 3 — Depo doluluk oranı (%). Alt-metin: stoklu konum sayısı.
           Doluluk barı = gerçek WarehouseFillRate (data-driven inline width, RENK değil). *@
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] p-5">
            <div class="flex items-start justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-[var(--text-4)]">Depo Doluluk</span>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[var(--text-4)]"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
            <div class="text-3xl font-bold [font-family:var(--font-mono)] text-[var(--text)] mt-3">%@Model.WarehouseFillRate.ToString("0.#")</div>
            @* İnce ilerleme çubuğu — zemin nötr, dolu kısım marka rengi. Genişlik gerçek orandan. *@
            <div class="h-1.5 rounded-full bg-[var(--neutral-bg)] mt-3 overflow-hidden">
                <div class="h-full rounded-full bg-[var(--brand-500)]" style="width:@(Math.Min(Model.WarehouseFillRate, 100))%"></div>
            </div>
            <div class="text-xs text-[var(--text-3)] mt-2">@Model.StockLocations stoklu konum</div>
        </div>

        @* Kart 4 — Min-altı (kritik) ürün. Alt-metin uyarı tonunda (var olduğunda danger). *@
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] p-5">
            <div class="flex items-start justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-[var(--text-4)]">Min-Altı Stok</span>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[var(--text-4)]"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
            <div class="text-3xl font-bold [font-family:var(--font-mono)] mt-3 @(Model.LowStockSkuCount > 0 ? "text-[var(--danger)]" : "text-[var(--text)]")">@Model.LowStockSkuCount</div>
            <div class="text-xs mt-2 @(Model.LowStockSkuCount > 0 ? "text-[var(--danger-text)]" : "text-[var(--text-3)]")">
                @(Model.LowStockSkuCount > 0 ? "ürün kritik seviyede" : "kritik seviyede ürün yok")
            </div>
        </div>
    </div>

    @* ========================================================================
       ANA SATIR: solda geniş analitik kart (2/3), sağda aktivite feed (1/3).
       xl altında dikey yığılır.
       ======================================================================== *@
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-4">

        @* ---- ANALİTİK KART: Aylık Satınalma Performansı (stacked-bar, saf CSS) ----
           MonthlyPerformance gerçek verisi. Bar yüksekliği = (değer / max) * 100.
           Stack sırası: Onaylı (success) altta, Taslak (warn) ortada, İptal (danger) üstte. *@
        <div class="xl:col-span-2 bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] flex flex-col">
            @* Kart başlığı + ince ayraç. *@
            <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border)]">
                <div>
                    <h2 class="text-sm font-bold text-[var(--text)]">Aylık Satınalma Performansı</h2>
                    <p class="text-xs text-[var(--text-4)] mt-0.5">Son 6 ay · onaylı / taslak / iptal kırılımı</p>
                </div>
                @* Legend — semantik tokenlarla renk noktaları. *@
                <div class="hidden sm:flex items-center gap-3 text-xs text-[var(--text-3)]">
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--success)]"></span>Onaylı</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--warn)]"></span>Taslak</span>
                    <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-[var(--danger)]"></span>İptal</span>
                </div>
            </div>

            @* Grafik gövdesi. *@
            <div class="p-5 flex-1">
                @if (Model.MonthlyPerformance != null && Model.MonthlyPerformance.Any())
                {
                    @* Her ayın toplamını hesapla; en büyük toplam = normalizasyon tabanı (max).
                       max 0 olursa sıfıra bölme olmasın diye 1'e sabitlenir. *@
                    var maxTotal = Model.MonthlyPerformance.Max(m => m.PostedAmount + m.DraftAmount + m.CancelledAmount);
                    if (maxTotal <= 0) { maxTotal = 1; }

                    @* Bar alanı — sabit yükseklik, barlar tabana hizalı (items-end). *@
                    <div class="flex items-end justify-between gap-3 h-52">
                        @foreach (var m in Model.MonthlyPerformance)
                        {
                            @* Bu ayın her segmentinin yüzde yüksekliği (toplam max'a göre normalize). *@
                            var postedPct = (double)(m.PostedAmount / maxTotal) * 100;
                            var draftPct = (double)(m.DraftAmount / maxTotal) * 100;
                            var cancelPct = (double)(m.CancelledAmount / maxTotal) * 100;

                            <div class="flex-1 flex flex-col items-center gap-2 group">
                                @* Tek bir dikey çubuk; içinde 3 segment alttan üste yığılı.
                                   justify-end → segmentler aşağıya yaslı, üstte boşluk kalır. *@
                                <div class="w-full flex flex-col justify-end h-44 rounded-md bg-[var(--neutral-bg)] overflow-hidden"
                                     title="@m.MonthName — Onaylı @Operax.Web.Lib.UiHelpers.FmtTL(m.PostedAmount)">
                                    @* İptal en üstte (danger). *@
                                    @if (cancelPct > 0)
                                    {
                                        <div class="w-full bg-[var(--danger)]" style="height:@cancelPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    }
                                    @* Taslak ortada (warn). *@
                                    @if (draftPct > 0)
                                    {
                                        <div class="w-full bg-[var(--warn)]" style="height:@draftPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    }
                                    @* Onaylı en altta (success). *@
                                    @if (postedPct > 0)
                                    {
                                        <div class="w-full bg-[var(--success)]" style="height:@postedPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    }
                                </div>
                                @* X ekseni: ay adı. *@
                                <span class="text-xs text-[var(--text-3)] font-medium">@m.MonthName</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="flex items-center justify-center h-52 text-sm text-[var(--text-4)]">Henüz performans verisi yok.</div>
                }
            </div>
        </div>

        @* ---- AKTİVİTE FEED'İ ---- Kind rengine göre nokta + Action + zaman etiketi. *@
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] flex flex-col">
            <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border)]">
                <h2 class="text-sm font-bold text-[var(--text)]">Son Aktivite</h2>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[var(--text-4)]"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
            <div class="p-5 flex-1">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    <ul class="flex flex-col gap-4">
                        @foreach (var act in Model.RecentActivities)
                        {
                            @* Kind → token rengi eşlemesi (success/danger/info/warn). Bilinmeyen → neutral.
                               --info base token yok → okunur --info-text kullanılır. *@
                            var dotColor = act.Kind switch
                            {
                                "success" => "bg-[var(--success)]",
                                "danger" => "bg-[var(--danger)]",
                                "warn" => "bg-[var(--warn)]",
                                "info" => "bg-[var(--info-text)]",
                                _ => "bg-[var(--neutral-text)]"
                            };
                            <li class="flex gap-3">
                                @* Renkli durum noktası — üstte hafif boşlukla hizalı. *@
                                <span class="mt-1.5 w-2 h-2 rounded-full shrink-0 @dotColor"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm text-[var(--text-2)] leading-snug">@act.Action</p>
                                    <p class="text-xs text-[var(--text-4)] mt-0.5">@act.Who · @act.TimeLabel</p>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-sm text-[var(--text-4)] py-8 text-center">Henüz aktivite kaydı yok.</div>
                }
            </div>
        </div>
    </div>

    @* ========================================================================
       ALT SATIR: solda Son Siparişler tablosu (2/3), sağda Yaklaşan Sevkiyat (1/3).
       ======================================================================== *@
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">

        @* ---- SON SİPARİŞLER tablosu (Mosaic ince başlık + hover satır) ---- *@
        <div class="xl:col-span-2 bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] flex flex-col">
            <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border)]">
                <h2 class="text-sm font-bold text-[var(--text)]">Son Siparişler</h2>
                <a href="/PurchaseOrders" class="text-xs font-semibold text-[var(--brand-500)] hover:text-[var(--brand-400)]">Tümünü gör</a>
            </div>
            @if (Model.RecentPOs != null && Model.RecentPOs.Any())
            {
                @* Dar ekranda yatay kaydırma; tablo minimum genişlikte sıkışmaz. *@
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[640px] text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wide text-[var(--text-4)] border-b border-[var(--border)]">
                                <th class="font-semibold px-5 py-3">Sipariş No</th>
                                <th class="font-semibold px-5 py-3">Tedarikçi</th>
                                <th class="font-semibold px-5 py-3">Tarih</th>
                                <th class="font-semibold px-5 py-3 text-right">Tutar</th>
                                <th class="font-semibold px-5 py-3">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in Model.RecentPOs)
                            {
                                <tr class="border-b border-[var(--border)] last:border-0 hover:bg-[var(--surface-2)] transition-colors">
                                    @* Sipariş no — mono font, evrak kimliği vurgusu. *@
                                    <td class="px-5 py-3 [font-family:var(--font-mono)] text-[var(--text)] font-medium">@po.OrderNo</td>
                                    <td class="px-5 py-3">
                                        <div class="text-[var(--text-2)]">@po.SupplierName</div>
                                        @if (!string.IsNullOrEmpty(po.SupplierCity))
                                        {
                                            <div class="text-xs text-[var(--text-4)]">@po.SupplierCity</div>
                                        }
                                    </td>
                                    <td class="px-5 py-3 text-[var(--text-3)]">@po.OrderDate.ToString("dd MMM")</td>
                                    <td class="px-5 py-3 text-right [font-family:var(--font-mono)] text-[var(--text)]">@Operax.Web.Lib.UiHelpers.FmtTL(po.TotalAmount)</td>
                                    <td class="px-5 py-3">@Html.Raw(Dict.StatusBadge(po.Status))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-sm text-[var(--text-4)] py-12 text-center">Henüz sipariş kaydı yok.</div>
            }
        </div>

        @* ---- YAKLAŞAN SEVKİYATLAR ---- liste kartı (LPN + tedarikçi + ETA + dok). *@
        <div class="bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-[var(--shadow-sm)] flex flex-col">
            <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border)]">
                <h2 class="text-sm font-bold text-[var(--text)]">Yaklaşan Sevkiyatlar</h2>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-[var(--text-4)]"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
            </div>
            <div class="p-3 flex-1">
                @if (Model.IncomingShipments != null && Model.IncomingShipments.Any())
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var sh in Model.IncomingShipments)
                        {
                            <li class="flex items-center gap-3 px-2 py-2.5 rounded-lg hover:bg-[var(--surface-2)] transition-colors">
                                @* LPN kimliği — mono, ince marka tonlu rozet. *@
                                <span class="shrink-0 px-2 py-1 rounded-md [font-family:var(--font-mono)] text-xs bg-[var(--brand-tint-15)] text-[var(--brand-500)] font-medium">@sh.Lpn</span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm text-[var(--text-2)] truncate">@sh.Supplier</div>
                                    <div class="text-xs text-[var(--text-4)] truncate">@sh.Sku · @sh.Qty.ToString("0.##") @sh.Uom</div>
                                </div>
                                <div class="text-right shrink-0">
                                    @* ETA tarihi + dok numarası. *@
                                    <div class="text-xs font-medium text-[var(--text-2)]">@sh.Eta.ToString("dd MMM")</div>
                                    <div class="text-xs text-[var(--text-4)]">Dok @sh.Dock</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-sm text-[var(--text-4)] py-12 text-center">Yaklaşan sevkiyat yok.</div>
                }
            </div>
        </div>
    </div>

</div>
