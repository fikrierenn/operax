@page
@model Operax.Web.Features.Expenses.IndexModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = "Gider Faturaları";
}

<div class="page-hdr">
    <div>
        <h2 class="text-2xl font-bold text-[var(--text)]">Gider Yönetimi</h2>
        <p class="text-sm text-[var(--text-3)] mt-0.5">Elektrik, doğalgaz, kira ve diğer gider faturalarını yönet</p>
    </div>
    <a asp-page="./Details" class="btn btn-primary">+ Yeni Fatura</a>
</div>

<div class="kpi-row">
    <div class="kpi">
        <span class="kpi-label">Taslak</span>
        <div class="kpi-val text-[var(--text-3)]">@Model.Invoices.Count(x => x.Status == DocStatus.Draft)</div>
        <span class="kpi-sub">@Model.TotalDraft.ToString("N2") ₺</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Onaylandı</span>
        <div class="kpi-val text-[var(--brand-600)]">@Model.Invoices.Count(x => x.Status == DocStatus.Posted)</div>
        <span class="kpi-sub">@Model.TotalPosted.ToString("N2") ₺</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Ödendi</span>
        <div class="kpi-val text-[var(--success)]">@Model.Invoices.Count(x => x.Status == DocStatus.Paid)</div>
        <span class="kpi-sub">@Model.TotalPaid.ToString("N2") ₺</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Vadesi Geçmiş</span>
        <div class="kpi-val text-[var(--danger)]">@Model.Invoices.Count(x => x.IsOverdue)</div>
        <span class="kpi-sub">Ödeme bekleyen</span>
    </div>
</div>

<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Fatura No</th>
                <th>Tedarikçi</th>
                <th>Fatura Tarihi</th>
                <th>Vade</th>
                <th class="text-right">Tutar</th>
                <th class="text-center">Durum</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model.Invoices)
            {
                <tr class="@(inv.IsOverdue ? "bg-[var(--danger-bg)]" : "")">
                    <td class="font-mono font-bold text-[var(--brand-600)]">@inv.DocNo</td>
                    <td class="font-medium text-[var(--text-2)]">@(inv.PartnerName ?? "—")</td>
                    <td class="text-[var(--text-3)] text-xs">@inv.InvoiceDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-xs @(inv.IsOverdue ? "text-[var(--danger-text)] font-bold" : "text-[var(--text-3)]")">
                        @(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("dd.MM.yyyy") : "—")
                        @if (inv.IsOverdue) { <span class="ml-1 badge b-red">VADESİ GEÇMİŞ</span> }
                    </td>
                    <td class="text-right font-mono font-bold text-[var(--text)]">
                        @inv.TotalAmount.ToString("N2") <span class="text-[var(--text-4)] text-xs">@inv.Currency</span>
                    </td>
                    <td class="text-center">@Html.Raw(Dict.StatusBadge(inv.Status))</td>
                    <td class="text-right">
                        <a asp-page="./Details" asp-route-id="@inv.Id" class="btn btn-secondary btn-sm">Aç</a>
                    </td>
                </tr>
            }
            @if (!Model.Invoices.Any())
            {
                <tr><td colspan="7">
                    <div class="empty-state"><p>Henüz gider faturası yok.</p></div>
                </td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
