@page
@using Operax.Web.Lib
@model Operax.Web.Features.Finance.Accounts.CreateModel
@{
    ViewData["Title"] = "Yeni Hesap";
    var header = new PageHeaderVm(
        Title: "Yeni Finansal Hesap",
        Crumbs: new[] { "Anasayfa", "Finans", "Hesaplar", "Yeni" },
        Sub: "Kasa, banka, kredi kartı veya POS hesabı tanımla",
        ActionsHtml: "<a href=\"/Finance/Accounts/Index\" class=\"btn btn-secondary btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Yeni Hesap" style="max-width:820px;">

    <partial name="_PageHeader" model="header" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-banner alert-danger" style="margin-bottom:14px;">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-hdr"><div class="card-title">Hesap Bilgileri</div></div>
            <div class="card-body">
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Kod <span class="req">*</span></label>
                        <input asp-for="Form.Code" class="form-ctrl" placeholder="KASA-01 / BNK-AKB" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ad <span class="req">*</span></label>
                        <input asp-for="Form.Name" class="form-ctrl" placeholder="Merkez Kasa / Akbank TL" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Hesap Tipi <span class="req">*</span></label>
                        <select asp-for="Form.AccountType" class="form-ctrl" id="accType" onchange="toggleBank()">
                            <option value="CASH">Kasa</option>
                            <option value="BANK">Banka</option>
                            <option value="CREDIT_CARD">Kredi Kartı</option>
                            <option value="POS">POS</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Para Birimi</label>
                        <select asp-for="Form.Currency" class="form-ctrl">
                            <option value="TRY">TRY ₺</option>
                            <option value="USD">USD $</option>
                            <option value="EUR">EUR €</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Açılış Bakiyesi</label>
                        <input asp-for="Form.OpeningBalance" type="number" step="0.01" class="form-ctrl" />
                    </div>
                    <div class="form-group bankField">
                        <label class="form-label">Limit (kart/kredi)</label>
                        <input asp-for="Form.CreditLimit" type="number" step="0.01" class="form-ctrl" />
                    </div>

                    <div class="form-group bankField">
                        <label class="form-label">Banka Adı</label>
                        <input asp-for="Form.BankName" class="form-ctrl" />
                    </div>
                    <div class="form-group bankField">
                        <label class="form-label">Şube</label>
                        <input asp-for="Form.BranchName" class="form-ctrl" />
                    </div>
                    <div class="form-group bankField">
                        <label class="form-label">Hesap No</label>
                        <input asp-for="Form.AccountNumber" class="form-ctrl" />
                    </div>
                    <div class="form-group bankField">
                        <label class="form-label">IBAN</label>
                        <input asp-for="Form.IBAN" class="form-ctrl" placeholder="TR.." />
                    </div>
                </div>
                <div class="form-group" style="margin-top:14px;">
                    <label class="form-label">Not</label>
                    <textarea asp-for="Form.Notes" class="form-ctrl"></textarea>
                </div>
            </div>
            <div class="card-foot">
                <a href="/Finance/Accounts/Index" class="btn btn-secondary btn-sm">İptal</a>
                <button type="submit" class="btn btn-primary btn-sm">Hesabı Oluştur</button>
            </div>
        </div>
    </form>
</div>

<script>
    // Banka alanları sadece BANK/CREDIT_CARD/POS tiplerinde görünür
    function toggleBank() {
        const t = document.getElementById('accType').value;
        const show = (t !== 'CASH');
        document.querySelectorAll('.bankField').forEach(e => e.style.display = show ? 'flex' : 'none');
    }
    toggleBank();
</script>
