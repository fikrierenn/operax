@page
@using Operax.Web.Lib
@model Operax.Web.Features.Finance.Cheques.CreateModel
@{
    var kind = Model.IsNote ? "Senet" : "Çek";
    ViewData["Title"] = $"Yeni {kind}";
    var header = new PageHeaderVm(
        Title: $"Yeni {kind}",
        Crumbs: new[] { "Anasayfa", "Finans", "Çek & Senet", "Yeni" },
        Sub: $"{kind} portföye eklenir (PORTFOLIO durumunda)",
        ActionsHtml: $"<a href=\"/Finance/Cheques/Index?type={Model.Type}\" class=\"btn btn-secondary btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Yeni Çek / Senet" style="max-width:820px;">

    <partial name="_PageHeader" model="header" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-banner alert-danger" style="margin-bottom:14px;">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-hdr"><div class="card-title">@kind Bilgileri</div></div>
            <div class="card-body">
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Yön <span class="req">*</span></label>
                        <select asp-for="Form.Direction" class="form-ctrl">
                            <option value="RECEIVED">Alınan (müşteriden)</option>
                            <option value="ISSUED">Verilen (tedarikçiye)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@kind No <span class="req">*</span></label>
                        <input asp-for="Form.DocNo" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">İlgili Cari</label>
                        <select asp-for="Form.PartnerId" class="form-ctrl">
                            <option value="">Seçiniz...</option>
                            @foreach (var p in Model.Partners) { <option value="@p.Id">@p.Name</option> }
                        </select>
                    </div>

                    @if (!Model.IsNote)
                    {
                        <div class="form-group">
                            <label class="form-label">Banka <span class="req">*</span></label>
                            <input asp-for="Form.BankName" class="form-ctrl" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Şube</label>
                            <input asp-for="Form.BranchName" class="form-ctrl" />
                        </div>
                    }
                    <div class="form-group">
                        <label class="form-label">Keşideci / Borçlu <span class="req">*</span></label>
                        <input asp-for="Form.DrawerName" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">VKN/TCKN</label>
                        <input asp-for="Form.DrawerTaxNo" class="form-ctrl" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tutar (₺) <span class="req">*</span></label>
                        <input asp-for="Form.Amount" type="number" step="0.01" min="0.01" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@(Model.IsNote ? "Tanzim" : "Keşide") Tarihi <span class="req">*</span></label>
                        <input asp-for="Form.DocDate" type="date" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Vade Tarihi <span class="req">*</span></label>
                        <input asp-for="Form.DueDate" type="date" class="form-ctrl" required />
                    </div>
                </div>
            </div>
            <div class="card-foot">
                <a href="/Finance/Cheques/Index?type=@Model.Type" class="btn btn-secondary btn-sm">İptal</a>
                <button type="submit" class="btn btn-primary btn-sm">@kind Ekle</button>
            </div>
        </div>
    </form>
</div>
