@page
@using Operax.Web.Lib
@model Operax.Web.Features.Finance.Cheques.DetailsModel
@{
    var c = Model.Cheque!;
    var kind = Model.IsNote ? "Senet" : "Çek";
    ViewData["Title"] = $"{kind} {c.DocNo}";

    var header = new PageHeaderVm(
        Title: $"{kind} {c.DocNo}",
        Crumbs: new[] { "Anasayfa", "Finans", "Çek & Senet", c.DocNo },
        SubHtml: $"{(c.Direction == "RECEIVED" ? "Alınan" : "Verilen")} · {System.Net.WebUtility.HtmlEncode(c.DrawerName)} · " +
             $"Tutar <span class=\"mono text-strong\">{UiHelpers.FmtTL(c.Amount)}</span> · " +
             $"Vade <span class=\"mono\">{c.DueDate:dd MMM yyyy}</span>",
        ActionsHtml: $"<a href=\"/Finance/Cheques/Index?type={(Model.IsNote ? "note" : "cheque")}\" class=\"btn btn-secondary btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Cheque Detail" style="max-width:900px;">

    <partial name="_PageHeader" model="header" />

    @if (TempData["Success"] is string ok) { <div class="alert-banner alert-info" style="margin-bottom:14px;">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert-banner alert-danger" style="margin-bottom:14px;">@err</div> }

    @* ───── Durum + işlemler ───── *@
    <div class="card" style="margin-bottom:14px;">
        <div class="card-hdr">
            <div class="card-title">Durum: @Html.Raw(UiHelpers.StatusBadge(c.Status))</div>
            <div class="row" style="gap:6px;">
                @if (c.Status == "PORTFOLIO")
                {
                    <form method="post" asp-page-handler="Deposit" class="row" style="gap:4px;">
                        <select name="accountId" class="form-ctrl" style="height:30px;width:160px;" required>
                            <option value="">Banka hesabı...</option>
                            @foreach (var acc in Model.BankAccounts)
                            {
                                <option value="@acc.Id">@acc.Name</option>
                            }
                        </select>
                        <button class="btn btn-primary btn-sm">Bankaya Ver</button>
                    </form>
                }
                @if (c.Status == "IN_BANK")
                {
                    <form method="post" asp-page-handler="Collect">
                        <button class="btn btn-success btn-sm">Tahsil Et</button>
                    </form>
                    <button class="btn btn-secondary btn-sm" onclick="document.getElementById('returnForm').style.display='flex';" type="button"
                            style="color:var(--danger-text);">Karşılıksız</button>
                }
            </div>
        </div>
        @if (c.Status == "IN_BANK")
        {
            <div class="card-body" id="returnForm" style="display:none;">
                <form method="post" asp-page-handler="Return" class="row" style="gap:8px;">
                    <input name="reason" class="form-ctrl" style="flex:1;" placeholder="Karşılıksız sebebi (örn. yetersiz bakiye)" />
                    <button class="btn btn-danger btn-sm">Karşılıksız İşaretle</button>
                </form>
            </div>
        }
    </div>

    @* ───── Detay bilgileri ───── *@
    <div class="card">
        <div class="card-hdr"><div class="card-title">@kind Bilgileri</div></div>
        <div class="card-body">
            <div class="form-row-3">
                <div class="form-group">
                    <label class="form-label">@kind No</label>
                    <div class="mono text-strong">@c.DocNo</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Yön</label>
                    <div>@(c.Direction == "RECEIVED" ? "Alınan" : "Verilen")</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Tutar</label>
                    <div class="mono text-strong">@UiHelpers.FmtTL(c.Amount)</div>
                </div>
                @if (!Model.IsNote)
                {
                    <div class="form-group">
                        <label class="form-label">Banka</label>
                        <div>@c.BankName @(string.IsNullOrEmpty(c.BranchName) ? "" : $"· {c.BranchName}")</div>
                    </div>
                }
                <div class="form-group">
                    <label class="form-label">Keşideci / Borçlu</label>
                    <div>@c.DrawerName @(string.IsNullOrEmpty(c.DrawerTaxNo) ? "" : $"(VKN {c.DrawerTaxNo})")</div>
                </div>
                <div class="form-group">
                    <label class="form-label">İlgili Cari</label>
                    <div>@(c.PartnerName ?? "—")</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Düzenleme Tarihi</label>
                    <div class="mono">@c.DocDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Vade Tarihi</label>
                    <div class="mono">@c.DueDate.ToString("dd MMM yyyy")</div>
                </div>
                @if (c.CollectedAt.HasValue)
                {
                    <div class="form-group">
                        <label class="form-label">Tahsil Tarihi</label>
                        <div class="mono text-success">@c.CollectedAt.Value.ToString("dd MMM yyyy")</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(c.ReturnReason))
                {
                    <div class="form-group">
                        <label class="form-label">Karşılıksız Sebebi</label>
                        <div class="text-danger">@c.ReturnReason</div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>
