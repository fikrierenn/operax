@page
@using Operax.Web.Lib
@model Operax.Web.Features.Finance.CreditCards.CreateModel
@{
    ViewData["Title"] = "Yeni Kredi Kartı";
    var header = new PageHeaderVm(
        Title: "Yeni Kredi Kartı",
        Crumbs: new[] { "Anasayfa", "Finans", "Kredi Kartları", "Yeni" },
        Sub: "Kart tanımla — finansal hesap otomatik oluşturulur",
        ActionsHtml: "<a href=\"/Finance/CreditCards/Index\" class=\"btn btn-secondary btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Card Create" style="max-width:820px;">
    <partial name="_PageHeader" model="header" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-banner alert-danger" style="margin-bottom:14px;">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <div>@e.ErrorMessage</div> }
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-hdr"><div class="card-title">Kart Bilgileri</div></div>
            <div class="card-body">
                <div class="form-row-3">
                    <div class="form-group">
                        <label class="form-label">Kart No (son 4) <span class="req">*</span></label>
                        <input asp-for="Form.CardNoMasked" class="form-ctrl" placeholder="****1234" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kart Sahibi <span class="req">*</span></label>
                        <input asp-for="Form.HolderName" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Banka <span class="req">*</span></label>
                        <input asp-for="Form.BankName" class="form-ctrl" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Kart Tipi</label>
                        <select asp-for="Form.CardType" class="form-ctrl">
                            <option value="CREDIT">Kredi Kartı</option>
                            <option value="BUSINESS">Ticari Kart</option>
                            <option value="CORPORATE">Kurumsal Kart</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Limit (₺) <span class="req">*</span></label>
                        <input asp-for="Form.CreditLimit" type="number" step="0.01" min="0" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Gecikme Faizi (%)</label>
                        <input asp-for="Form.InterestRate" type="number" step="0.01" class="form-ctrl" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Ekstre Günü <span class="req">*</span></label>
                        <input asp-for="Form.StatementDay" type="number" min="1" max="28" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Son Ödeme Günü <span class="req">*</span></label>
                        <input asp-for="Form.DueDay" type="number" min="1" max="28" class="form-ctrl" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Son Kullanım</label>
                        <input asp-for="Form.ExpiresAt" type="date" class="form-ctrl" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Ödeme Banka Hesabı</label>
                        <select asp-for="Form.LinkedBankAccountId" class="form-ctrl">
                            <option value="">Seçiniz...</option>
                            @foreach (var a in Model.BankAccounts) { <option value="@a.Id">@a.Name</option> }
                        </select>
                        <span class="form-hint">Ekstre ödemesi bu hesaptan düşer</span>
                    </div>
                </div>
            </div>
            <div class="card-foot">
                <a href="/Finance/CreditCards/Index" class="btn btn-secondary btn-sm">İptal</a>
                <button type="submit" class="btn btn-primary btn-sm">Kartı Tanımla</button>
            </div>
        </div>
    </form>
</div>
