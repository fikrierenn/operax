@page
@using Operax.Web.Lib
@model Operax.Web.Features.Finance.Payments.CreateModel
@{
    var isTahsilat = Model.Form.TxType == TransactionType.Income;
    ViewData["Title"] = isTahsilat ? "Tahsilat Girişi" : "Ödeme Girişi";

    var header = new PageHeaderVm(
        Title: isTahsilat ? "Tahsilat Girişi" : "Ödeme Girişi",
        Crumbs: new[] { "Anasayfa", "Finans", isTahsilat ? "Tahsilat" : "Ödeme" },
        Sub: isTahsilat ? "Müşteriden para tahsil et" : "Tedarikçiye ödeme yap",
        ActionsHtml: "<a href=\"/Finance/PaymentPlan/Index\" class=\"btn btn-ghost btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Ödeme / Tahsilat">
    <partial name="_PageHeader" model="header" />

    @if (TempData["Error"] is string err)
    {
        <div class="alert-banner alert-danger">@err</div>
    }

    <form method="post" style="max-width:680px;">
        @Html.AntiForgeryToken()

        @* İşlem tipi seçimi *@
        <div class="card" style="margin-bottom:14px;">
            <div class="card-body" style="display:flex;gap:10px;">
                <label class="chk" style="flex:1;justify-content:center;padding:12px;border:1px solid var(--border);border-radius:8px;cursor:pointer;@(isTahsilat ? "border-color:var(--success);background:var(--success-bg);" : "")">
                    <input type="radio" asp-for="Form.TxType" value="INCOME"
                           onchange="this.form.submit()" style="display:none;" />
                    <span style="font-weight:600;color:var(--success-text);">⬆ Tahsilat</span>
                </label>
                <label class="chk" style="flex:1;justify-content:center;padding:12px;border:1px solid var(--border);border-radius:8px;cursor:pointer;@(!isTahsilat ? "border-color:var(--danger);background:var(--danger-bg);" : "")">
                    <input type="radio" asp-for="Form.TxType" value="EXPENSE"
                           onchange="this.form.submit()" style="display:none;" />
                    <span style="font-weight:600;color:var(--danger-text);">⬇ Ödeme</span>
                </label>
            </div>
        </div>

        <div class="card">
            <div class="card-hdr">
                <div class="card-title">@(isTahsilat ? "Tahsilat Detayları" : "Ödeme Detayları")</div>
            </div>
            <div class="card-body">

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">@(isTahsilat ? "Müşteri" : "Tedarikçi") <span class="req">*</span></label>
                        <select asp-for="Form.PartnerId" class="form-ctrl" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var p in Model.Partners)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@(isTahsilat ? "Tahsil Edilecek Hesap" : "Ödenecek Hesap") <span class="req">*</span></label>
                        <select asp-for="Form.AccountId" class="form-ctrl" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var a in Model.Accounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Tutar <span class="req">*</span></label>
                        <input asp-for="Form.Amount" type="number" step="0.01" min="0.01"
                               class="form-ctrl" placeholder="0,00" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Para Birimi</label>
                        <select asp-for="Form.Currency" class="form-ctrl">
                            <option value="TRY">TRY — Türk Lirası</option>
                            <option value="USD">USD — Amerikan Doları</option>
                            <option value="EUR">EUR — Euro</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Ödeme Yöntemi</label>
                        <select asp-for="Form.InstrumentType" class="form-ctrl">
                            <option value="EFT">EFT / Havale</option>
                            <option value="CASH">Nakit</option>
                            <option value="CHEQUE">Çek</option>
                            <option value="CARD">Kredi Kartı</option>
                            <option value="PROMISSORY">Senet</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Açıklama</label>
                        <input asp-for="Form.Description" class="form-ctrl"
                               placeholder="İsteğe bağlı not..." />
                    </div>
                </div>

                <div class="form-row" style="margin-top:8px;">
                    <div class="form-group" style="grid-column:1/-1;display:flex;gap:10px;justify-content:flex-end;">
                        <a href="/Finance/PaymentPlan/Index" class="btn btn-ghost">İptal</a>
                        <button type="submit" class="btn @(isTahsilat ? "btn-success" : "btn-danger")">
                            @(isTahsilat ? "Tahsilat Kaydet" : "Ödeme Kaydet")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
