@page
@model Operax.Web.Features.Inventory.Movements.IndexModel
@{
    ViewData["Title"] = "Stock Movements";
}

<div class="mb-6">
    <h2 class="text-2xl font-bold">Stock Movements</h2>
    <p class="text-slate-500 text-sm">Historical ledger of all inventory transactions</p>
</div>

<div class="bg-white rounded-xl border shadow-sm overflow-hidden text-sm">
    <div class="p-4 bg-slate-50 border-b flex flex-wrap gap-4 font-medium">
        <div class="flex flex-col gap-1">
            <label class="text-[10px] uppercase text-slate-400">Date Range</label>
            <input type="date" class="bg-white border rounded px-3 py-1.5 outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>
        <div class="flex flex-col gap-1">
            <label class="text-[10px] uppercase text-slate-400">Movement Type</label>
            <select class="bg-white border rounded px-3 py-1.5 outline-none focus:ring-2 focus:ring-indigo-600">
                <option>All Types</option>
                <option>RECEIPT</option>
                <option>ISSUE</option>
                <option>TRANSFER</option>
            </select>
        </div>
        <div class="flex flex-col gap-1 flex-1">
            <label class="text-[10px] uppercase text-slate-400">Search</label>
            <input type="text" placeholder="Search by SKU, Lot or Doc No..." class="bg-white border rounded px-3 py-1.5 outline-none focus:ring-2 focus:ring-indigo-600" />
        </div>
    </div>
    
    <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b">
            <tr>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Date</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Item</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Location</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Quantity</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Operator</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Source Doc</th>
            </tr>
        </thead>
        <tbody class="divide-y text-[13px]">
            @foreach (var m in Model.Movements)
            {
                <tr class="hover:bg-slate-50 transition-colors @(m.QtyBase < 0 ? "bg-red-50/10" : "bg-green-50/10")">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="font-bold text-xs uppercase">@m.CreatedAt.ToString("dd MMM yyyy")</div>
                        <div class="text-[10px] text-slate-400 font-mono">@m.CreatedAt.ToString("HH:mm:ss")</div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase @(m.MovementType == "RECEIPT" ? "bg-green-100 text-green-700" : "bg-slate-100 text-slate-600")">
                            @m.MovementType
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <div class="font-bold">@m.ItemName</div>
                        <div class="text-[10px] text-slate-400 font-mono">@m.ItemCode</div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-xs font-semibold">@m.WarehouseCode</div>
                        <div class="text-[10px] font-mono text-slate-500 uppercase">@m.BinCode</div>
                    </td>
                    <td class="px-6 py-4 text-right font-mono font-bold @(m.QtyBase < 0 ? "text-red-600" : "text-green-600")">
                        @(m.QtyBase > 0 ? "+" : "")@m.QtyBase.ToString("N3")
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-2">
                             <div class="w-5 h-5 rounded-full bg-slate-200 flex items-center justify-center text-[8px] font-bold text-slate-500 ring-1 ring-slate-300">@((m.OperatorName ?? "S").Substring(0,1).ToUpper())</div>
                             <span class="text-xs text-slate-600 font-medium">@(m.OperatorName ?? "System")</span>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-xs font-bold">@m.SourceDocNo</div>
                        <div class="text-[10px] text-slate-400 uppercase">@m.SourceDocType</div>
                    </td>
                </tr>
            }
            @if (!Model.Movements.Any())
            {
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center text-slate-400 italic">No movements recorded yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
