@page
@model Operax.Web.Features.Inventory.Movements.IndexModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = "Stok Hareketleri";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item hover:text-[var(--brand-600)]">Raporlar & Analiz</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Stok Hareketleri</span>
        </div>
        <h1>Stok Hareket Raporu</h1>
        <p class="page-hdr-sub">Depolarınızda gerçekleşen tüm stok giriş, çıkış ve transfer hareketleri</p>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-glow brand"></div>
        <div class="kpi-icon bg-[var(--brand-tint-08)] text-[var(--brand-600)]">⚡</div>
        <span class="kpi-label">Son 24 Saat</span>
        <div class="kpi-val text-[var(--text)]">@Model.Last24hMovements</div>
        <span class="kpi-sub">Gerçekleşen işlem adedi</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <div class="kpi-icon bg-[var(--success-bg)] text-[var(--success-text)]">📈</div>
        <span class="kpi-label">Toplam Giriş Hacmi</span>
        <div class="kpi-val text-[var(--text)]">@Model.InflowVolume.ToString("N0")</div>
        <span class="kpi-sub">Kabul edilen baz miktar</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow danger"></div>
        <div class="kpi-icon bg-[var(--danger-bg)] text-[var(--danger)]">📉</div>
        <span class="kpi-label">Toplam Çıkış Hacmi</span>
        <div class="kpi-val text-[var(--text)]">@Model.OutflowVolume.ToString("N0")</div>
        <span class="kpi-sub">Sevk edilen baz miktar</span>
    </div>
</div>

<div class="card overflow-hidden mt-6 text-sm">
    <form method="get" class="filter-bar">
        <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-ctrl text-xs font-semibold" title="Başlangıç tarihi" />
        <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-ctrl text-xs font-semibold" title="Bitiş tarihi" />
        <select name="Type" class="form-ctrl text-xs font-semibold w-44" onchange="this.form.submit()">
            <option value="">Tüm Hareketler</option>
            <option value="RECEIPT" selected="@(Model.Type == "RECEIPT")">Giriş (RECEIPT)</option>
            <option value="ISSUE"   selected="@(Model.Type == "ISSUE")">Çıkış (ISSUE)</option>
            <option value="TRANSFER" selected="@(Model.Type == "TRANSFER")">Transfer</option>
        </select>
        <input type="text" name="Q" value="@Model.Q" placeholder="SKU, ürün adı veya belge no ara..." class="form-ctrl text-xs w-1/3" />
        <button type="submit" class="btn btn-primary text-xs">Ara</button>
        @if (!string.IsNullOrEmpty(Model.Q) || !string.IsNullOrEmpty(Model.Type) || Model.From.HasValue || Model.To.HasValue)
        {
            <a href="/Inventory/Movements" class="btn btn-ghost text-xs">Temizle</a>
        }
    </form>
    
    <table class="data-table">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>İşlem Tipi</th>
                <th>Ürün / SKU</th>
                <th>Lokasyon</th>
                <th class="text-right">Miktar</th>
                <th>Operatör</th>
                <th>Kaynak Belge</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Movements)
            {
                <tr class="hover:bg-[var(--bg-2)] transition-colors @(m.QtyBase < 0 ? "bg-[var(--danger-bg)]/20" : "bg-[var(--success-bg)]/20")">
                    <td>
                        <div class="font-bold text-xs uppercase text-[var(--text-2)]">@m.CreatedAt.ToString("dd MMM yyyy")</div>
                        <div class="text-[10px] text-[var(--text-4)] font-mono">@m.CreatedAt.ToString("HH:mm:ss")</div>
                    </td>
                    <td>
                        <span class="badge @(m.MovementType == MovementType.Receipt ? "badge-success" : m.MovementType == MovementType.Issue ? "badge-danger" : "badge-neutral")">
                            @(m.MovementType == MovementType.Receipt ? "Giriş" : m.MovementType == MovementType.Issue ? "Çıkış" : "Transfer")
                        </span>
                    </td>
                    <td>
                        <div class="font-bold text-[var(--text)] text-sm">@m.ItemName</div>
                        <div class="text-[10px] text-[var(--text-4)] font-mono">@m.ItemCode</div>
                    </td>
                    <td>
                        <div class="text-xs font-bold text-[var(--text-2)]">@m.WarehouseCode</div>
                        <div class="text-[10px] font-mono text-[var(--text-4)] uppercase">@m.BinCode</div>
                    </td>
                    <td class="text-right font-mono font-bold @(m.QtyBase < 0 ? "text-[var(--danger)]" : "text-[var(--success)]")">
                        @(m.QtyBase > 0 ? "+" : "")@m.QtyBase.ToString("N3")
                    </td>
                    <td>
                        <div class="flex items-center gap-2">
                             <div class="w-5 h-5 rounded-full bg-[var(--bg-2)] flex items-center justify-center text-[8px] font-bold text-[var(--text-3)] ring-1 ring-[var(--border)]">@((m.OperatorName ?? "S").Substring(0,1).ToUpper())</div>
                             <span class="text-xs text-[var(--text-2)] font-semibold">@(m.OperatorName ?? "Sistem")</span>
                        </div>
                    </td>
                    <td>
                        <div class="text-xs font-bold text-[var(--text-2)]">@m.SourceDocNo</div>
                        <div class="text-[10px] text-[var(--text-4)] uppercase">@Dict.Label("SOURCE_DOC_TYPE", m.SourceDocType)</div>
                    </td>
                </tr>
            }
            @if (!Model.Movements.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg class="w-12 h-12 text-[var(--text-mute)] mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            <p>Henüz kayıtlı stok hareketi bulunmuyor.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
