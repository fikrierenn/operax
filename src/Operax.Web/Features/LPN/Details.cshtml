@page "{code}"
@model Operax.Web.Features.LPN.DetailsModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = $"Palet Sorgulama: {Model.Lpn.Code}";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="flex items-center gap-3 mb-1">
            <h1>@Model.Lpn.Code</h1>
            @Html.Raw(Dict.StatusBadge(Model.Lpn.Status, "LPN_STATUS"))
        </div>
        <p class="page-hdr-sub">Güncel Konum: <span class="font-bold text-[var(--text)] font-mono">@Model.Lpn.WhCode / @Model.Lpn.BinCode</span></p>
    </div>
    <div class="page-hdr-r flex gap-2">
        <button class="btn btn-primary">Paleti Taşı</button>
        <button class="btn btn-secondary">Yazdır</button>
    </div>
</div>

<div class="card mb-8">
    <div class="card-hdr flex justify-between items-center">
        <span class="card-title">Palet İçeriği (SKU Bazlı)</span>
        <span class="text-[var(--text-4)] text-xs font-bold">@Model.Contents.Count() Kalem Mevcut</span>
    </div>
    <div class="table-scroll">
        <table class="data-table" style="min-width:480px">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th>Lot</th>
                    <th class="text-right">Miktar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Contents)
                {
                    <tr>
                        <td>
                            <div class="font-bold text-[var(--brand-600)]">@line.ItemName</div>
                            <div class="text-[10px] text-[var(--text-4)] font-mono">@line.ItemCode</div>
                        </td>
                        <td class="font-mono text-[var(--text-2)]">@(line.LotNo ?? "-")</td>
                        <td class="text-right font-mono font-bold text-[var(--text)] underline decoration-[var(--brand-600)]">
                            @line.Qty.ToString("N2")
                        </td>
                    </tr>
                }
                @if (!Model.Contents.Any())
                {
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-[var(--text-mute)] italic">Palet içeriği boş.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="card text-center relative overflow-hidden" style="background:var(--brand-600);color:#fff">
        <div class="absolute top-0 right-0 p-4" style="opacity:.10">
            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24"><path d="M20 8h-3V4H3v12h2v4h16V8h-1zM5 14H5V6h10v8H5zm14 4H7v-2h10V10h2v8z"/></svg>
        </div>
        <div class="relative z-10 p-6">
            <div class="text-[10px] uppercase font-bold tracking-widest mb-1" style="color:rgba(255,255,255,.65)">Palet Özeti</div>
            <div class="text-4xl font-black mb-1">@Model.Contents.Sum(c => c.Qty).ToString("N0")</div>
            <div class="text-xs" style="color:rgba(255,255,255,.75)">Toplam Ürün Adedi</div>
        </div>
    </div>

    <div class="card flex flex-col justify-center gap-2">
        <div class="card-hdr"><span class="card-title">Operasyonel Durum</span></div>
        <div class="card-body flex flex-col gap-2">
            <div class="flex items-center gap-2 text-xs">
                <div class="w-2 h-2 rounded-full bg-[var(--success)]"></div>
                <span class="text-[var(--text-3)]">Mal Kabul Paleti (Ready for Putaway)</span>
            </div>
            <p class="text-[10px] text-[var(--text-4)] italic">Bu palet mal kabul alanında beklemektedir. Raf adresleme sırasındadır.</p>
        </div>
    </div>
</div>
