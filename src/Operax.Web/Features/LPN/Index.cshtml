@page
@model Operax.Web.Features.LPN.IndexModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = "Palet (LPN) Yönetimi";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <h1>Palet / Kap Yönetimi</h1>
        <p class="page-hdr-sub">LPN bazlı stok takibi ve konum izleme</p>
    </div>
</div>

<!-- KPI Özet Kartları -->
<div class="kpi-row">
    <div class="kpi">
        <span class="kpi-label">Toplam Palet</span>
        <div class="kpi-val text-[var(--brand-600)]">@Model.Lpns.Count()</div>
        <span class="kpi-sub">Kayıtlı tüm paletler</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Kullanımda</span>
        <div class="kpi-val text-[var(--success)]">@Model.Lpns.Count(x => x.Status == LpnStatus.InUse)</div>
        <span class="kpi-sub">Stok taşıyan paletler</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Boş / Müsait</span>
        <div class="kpi-val text-[var(--warn-text)]">@Model.Lpns.Count(x => x.Status == LpnStatus.Available)</div>
        <span class="kpi-sub">Kullanılabilir paletler</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Sevk Edildi</span>
        <div class="kpi-val text-[var(--text-4)]">@Model.Lpns.Count(x => x.Status == LpnStatus.Shipped)</div>
        <span class="kpi-sub">Sevkiyat yapılan paletler</span>
    </div>
</div>

<div class="card">
    <div class="table-scroll">
        <table class="data-table" style="min-width:680px">
            <thead>
                <tr>
                    <th>Palet Kodu</th>
                    <th>Tip</th>
                    <th>Durum</th>
                    <th>Konum</th>
                    <th class="text-right">Ürün Çeşidi</th>
                    <th class="text-right">Toplam Adet</th>
                    <th>Oluşturulma</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lpn in Model.Lpns)
                {
                    <tr>
                        <td class="font-mono font-bold text-[var(--brand-600)] tracking-tight">@lpn.Code</td>
                        <td>
                            <span class="badge badge-neutral">@(lpn.LpnType switch {
                                LpnType.Pallet => "Palet",
                                LpnType.Box    => "Kutu",
                                LpnType.Carton => "Koli",
                                _              => lpn.LpnType
                            })</span>
                        </td>
                        <td>@Html.Raw(Dict.StatusBadge(lpn.Status, "LPN_STATUS"))</td>
                        <td>
                            @if (lpn.WhCode != null)
                            {
                                <span class="font-mono text-[var(--text-2)]">@lpn.WhCode</span>
                                @if (lpn.BinCode != null)
                                {
                                    <span class="text-[var(--text-4)]"> / </span>
                                    <span class="font-mono font-bold text-[var(--brand-600)]">@lpn.BinCode</span>
                                }
                            }
                            else
                            {
                                <span class="text-[var(--text-mute)] italic text-xs">Konumsuz</span>
                            }
                        </td>
                        <td class="text-right font-mono text-[var(--text-2)]">@(lpn.ItemCount?.ToString() ?? "0")</td>
                        <td class="text-right font-mono font-bold text-[var(--text)]">@lpn.TotalQty.ToString("N2")</td>
                        <td class="text-[var(--text-3)] text-xs">@lpn.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-right">
                            <a asp-page="./Details" asp-route-code="@lpn.Code" class="btn btn-secondary btn-sm">Sorgula</a>
                        </td>
                    </tr>
                }
                @if (!Model.Lpns.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                    <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                                </svg>
                                <p>Henüz kayıtlı palet bulunmuyor. Paletler mal kabul sürecinde oluşturulur.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
