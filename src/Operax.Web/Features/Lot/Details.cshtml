@page "{id:guid}"
@model Operax.Web.Features.Lot.DetailsModel
@{
    ViewData["Title"] = $"Lot: {Model.Lot.LotNo}";
    var lot = Model.Lot;
}

@if (lot.Id == Guid.Empty)
{
    <div class="empty-state"><p>Lot bulunamadı.</p></div>
    return;
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-3 mb-1">
            <h2 class="text-2xl font-bold font-mono tracking-tight">@lot.LotNo</h2>
            <span class="badge @(lot.Status switch {
                LotStatus.Available  => "b-green",
                LotStatus.Quarantine => "b-amber",
                LotStatus.Blocked    => "b-red",
                _                    => "b-gray"
            })">@(lot.Status switch {
                LotStatus.Available  => "Müsait",
                LotStatus.Quarantine => "Karantina",
                LotStatus.Blocked    => "Bloke",
                _                    => lot.Status
            })</span>
            @if (lot.IsExpired)
            {
                <span class="badge b-red">SKT Geçti</span>
            }
            else if (lot.ExpiryDate.HasValue && lot.DaysToExpiry <= 30)
            {
                <span class="badge b-amber">@lot.DaysToExpiry gün kaldı</span>
            }
        </div>
        <p class="text-sm text-slate-500">
            <span class="font-bold text-slate-800">@lot.ItemCode</span> — @lot.ItemName
        </p>
    </div>
    <a asp-page="./Index" class="btn btn-secondary">← Listeye Dön</a>
</div>

<!-- Üst Özet Kartları -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="kpi">
        <span class="kpi-label">Mevcut Stok</span>
        <div class="kpi-val text-indigo-600">@lot.QtyOnHand.ToString("N2")</div>
        <span class="kpi-sub">Toplam miktarı</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Üretim Tarihi</span>
        <div class="kpi-val text-slate-700 text-xl">
            @(lot.ProductionDate.HasValue ? lot.ProductionDate.Value.ToString("dd.MM.yyyy") : "—")
        </div>
        <span class="kpi-sub">İmalat tarihi</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Son Kullanma</span>
        <div class="kpi-val @(lot.IsExpired ? "text-red-600" : lot.DaysToExpiry <= 30 ? "text-amber-600" : "text-slate-700") text-xl">
            @(lot.ExpiryDate.HasValue ? lot.ExpiryDate.Value.ToString("dd.MM.yyyy") : "—")
        </div>
        <span class="kpi-sub">SKT</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Konum Sayısı</span>
        <div class="kpi-val text-slate-700">@Model.Locations.Count()</div>
        <span class="kpi-sub">Farklı raf</span>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Konum Dağılımı -->
    <div class="card lg:col-span-1">
        <div class="px-4 py-3 border-b bg-slate-50">
            <h3 class="font-bold text-xs uppercase text-slate-500 tracking-widest">Konum Dağılımı</h3>
        </div>
        <div class="divide-y">
            @foreach (var loc in Model.Locations)
            {
                <div class="px-4 py-3 flex justify-between items-center">
                    <div>
                        <span class="font-mono text-slate-600 text-xs">@loc.WhCode</span>
                        <span class="text-slate-400 text-xs"> / </span>
                        <span class="font-mono font-bold text-indigo-600 text-sm">@(loc.BinCode ?? "—")</span>
                    </div>
                    <span class="font-mono font-bold text-slate-900">@loc.Qty.ToString("N2")</span>
                </div>
            }
            @if (!Model.Locations.Any())
            {
                <div class="px-4 py-8 text-center text-slate-400 text-sm italic">Depoda stok yok</div>
            }
        </div>
    </div>

    <!-- Hareket Geçmişi -->
    <div class="card lg:col-span-2">
        <div class="px-4 py-3 border-b bg-slate-50 flex justify-between items-center">
            <h3 class="font-bold text-xs uppercase text-slate-500 tracking-widest">Hareket Geçmişi</h3>
            <span class="text-[10px] font-bold text-slate-400">Son 200 hareket</span>
        </div>
        <div class="overflow-auto max-h-96">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Hareket Tipi</th>
                        <th>Kaynak Belge</th>
                        <th>Konum</th>
                        <th class="text-right">Miktar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mv in Model.Movements)
                    {
                        <tr>
                            <td class="text-xs text-slate-500 whitespace-nowrap">
                                @mv.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @(mv.MovementType switch {
                                    MovementType.Receipt  => "b-green",
                                    MovementType.Issue    => "b-red",
                                    MovementType.Transfer => "b-blue",
                                    MovementType.CountAdj => "b-amber",
                                    _                     => "b-gray"
                                })">@(mv.MovementType switch {
                                    MovementType.Receipt    => "Giriş",
                                    MovementType.Issue      => "Çıkış",
                                    MovementType.Transfer   => "Transfer",
                                    "CONSUMPTION"           => "Tüketim",
                                    MovementType.Production  => "Üretim",
                                    MovementType.CountAdj   => "Sayım Düz.",
                                    _             => mv.MovementType
                                })</span>
                            </td>
                            <td class="font-mono text-slate-600 text-xs">
                                @(mv.SourceDoc ?? "—")
                            </td>
                            <td class="font-mono text-xs">
                                @if (mv.WhCode != null)
                                {
                                    <span class="text-slate-500">@mv.WhCode</span>
                                    @if (mv.BinCode != null) { <span class="text-slate-400">/</span><span class="font-bold text-indigo-600">@mv.BinCode</span> }
                                }
                                else { <span class="text-slate-300">—</span> }
                            </td>
                            <td class="text-right font-mono font-bold @(mv.QtyBase >= 0 ? "text-green-600" : "text-red-600")">
                                @(mv.QtyBase >= 0 ? "+" : "")@mv.QtyBase.ToString("N2")
                            </td>
                        </tr>
                    }
                    @if (!Model.Movements.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state"><p>Hareket kaydı bulunamadı.</p></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(lot.Notes))
{
    <div class="card p-4">
        <h4 class="font-bold text-xs uppercase text-slate-500 tracking-widest mb-2">Notlar</h4>
        <p class="text-sm text-slate-700">@lot.Notes</p>
    </div>
}
