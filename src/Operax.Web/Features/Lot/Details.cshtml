@page "{id:guid}"
@model Operax.Web.Features.Lot.DetailsModel
@{
    ViewData["Title"] = $"Lot: {Model.Lot.LotNo}";
    var lot = Model.Lot;
}

@if (lot.Id == Guid.Empty)
{
    <div class="empty-state"><p>Lot bulunamadı.</p></div>
    return;
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="flex items-center gap-3 mb-1">
            <h1 class="font-mono tracking-tight">@lot.LotNo</h1>
            @Html.Raw(Operax.Web.Lib.UiHelpers.StatusBadgeHtml(lot.Status, lot.Status switch {
                LotStatus.Available  => "Müsait",
                LotStatus.Quarantine => "Karantina",
                LotStatus.Blocked    => "Bloke",
                _                    => lot.Status
            }))
            @if (lot.IsExpired)
            {
                <span class="badge badge-danger">SKT Geçti</span>
            }
            else if (lot.ExpiryDate.HasValue && lot.DaysToExpiry <= 30)
            {
                <span class="badge badge-warn">@lot.DaysToExpiry gün kaldı</span>
            }
        </div>
        <p class="page-hdr-sub">
            <span class="font-bold text-[var(--text)]">@lot.ItemCode</span> — @lot.ItemName
        </p>
    </div>
    <a asp-page="./Index" class="btn btn-secondary">← Listeye Dön</a>
</div>

<!-- Üst Özet Kartları -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="kpi">
        <span class="kpi-label">Mevcut Stok</span>
        <div class="kpi-val text-[var(--brand-600)]">@lot.QtyOnHand.ToString("N2")</div>
        <span class="kpi-sub">Toplam miktarı</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Üretim Tarihi</span>
        <div class="kpi-val text-[var(--text-2)] text-xl">
            @(lot.ProductionDate.HasValue ? lot.ProductionDate.Value.ToString("dd.MM.yyyy") : "—")
        </div>
        <span class="kpi-sub">İmalat tarihi</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Son Kullanma</span>
        <div class="kpi-val @(lot.IsExpired ? "text-[var(--danger)]" : lot.DaysToExpiry <= 30 ? "text-[var(--warn-text)]" : "text-[var(--text-2)]") text-xl">
            @(lot.ExpiryDate.HasValue ? lot.ExpiryDate.Value.ToString("dd.MM.yyyy") : "—")
        </div>
        <span class="kpi-sub">SKT</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Konum Sayısı</span>
        <div class="kpi-val text-[var(--text-2)]">@Model.Locations.Count()</div>
        <span class="kpi-sub">Farklı raf</span>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Konum Dağılımı -->
    <div class="card lg:col-span-1">
        <div class="card-hdr">
            <span class="card-title">Konum Dağılımı</span>
        </div>
        <div class="card-body divide-y">
            @foreach (var loc in Model.Locations)
            {
                <div class="px-4 py-3 flex justify-between items-center">
                    <div>
                        <span class="font-mono text-[var(--text-2)] text-xs">@loc.WhCode</span>
                        <span class="text-[var(--text-4)] text-xs"> / </span>
                        <span class="font-mono font-bold text-[var(--brand-600)] text-sm">@(loc.BinCode ?? "—")</span>
                    </div>
                    <span class="font-mono font-bold text-[var(--text)]">@loc.Qty.ToString("N2")</span>
                </div>
            }
            @if (!Model.Locations.Any())
            {
                <div class="px-4 py-8 text-center text-[var(--text-4)] text-sm italic">Depoda stok yok</div>
            }
        </div>
    </div>

    <!-- Hareket Geçmişi -->
    <div class="card lg:col-span-2">
        <div class="card-hdr">
            <span class="card-title">Hareket Geçmişi</span>
            <span class="text-[10px] font-bold text-[var(--text-4)]">Son 200 hareket</span>
        </div>
        <div class="overflow-auto max-h-96">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Hareket Tipi</th>
                        <th>Kaynak Belge</th>
                        <th>Konum</th>
                        <th class="text-right">Miktar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mv in Model.Movements)
                    {
                        <tr>
                            <td class="text-xs text-[var(--text-3)] whitespace-nowrap">
                                @mv.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td>
                                @Html.Raw(Operax.Web.Lib.UiHelpers.StatusBadgeHtml(mv.MovementType, mv.MovementType switch {
                                    MovementType.Receipt    => "Giriş",
                                    MovementType.Issue      => "Çıkış",
                                    MovementType.Transfer   => "Transfer",
                                    "CONSUMPTION"           => "Tüketim",
                                    MovementType.Production => "Üretim",
                                    MovementType.CountAdj   => "Sayım Düz.",
                                    _                       => mv.MovementType
                                }))
                            </td>
                            <td class="font-mono text-[var(--text-2)] text-xs">
                                @(mv.SourceDoc ?? "—")
                            </td>
                            <td class="font-mono text-xs">
                                @if (mv.WhCode != null)
                                {
                                    <span class="text-[var(--text-3)]">@mv.WhCode</span>
                                    @if (mv.BinCode != null) { <span class="text-[var(--text-4)]">/</span><span class="font-bold text-[var(--brand-600)]">@mv.BinCode</span> }
                                }
                                else { <span class="text-[var(--text-mute)]">—</span> }
                            </td>
                            <td class="text-right font-mono font-bold @(mv.QtyBase >= 0 ? "text-[var(--success)]" : "text-[var(--danger)]")">
                                @(mv.QtyBase >= 0 ? "+" : "")@mv.QtyBase.ToString("N2")
                            </td>
                        </tr>
                    }
                    @if (!Model.Movements.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state"><p>Hareket kaydı bulunamadı.</p></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(lot.Notes))
{
    <div class="card">
        <div class="card-hdr"><span class="card-title">Notlar</span></div>
        <div class="card-body">
            <p class="text-sm text-[var(--text-2)]">@lot.Notes</p>
        </div>
    </div>
}
