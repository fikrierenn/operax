@page
@model Operax.Web.Features.Manufacturing.WorkCenters.IndexModel
@{
    ViewData["Title"] = "İş Merkezleri";
}

<div class="page-hdr">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">İş Merkezleri / Makineler</h2>
        <p class="text-sm text-slate-500 mt-0.5">Üretim operasyonlarının gerçekleştiği iş istasyonları ve maliyet oranları</p>
    </div>
    <button onclick="document.getElementById('addForm').classList.toggle('hidden')" class="btn btn-primary">
        + Yeni İş Merkezi
    </button>
</div>

<!-- Ekle Formu (Gizli) -->
<div id="addForm" class="card mb-6 p-5 hidden">
    <h3 class="font-bold text-xs uppercase text-slate-500 tracking-widest mb-4">Yeni İş Merkezi</h3>
    <form method="post">
        <input asp-for="Form.Id" type="hidden" value="" />
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div>
                <label class="label">Kod *</label>
                <input asp-for="Form.Code" class="input w-full font-mono" placeholder="CNC-01" required />
            </div>
            <div class="md:col-span-2">
                <label class="label">Ad *</label>
                <input asp-for="Form.Name" class="input w-full" placeholder="CNC Kesim Hattı" required />
            </div>
            <div>
                <label class="label">İşçilik Maliyeti (₺/Saat)</label>
                <input asp-for="Form.LaborRatePerHour" type="number" step="0.01" min="0" class="input w-full" />
            </div>
            <div>
                <label class="label">Makine Maliyeti (₺/Saat)</label>
                <input asp-for="Form.MachineRatePerHour" type="number" step="0.01" min="0" class="input w-full" />
            </div>
            <div>
                <label class="label">Elektrik Maliyeti (₺/Saat)</label>
                <input asp-for="Form.ElectricityRatePerHour" type="number" step="0.01" min="0" class="input w-full" />
            </div>
        </div>
        <div class="mt-4 flex items-center gap-4">
            <label class="flex items-center gap-2 text-sm">
                <input asp-for="Form.IsActive" type="checkbox" class="w-4 h-4 accent-indigo-600" />
                Aktif
            </label>
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <button type="button" onclick="document.getElementById('addForm').classList.add('hidden')" class="btn btn-secondary">İptal</button>
        </div>
    </form>
</div>

<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Kod</th>
                <th>İş Merkezi Adı</th>
                <th class="text-right">İşçilik (₺/saat)</th>
                <th class="text-right">Makine (₺/saat)</th>
                <th class="text-right">Elektrik (₺/saat)</th>
                <th class="text-right">Toplam (₺/saat)</th>
                <th class="text-center">Durum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wc in Model.WorkCenters)
            {
                var total = wc.LaborRatePerHour + wc.MachineRatePerHour + wc.ElectricityRatePerHour;
                <tr>
                    <td class="font-mono font-bold text-indigo-600">@wc.Code</td>
                    <td class="font-medium text-slate-800">@wc.Name</td>
                    <td class="text-right font-mono text-slate-700">@wc.LaborRatePerHour.ToString("N2")</td>
                    <td class="text-right font-mono text-slate-700">@wc.MachineRatePerHour.ToString("N2")</td>
                    <td class="text-right font-mono text-slate-700">@wc.ElectricityRatePerHour.ToString("N2")</td>
                    <td class="text-right font-mono font-bold text-indigo-600">@total.ToString("N2")</td>
                    <td class="text-center">
                        <span class="badge @(wc.IsActive ? "b-green" : "b-gray")">
                            @(wc.IsActive ? "Aktif" : "Pasif")
                        </span>
                    </td>
                </tr>
            }
            @if (!Model.WorkCenters.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/>
                            </svg>
                            <p>Henüz iş merkezi tanımlanmamış. Üretim rotaları için en az bir iş merkezi gereklidir.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
