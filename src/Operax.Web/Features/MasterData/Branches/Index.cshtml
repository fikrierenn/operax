@page
@model Operax.Web.Features.MasterData.Branches.IndexModel
@{
    ViewData["Title"] = "Şubeler";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item">Tanımlamalar</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Şubeler</span>
        </div>
        <h1>Şube Yönetimi</h1>
        <p class="page-hdr-sub">Satış şubeleri, fabrikalar, mağazalar ve ofislerin merkezi yönetimi</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" class="btn btn-primary px-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Şube
        </a>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-glow brand"></div>
        <div class="kpi-icon bg-indigo-50 text-indigo-600">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <span class="kpi-label">Aktif Şube</span>
        <div class="kpi-val">@Model.ActiveCount</div>
        <span class="kpi-sub">Kullanımdaki şubeler</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <div class="kpi-icon bg-emerald-50 text-emerald-600">
            <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <span class="kpi-label">Bağlı Depo</span>
        <div class="kpi-val">@Model.TotalWarehouseCount</div>
        <span class="kpi-sub">Şubelere atanmış depolar</span>
    </div>
</div>

<div class="card overflow-hidden mt-6">
    <table class="data-table">
        <thead>
            <tr>
                <th>Kod</th>
                <th>Şube Adı</th>
                <th>Şehir</th>
                <th>Tip</th>
                <th class="text-center">Depo</th>
                <th class="text-center">Durum</th>
                <th class="text-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Branches)
            {
                <tr class="cursor-pointer" onclick="window.location='@Url.Page("./Details", new { id = b.Id })'">
                    <td><span class="badge b-indigo font-bold font-mono">@b.Code</span></td>
                    <td><div class="font-bold text-slate-700 text-sm">@b.Name</div></td>
                    <td class="text-slate-500 text-sm">@(b.City ?? "—")</td>
                    <td>
                        @{
                            var (cls, lbl) = b.BranchType switch {
                                "FABRIKA" => ("b-amber", "Fabrika"),
                                "MAGAZA"  => ("b-green", "Mağaza"),
                                "OFIS"    => ("b-gray",  "Ofis"),
                                "MERKEZ"  => ("b-indigo","Merkez"),
                                _         => ("b-blue",  "Şube")
                            };
                        }
                        <span class="badge @cls">@lbl</span>
                    </td>
                    <td class="text-center text-sm font-semibold text-slate-600">@b.WarehouseCount</td>
                    <td class="text-center">
                        @if (b.IsActive) { <span class="badge b-green">AKTİF</span> }
                        else             { <span class="badge b-gray">PASİF</span>  }
                    </td>
                    <td class="text-right" onclick="event.stopPropagation()">
                        <a asp-page="./Details" asp-route-id="@b.Id" class="btn btn-secondary btn-sm">Düzenle</a>
                    </td>
                </tr>
            }
            @if (!Model.Branches.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg class="w-12 h-12 text-slate-200 mb-4" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                            <p>Henüz tanımlanmış şube bulunmuyor.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
