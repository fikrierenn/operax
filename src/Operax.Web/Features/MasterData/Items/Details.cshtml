@page "{id:guid?}"
@model Operax.Web.Features.MasterData.Items.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Ürün" : $"Ürün — {Model.Item.Code}";
    var activeTab = Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "general";
}

<div class="page-hdr">
    <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <a asp-page="./Index" class="btn btn-secondary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Geri
            </a>
            <span style="font-size:11px;color:#64748b">Ürün Yönetimi / @(Model.IsNew ? "Yeni" : Model.Item.Code)</span>
        </div>
        <h1>@(Model.IsNew ? "Yeni Ürün" : Model.Item.Name)</h1>
        <p>Ürün tanımı, birim dönüşümleri ve barkod yönetimi</p>
    </div>
    <div class="page-hdr-r">
        @if (!Model.IsNew)
        {
            <button type="submit" form="item-form" class="btn btn-secondary btn-sm" style="color:#f87171;border-color:rgba(239,68,68,0.3);background:rgba(239,68,68,0.08)">
                Pasif Yap
            </button>
        }
        <button type="submit" form="item-form" class="btn btn-primary">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Kaydet
        </button>
    </div>
</div>

@if (!Model.IsNew)
{
    <!-- Stats -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px">
        <div class="card" style="margin-bottom:0;padding:16px 18px;border-radius:12px">
            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#64748b;margin-bottom:6px">Baz Birim</div>
            <div style="font-size:20px;font-weight:800;color:#818cf8">@Model.Item.BaseUomCode</div>
        </div>
        <div class="card" style="margin-bottom:0;padding:16px 18px;border-radius:12px">
            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#64748b;margin-bottom:6px">Birim Dönüşümleri</div>
            <div style="font-size:20px;font-weight:800;color:#e2e8f0">@Model.UomConversions.Count()</div>
        </div>
        <div class="card" style="margin-bottom:0;padding:16px 18px;border-radius:12px">
            <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;color:#64748b;margin-bottom:6px">Kategori</div>
            <div style="font-size:20px;font-weight:800;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@(Model.Item.CategoryName ?? "Tanımsız")</div>
        </div>
    </div>
}

<!-- Tabs -->
<div style="display:flex;gap:0;border-bottom:1px solid rgba(255,255,255,0.06);margin-bottom:16px">
    @foreach (var tab in new[]{("general","Genel Bilgiler"),("uom","Birim Dönüşümleri"),("barcodes","Barkodlar")})
    {
        <a href="?tab=@tab.Item1" style="padding:10px 18px;font-size:12.5px;font-weight:600;text-decoration:none;border-bottom:2px solid @(activeTab==tab.Item1 ? "#6366f1" : "transparent");color:@(activeTab==tab.Item1 ? "#818cf8" : "#64748b");margin-bottom:-1px;transition:all 0.12s">
            @tab.Item2
        </a>
    }
</div>

<!-- TAB: Genel Bilgiler -->
@if (activeTab == "general")
{
    <form id="item-form" method="post">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <div class="card" style="margin-bottom:0">
                <div class="card-header">
                    <span class="card-title">Temel Bilgiler</span>
                </div>
                <div class="card-body">
                    <div class="form-row-2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px">
                        <div>
                            <label>Ürün Kodu *</label>
                            <input asp-for="Item.Code" placeholder="örn. SKU-1001" required>
                        </div>
                        <div>
                            <label>Baz Birim *</label>
                            <select asp-for="Item.BaseUomId" required>
                                <option value="">Birim seçin...</option>
                                @foreach (var uom in Model.Uoms)
                                {
                                    <option value="@uom.Id">@uom.Name (@uom.Code)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label>Ürün Adı *</label>
                        <input asp-for="Item.Name" placeholder="Tam ürün adını girin" required>
                    </div>
                    <div class="form-row-2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;margin-bottom:14px">
                        <div>
                            <label>Kategori</label>
                            <select asp-for="Item.CategoryId">
                                <option value="">Kategori seçin...</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name (@cat.Code)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label>KDV Oranı (%)</label>
                            <select asp-for="Item.TaxRate" required>
                                <option value="">KDV seçin...</option>
                                @foreach (var tax in Model.TaxRates)
                                {
                                    <option value="@tax.Code">@tax.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label>Açıklama</label>
                        <input asp-for="Item.Description" placeholder="İsteğe bağlı açıklama">
                    </div>
                </div>
            </div>

            <div class="card" style="margin-bottom:0">
                <div class="card-header">
                    <span class="card-title">Takip Ayarları</span>
                </div>
                <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
                    <label style="display:flex;align-items:center;justify-content:space-between;padding:12px;background:rgba(16,185,129,0.08);border-radius:8px;border:1px solid rgba(16,185,129,0.15);cursor:pointer;margin-bottom:0">
                        <div>
                            <div style="font-size:13px;font-weight:600;color:#e2e8f0">Aktif</div>
                            <div style="font-size:11px;color:#64748b;margin-top:1px">Ürün sistemde görünür</div>
                        </div>
                        <input type="checkbox" asp-for="Item.IsActive" style="width:16px;height:16px;accent-color:#6366f1;cursor:pointer">
                    </label>
                    <label style="display:flex;align-items:center;justify-content:space-between;padding:12px;background:rgba(245,158,11,0.08);border-radius:8px;border:1px solid rgba(245,158,11,0.15);cursor:pointer;margin-bottom:0">
                        <div>
                            <div style="font-size:13px;font-weight:600;color:#e2e8f0">Lot Takibi</div>
                            <div style="font-size:11px;color:#64748b;margin-top:1px">Her hareket için lot numarası zorunlu</div>
                        </div>
                        <input type="checkbox" asp-for="Item.IsLotTracked" style="width:16px;height:16px;accent-color:#f59e0b;cursor:pointer">
                    </label>
                    <label style="display:flex;align-items:center;justify-content:space-between;padding:12px;background:rgba(99,102,241,0.08);border-radius:8px;border:1px solid rgba(99,102,241,0.15);cursor:pointer;margin-bottom:0">
                        <div>
                            <div style="font-size:13px;font-weight:600;color:#e2e8f0">Seri No Takibi</div>
                            <div style="font-size:11px;color:#64748b;margin-top:1px">Birim başına benzersiz seri no</div>
                        </div>
                        <input type="checkbox" asp-for="Item.IsSerialTracked" style="width:16px;height:16px;accent-color:#6366f1;cursor:pointer">
                    </label>
                </div>
            </div>
        </div>
    </form>
}

<!-- TAB: Birim Dönüşümleri -->
@if (activeTab == "uom" && !Model.IsNew)
{
    <div class="card">
        <div class="card-header">
            <div>
                <span class="card-title">Birim Dönüşümleri</span>
                <div style="font-size:11px;color:#64748b;margin-top:1px">Baz birim: @Model.Item.BaseUomCode</div>
            </div>
            <button type="button" onclick="document.getElementById('uom-modal').style.display='flex'" class="btn btn-primary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Dönüşüm Ekle
            </button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Birim</th>
                    <th>Dönüşüm (Baza göre)</th>
                    <th style="text-align:right"></th>
                </tr>
            </thead>
            <tbody>
                <tr style="opacity:0.7">
                    <td><span class="badge b-blue">@Model.Item.BaseUomCode</span></td>
                    <td style="font-family:monospace;font-size:12px">1.000000 (Baz)</td>
                    <td style="text-align:right"><span style="font-size:11px;color:#64748b">—</span></td>
                </tr>
                @foreach (var uom in Model.UomConversions)
                {
                    <tr>
                        <td>
                            <span class="badge b-gray">@uom.UomCode</span>
                            <span style="font-size:12px;color:#94a3b8;margin-left:6px">@uom.UomName</span>
                        </td>
                        <td style="font-family:monospace;font-size:12px;font-weight:600">@uom.ConversionRate.ToString("N6")</td>
                        <td style="text-align:right">
                            <form method="post" asp-page-handler="DeleteUom" style="display:inline">
                                <input type="hidden" name="uomConversionId" value="@uom.Id">
                                <input type="hidden" name="id" value="@Model.Item.Id">
                                <button type="submit" class="btn btn-sm" style="color:#f87171;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2)">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.UomConversions.Any())
                {
                    <tr><td colspan="3" class="empty-state" style="padding:32px">Henüz birim dönüşümü tanımlanmamış</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- UOM Add Row -->
    <div class="card">
        <div class="card-header"><span class="card-title">Yeni Dönüşüm Ekle</span></div>
        <form method="post" asp-page-handler="AddUom" class="card-body">
            <input type="hidden" name="id" value="@Model.Item.Id">
            <div style="display:flex;gap:10px;align-items:flex-end">
                <div style="flex:1">
                    <label>Birim</label>
                    <select name="uomId">
                        @foreach (var u in Model.Uoms) { <option value="@u.Id">@u.Name (@u.Code)</option> }
                    </select>
                </div>
                <div style="flex:1">
                    <label>Baza kaç @Model.Item.BaseUomCode eşit?</label>
                    <input name="rate" type="number" step="0.000001" placeholder="örn. 12 (koli = 12 adet)" required>
                </div>
                <button type="submit" class="btn btn-primary" style="flex-shrink:0">Ekle</button>
            </div>
        </form>
    </div>
}

<!-- TAB: Barkodlar -->
@if (activeTab == "barcodes" && !Model.IsNew)
{
    <div class="card">
        <div class="card-header">
            <span class="card-title">Barkodlar</span>
            <button type="button" onclick="document.getElementById('barcode-modal').style.display='flex'" class="btn btn-primary btn-sm">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Barkod Ekle
            </button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Barkod</th>
                    <th>Birim</th>
                    <th style="text-align:right"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bc in Model.Barcodes)
                {
                    <tr>
                        <td><span style="font-family:monospace;font-size:13.5px;letter-spacing:1.5px;font-weight:700;color:#e2e8f0">@bc.Barcode</span></td>
                        <td><span class="badge b-gray">@bc.UomCode</span></td>
                        <td style="text-align:right">
                            <form method="post" asp-page-handler="DeleteBarcode" style="display:inline">
                                <input type="hidden" name="barcodeId" value="@bc.Id">
                                <input type="hidden" name="id" value="@Model.Item.Id">
                                <button type="submit" class="btn btn-sm" style="color:#f87171;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2)">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Barcodes.Any())
                {
                    <tr><td colspan="3" class="empty-state" style="padding:32px">Henüz barkod tanımlanmamış</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.IsNew && activeTab != "general")
{
    <div class="card">
        <div class="card-body empty-state">
            <p>Bu sekmeyi kullanmak için önce ürünü kaydedin.</p>
        </div>
    </div>
}

<!-- UOM Modal -->
<div id="uom-modal" class="modal-overlay" style="display:none">
    <div class="modal">
        <div class="modal-hdr">
            <h3>Birim Dönüşümü Ekle</h3>
            <p>Baz birim @Model.Item.BaseUomCode için dönüşüm tanımlayın</p>
        </div>
        <form method="post" asp-page-handler="AddUom">
            <input type="hidden" name="id" value="@Model.Item.Id">
            <div class="modal-body">
                <div>
                    <label>Birim Seçin</label>
                    <select name="uomId">
                        @foreach (var u in Model.Uoms) { <option value="@u.Id">@u.Name (@u.Code)</option> }
                    </select>
                </div>
                <div>
                    <label>Baza kaç @Model.Item.BaseUomCode eşit?</label>
                    <input name="rate" type="number" step="0.000001" placeholder="örn. 24 → 1 koli = 24 adet" required>
                </div>
            </div>
            <div class="modal-ftr">
                <button type="button" onclick="document.getElementById('uom-modal').style.display='none'" class="btn btn-secondary">İptal</button>
                <button type="submit" class="btn btn-primary">Ekle</button>
            </div>
        </form>
    </div>
</div>

<!-- Barcode Modal -->
<div id="barcode-modal" class="modal-overlay" style="display:none">
    <div class="modal">
        <div class="modal-hdr">
            <h3>Barkod Ekle</h3>
            <p>Bu barkod tarandığında hangi birimi temsil ediyor?</p>
        </div>
        <form method="post" asp-page-handler="AddBarcode">
            <input type="hidden" name="id" value="@Model.Item.Id">
            <div class="modal-body">
                <div>
                    <label>Barkod</label>
                    <input name="barcode" type="text" placeholder="örn. 8690000123456" required>
                </div>
                <div>
                    <label>Bu barkod 1 adet hangi birimi temsil ediyor?</label>
                    <select name="uomId">
                        @foreach (var u in Model.Uoms) { <option value="@u.Id">@u.Name (@u.Code)</option> }
                    </select>
                </div>
            </div>
            <div class="modal-ftr">
                <button type="button" onclick="document.getElementById('barcode-modal').style.display='none'" class="btn btn-secondary">İptal</button>
                <button type="submit" class="btn btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
window.addEventListener('click', e => {
    ['uom-modal','barcode-modal'].forEach(id => {
        const m = document.getElementById(id);
        if (m && e.target === m) m.style.display = 'none';
    });
});
</script>
}
