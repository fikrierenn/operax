@page "{id:guid?}"
@model Operax.Web.Features.MasterData.Items.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Ürün" : $"Ürün — {Model.Item.Code}";
    var activeTab = Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab)) activeTab = "general";
}
@* TempData banner _Layout'ta global render ediliyor — sayfa-içi tekrar yok (çift gösterim önlenir) *@

<div class="flex items-start justify-between mb-8">
    <div>
        <div class="flex items-center gap-2 mb-2">
            <a asp-page="./Index" class="btn btn-secondary py-1 px-3 text-xs">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Geri
            </a>
            <span class="text-[10px] uppercase font-bold tracking-widest text-[var(--text-4)]">Ürün Yönetimi / @(Model.IsNew ? "Yeni" : Model.Item.Code)</span>
        </div>
        <h1 class="text-2xl font-bold text-[var(--text)] tracking-tight">@(Model.IsNew ? "Yeni Ürün Kartı" : Model.Item.Name)</h1>
        <p class="text-sm text-[var(--text-3)] mt-1">Ürün tanımı, birim dönüşümleri ve barkod yönetimi</p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
        @* Pasif Yap: kayıt formundan AYRI handler (Deactivate) — IsActive=0 yapar, silmez.
           Zaten pasif ürün için buton gizlenir. *@
        @if (!Model.IsNew && Model.Item.IsActive)
        {
            <form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Item.Id"
                  onsubmit="return confirm('Bu ürünü pasife almak istediğinize emin misiniz?')">
                <button type="submit" class="btn btn-danger btn-sm px-4">Pasif Yap</button>
            </form>
        }
        <button type="submit" form="item-form" class="btn btn-primary px-8">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Kaydet
        </button>
    </div>
</div>

@if (!Model.IsNew)
{
    @* Üst metrik şeridi — dashboard mini-KPI ile birebir: 4'lü uniform .stat-card grid.
       Stokta Var / Hareketler tıklanabilir (envanter ekranlarına gider). *@
    <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
        <div class="stat-card">
            <span class="stat-label">Baz Birim</span>
            <div class="stat-value">@Model.Item.BaseUomCode</div>
        </div>
        <div class="stat-card">
            <span class="stat-label">Alternatif Birim</span>
            <div class="stat-value">@Model.UomConversions.Count()</div>
            <div class="stat-sub">alternatif birim</div>
        </div>
        <a href="/Inventory/Balance?ItemCode=@Model.Item.Code" class="stat-card">
            <span class="stat-label">Stokta Var</span>
            <div class="stat-value">@Model.QtyOnHand.ToString("N0")</div>
            <div class="stat-sub">mevcut stok →</div>
        </a>
        <a href="/Inventory/Movements?ItemCode=@Model.Item.Code" class="stat-card">
            <span class="stat-label">Hareketler</span>
            <div class="stat-value">@Model.MovementCount</div>
            <div class="stat-sub">stok hareketi →</div>
        </a>
    </div>
}

<!-- Tabs -->
<div class="flex gap-2 border-b border-[var(--border)] mb-6">
    @foreach (var tab in new[]{("general","Genel Bilgiler"),("uom","Birim Dönüşümleri"),("barcodes","Barkodlar")})
    {
        <a href="?tab=@tab.Item1" class="px-4 py-2.5 text-sm font-semibold border-b-2 transition-all -mb-px @(activeTab == tab.Item1 ? "border-[var(--brand-500)] text-[var(--brand-500)] font-bold" : "border-transparent text-[var(--text-3)] hover:text-[var(--text)]")">
            @tab.Item2
        </a>
    }
    @if (!Model.IsNew)
    {
        <a href="?tab=suppliers" class="px-4 py-2.5 text-sm font-semibold border-b-2 transition-all -mb-px @(activeTab == "suppliers" ? "border-[var(--brand-500)] text-[var(--brand-500)] font-bold" : "border-transparent text-[var(--text-3)] hover:text-[var(--text)]")">
            Tedarikçiler
        </a>
    }
</div>

@* TAB: Tedarikçiler (Plan 32) — bir ürünün tedarikçileri: kod/lead-time/MOQ/son-fiyat/tercih *@
@if (activeTab == "suppliers" && !Model.IsNew)
{
    <link rel="stylesheet" href="~/lib/tabulator/tabulator_simple.min.css" />
    <link rel="stylesheet" href="~/lib/tabulator/operax-theme.css" asp-append-version="true" />

    <div class="card p-4 mb-6">
        <div class="flex flex-wrap items-center gap-2 mb-3">
            <button type="button" id="si-add-row" class="btn btn-secondary btn-sm">+ Tedarikçi Ekle</button>
            <button type="button" id="si-save" class="btn btn-primary btn-sm ml-auto">Kaydet</button>
        </div>
        <div class="text-xs text-[var(--text-4)] mb-2">
            Bu ürünü hangi tedarikçilerden, hangi kod/teslim süresi/asgari sipariş ile aldığınız. <strong>Son Fiyat</strong> yalnız bilgilendiricidir (resmi fiyat Fiyat Listesi'nde). <strong>Tercih</strong> tek tedarikçiye verilir.
        </div>
        <div id="si-grid"></div>
    </div>

    @Html.AntiForgeryToken()
    <script>
        window.SI_PARTNERS = @Html.Raw(Model.VendorsJson);
        window.SI_LINES = @Html.Raw(Model.SupplierLinesJson);
        window.SI_CFG = {
            saveUrl: '@Url.Page("Details", "SupplierBulkSave", new { id = Model.Item.Id })',
            token: document.querySelector('input[name="__RequestVerificationToken"]').value
        };
    </script>
    <script src="~/lib/tabulator/tabulator.min.js"></script>
    <script src="~/js/supplieritem-grid.js" asp-append-version="true"></script>
}

<!-- TAB: Genel Bilgiler -->
@if (activeTab == "general")
{
    <form id="item-form" method="post">
        @* Mevcut ürünü düzenlerken Id round-trip etmeli; yoksa POST'ta IsNew=true olur ve INSERT denenir (dup key). *@
        <input type="hidden" asp-for="Item.Id" />
        <div class="grid grid-cols-2 gap-6">
            <!-- Sol Kart: Temel Bilgiler -->
            <div class="card">
                <div class="card-hdr">
                    <span class="card-ttl">Temel Bilgiler</span>
                </div>
                <div class="card-body space-y-4">
                    <div class="form-row">
                        <div>
                            <label class="form-label">Ürün Kodu *</label>
                            <input asp-for="Item.Code" class="form-ctrl" placeholder="örn. SKU-1001" required />
                        </div>
                        <div>
                            <label class="form-label">Baz Birim *</label>
                            <select asp-for="Item.BaseUomId" class="form-ctrl" required>
                                <option value="">Birim seçin...</option>
                                @foreach (var uom in Model.Uoms)
                                {
                                    <option value="@uom.Id">@uom.Name (@uom.Code)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Ürün Adı *</label>
                        <input asp-for="Item.Name" class="form-ctrl" placeholder="Tam ürün adını girin" required />
                    </div>
                    <div class="form-row">
                        <div>
                            <label class="form-label">Kategori</label>
                            <select asp-for="Item.CategoryId" class="form-ctrl">
                                <option value="">Kategori seçin...</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name (@cat.Code)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label">KDV Oranı (%)</label>
                            <select asp-for="Item.TaxRate" class="form-ctrl" required>
                                <option value="">KDV seçin...</option>
                                @foreach (var tax in Model.TaxRates)
                                {
                                    <option value="@tax.Code">@tax.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Kalem Türü</label>
                        <select asp-for="Item.ItemType" class="form-ctrl">
                            @* Plan 52: ürün doğası (satış/sarf/üretim kullanımı evrak belirler — CONSUMABLE kaldırıldı) *@
                            <option value="@Operax.Web.Lib.ItemType.Stock">Stok (fiziksel mal — satılır/üretilir/sarf olur)</option>
                            <option value="@Operax.Web.Lib.ItemType.Service">Hizmet (stoksuz)</option>
                            <option value="@Operax.Web.Lib.ItemType.FixedAsset">Sabit Kıymet (demirbaş)</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Açıklama</label>
                        <input asp-for="Item.Description" class="form-ctrl" placeholder="İsteğe bağlı açıklama" />
                    </div>
                    <div class="divider"></div>
                    <div class="space-y-4">
                        <h3 class="text-xs font-bold text-[var(--brand-500)] uppercase tracking-wider">Emniyet Stoğu & Stok Limitleri</h3>
                        <div class="form-row">
                            <div>
                                <label class="form-label">Minimum Stok (Emniyet)</label>
                                <input asp-for="Item.MinStockLevel" type="number" step="0.01" class="form-ctrl" placeholder="Min limit" />
                            </div>
                            <div>
                                <label class="form-label">Maksimum Stok</label>
                                <input asp-for="Item.MaxStockLevel" type="number" step="0.01" class="form-ctrl" placeholder="Max limit" />
                            </div>
                        </div>
                    </div>
                    @* Dinamik kullanıcı tanımlı alanlar (UDF) — Hacim/Ağırlık/Sıcaklık artık buradan gelir (Plan 34) *@
                    @if (Model.UdfPanel.Definitions.Count > 0)
                    {
                        <div class="divider"></div>
                        <div class="space-y-4">
                            <h3 class="text-xs font-bold text-[var(--brand-500)] uppercase tracking-wider">Özel Alanlar</h3>
                            <partial name="_CustomFields" model="Model.UdfPanel" />
                        </div>
                    }
                </div>
            </div>

            <!-- Sağ Kart: Takip Ayarları -->
            <div class="card">
                <div class="card-hdr">
                    <span class="card-ttl">Takip Ayarları</span>
                </div>
                <div class="card-body space-y-4">
                    <label class="flex items-center justify-between p-4 bg-[var(--success-bg)] rounded-2xl border border-[var(--success-border)] cursor-pointer group transition-colors">
                        <div>
                            <div class="text-sm font-bold text-[var(--success-text)]">Aktif</div>
                            <div class="text-[11px] text-[var(--success)] mt-0.5">Ürün sistemde görünür ve hareket görebilir</div>
                        </div>
                        <input type="checkbox" asp-for="Item.IsActive" class="w-5 h-5 accent-[var(--success)] rounded cursor-pointer">
                    </label>
                    <label class="flex items-center justify-between p-4 bg-[var(--warn-bg)] rounded-2xl border border-[var(--warn-border)] cursor-pointer group transition-colors">
                        <div>
                            <div class="text-sm font-bold text-[var(--warn-text)]">Lot Takibi</div>
                            <div class="text-[11px] text-[var(--warn)] mt-0.5">Her stok hareketi için parti (lot) numarası zorunlu kılınır</div>
                        </div>
                        <input type="checkbox" asp-for="Item.IsLotTracked" class="w-5 h-5 accent-[var(--warn)] rounded cursor-pointer">
                    </label>
                    <label class="flex items-center justify-between p-4 bg-[var(--brand-tint-08)] rounded-2xl border border-[var(--brand-tint-15)] cursor-pointer group transition-colors">
                        <div>
                            <div class="text-sm font-bold text-[var(--brand-600)]">Seri No Takibi</div>
                            <div class="text-[11px] text-[var(--brand-500)] mt-0.5">Her tekil ürün birimi için benzersiz seri numarası takip edilir</div>
                        </div>
                        <input type="checkbox" asp-for="Item.IsSerialTracked" class="w-5 h-5 accent-[var(--brand-500)] rounded cursor-pointer">
                    </label>
                </div>
            </div>
        </div>
    </form>
}

<!-- TAB: Birim Dönüşümleri -->
@if (activeTab == "uom" && !Model.IsNew)
{
    <div class="space-y-6">
        <div class="card overflow-hidden">
            <div class="px-6 py-4 bg-[var(--surface-2)] border-b flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-bold text-[var(--text)]">Birim Dönüşümleri</h3>
                    <p class="text-[11px] text-[var(--text-3)]">Baz birim: <span class="font-bold text-[var(--brand-500)]">@Model.Item.BaseUomCode</span></p>
                </div>
                <button type="button" onclick="document.getElementById('uom-modal').style.display='flex'" class="btn btn-secondary hover:bg-[var(--surface)] py-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    Dönüşüm Ekle
                </button>
            </div>
            <table class="data-table w-full">
                <thead>
                    <tr class="bg-[var(--surface-2)] text-[10px] font-bold uppercase text-[var(--text-4)] tracking-widest border-b">
                        <th class="px-6 py-3 text-left">Birim</th>
                        <th class="px-6 py-3 text-left">Dönüşüm Oranı (Baz birim karşılığı)</th>
                        <th class="px-6 py-3 text-right"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border)]">
                    <tr class="opacity-70">
                        <td class="px-6 py-4">
                            <span class="badge b-indigo">@Model.Item.BaseUomCode</span>
                        </td>
                        <td class="px-6 py-4 font-mono text-xs text-[var(--text-2)]">
                            1.000000 (Baz Birim)
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-xs text-[var(--text-4)] italic">Varsayılan</span>
                        </td>
                    </tr>
                    @foreach (var uom in Model.UomConversions)
                    {
                        <tr class="hover:bg-[var(--surface-2)]/50 transition-colors">
                            <td class="px-6 py-4">
                                <span class="badge b-gray">@uom.UomCode</span>
                                <span class="text-xs text-[var(--text-4)] ml-2">@uom.UomName</span>
                            </td>
                            <td class="px-6 py-4 font-mono text-xs text-[var(--text)] font-bold">
                                @uom.ConversionRate.ToString("N6")
                            </td>
                            <td class="px-6 py-4 text-right">
                                <form method="post" asp-page-handler="DeleteUom" onsubmit="return confirm('Bu birim dönüşümünü silmek istediğinize emin misiniz?')">
                                    <input type="hidden" name="uomConversionId" value="@uom.Id">
                                    <input type="hidden" name="id" value="@Model.Item.Id">
                                    <button type="submit" class="btn btn-sm btn-secondary hover:bg-[var(--danger-bg)] hover:text-[var(--danger-text)] hover:border-[var(--danger)] py-1">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.UomConversions.Any())
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-12 text-center text-[var(--text-4)] italic">
                                Tanımlı alternatif birim dönüşümü bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- UOM Quick Add Form -->
        <div class="card">
            <div class="card-hdr">
                <span class="card-ttl">Hızlı Dönüşüm Ekle</span>
            </div>
            <form method="post" asp-page-handler="AddUom" class="card-body">
                <input type="hidden" name="id" value="@Model.Item.Id">
                <div class="flex gap-4 items-end">
                    <div class="flex-1">
                        <label class="form-label">Birim</label>
                        <select name="uomId" class="form-ctrl">
                            @foreach (var u in Model.Uoms)
                            {
                                <option value="@u.Id">@u.Name (@u.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="flex-1">
                        <label class="form-label">Katsayı (Baz Birim Karşılığı)</label>
                        <input name="rate" type="number" step="0.000001" class="form-ctrl" placeholder="örn. 12 (1 koli = 12 adet)" required />
                    </div>
                    <button type="submit" class="btn btn-primary px-8 py-2.5">Ekle</button>
                </div>
            </form>
        </div>
    </div>
}

<!-- TAB: Barkodlar -->
@if (activeTab == "barcodes" && !Model.IsNew)
{
    <div class="card overflow-hidden">
        <div class="px-6 py-4 bg-[var(--surface-2)] border-b flex items-center justify-between">
            <div>
                <h3 class="text-sm font-bold text-[var(--text)]">Ürün Barkodları</h3>
                <p class="text-[11px] text-[var(--text-3)]">Alternatif paket barkodları</p>
            </div>
            <button type="button" onclick="document.getElementById('barcode-modal').style.display='flex'" class="btn btn-secondary hover:bg-[var(--surface)] py-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                Barkod Ekle
            </button>
        </div>
        <table class="data-table w-full">
            <thead>
                <tr class="bg-[var(--surface-2)] text-[10px] font-bold uppercase text-[var(--text-4)] tracking-widest border-b">
                    <th class="px-6 py-3 text-left">Barkod</th>
                    <th class="px-6 py-3 text-left">Temsil Ettiği Birim</th>
                    <th class="px-6 py-3 text-right"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border)]">
                @foreach (var bc in Model.Barcodes)
                {
                    <tr class="hover:bg-[var(--surface-2)]/50 transition-colors">
                        <td class="px-6 py-4">
                            <span class="font-mono text-sm font-bold tracking-wider text-[var(--text)]">@bc.Barcode</span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="badge b-gray">@bc.UomCode</span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <form method="post" asp-page-handler="DeleteBarcode" onsubmit="return confirm('Bu barkodu silmek istediğinize emin misiniz?')">
                                <input type="hidden" name="barcodeId" value="@bc.Id">
                                <input type="hidden" name="id" value="@Model.Item.Id">
                                <button type="submit" class="btn btn-sm btn-secondary hover:bg-[var(--danger-bg)] hover:text-[var(--danger-text)] hover:border-[var(--danger)] py-1">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Barcodes.Any())
                {
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-[var(--text-4)] italic">
                            Tanımlanmış barkod bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.IsNew && activeTab != "general")
{
    <div class="card p-12 text-center">
        <p class="text-[var(--text-4)] italic">Bu sekmeyi kullanmak için önce ürünü kaydedip genel bilgileri oluşturmalısınız.</p>
    </div>
}

<!-- UOM Modal -->
<div id="uom-modal" class="fixed inset-0 z-50 bg-[var(--overlay)] backdrop-blur-sm flex items-center justify-center p-4" style="display:none">
    <div class="bg-[var(--surface)] rounded-3xl shadow-2xl w-full max-w-md overflow-hidden animate-in fade-in zoom-in duration-200">
        <div class="p-6 bg-[var(--surface-2)] border-b">
            <h3 class="font-black text-[var(--text)] tracking-tight">Birim Dönüşümü Ekle</h3>
            <p class="text-xs text-[var(--text-3)]">Baz birim <span class="font-bold text-[var(--brand-500)]">@Model.Item.BaseUomCode</span> için dönüşüm kuralı tanımlayın</p>
        </div>
        <form method="post" asp-page-handler="AddUom">
            <input type="hidden" name="id" value="@Model.Item.Id">
            <div class="p-6 space-y-4">
                <div>
                    <label class="form-label">Birim Seçin</label>
                    <select name="uomId" class="form-ctrl">
                        @foreach (var u in Model.Uoms)
                        {
                            <option value="@u.Id">@u.Name (@u.Code)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Katsayı (örn. 24 → 1 koli = 24 adet)</label>
                    <input name="rate" type="number" step="0.000001" class="form-ctrl" placeholder="Katsayı değeri girin" required />
                </div>
            </div>
            <div class="p-4 bg-[var(--surface-2)] border-t flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('uom-modal').style.display='none'" class="px-4 py-2 text-sm font-bold text-[var(--text-3)] hover:text-[var(--text)]">İptal</button>
                <button type="submit" class="btn btn-primary px-6">Ekle</button>
            </div>
        </form>
    </div>
</div>

<!-- Barcode Modal -->
<div id="barcode-modal" class="fixed inset-0 z-50 bg-[var(--overlay)] backdrop-blur-sm flex items-center justify-center p-4" style="display:none">
    <div class="bg-[var(--surface)] rounded-3xl shadow-2xl w-full max-w-md overflow-hidden animate-in fade-in zoom-in duration-200">
        <div class="p-6 bg-[var(--surface-2)] border-b">
            <h3 class="font-black text-[var(--text)] tracking-tight">Barkod Ekle</h3>
            <p class="text-xs text-[var(--text-3)]">Yeni bir barkod tanımlayın ve birim eşleştirin</p>
        </div>
        <form method="post" asp-page-handler="AddBarcode">
            <input type="hidden" name="id" value="@Model.Item.Id">
            <div class="p-6 space-y-4">
                <div>
                    <label class="form-label">Barkod Numarası</label>
                    <input name="barcode" type="text" class="form-ctrl" placeholder="örn. 8690000123456" required />
                </div>
                <div>
                    <label class="form-label">Temsil Ettiği Birim</label>
                    <select name="uomId" class="form-ctrl">
                        @foreach (var u in Model.Uoms)
                        {
                            <option value="@u.Id">@u.Name (@u.Code)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="p-4 bg-[var(--surface-2)] border-t flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('barcode-modal').style.display='none'" class="px-4 py-2 text-sm font-bold text-[var(--text-3)] hover:text-[var(--text)]">İptal</button>
                <button type="submit" class="btn btn-primary px-6">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
window.addEventListener('click', e => {
    ['uom-modal','barcode-modal'].forEach(id => {
        const m = document.getElementById(id);
        if (m && e.target === m) m.style.display = 'none';
    });
});
</script>
}
