@page
@model Operax.Web.Features.MasterData.Locations.IndexModel
@{
    ViewData["Title"] = "Depo ve Hücreler";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item">Tanımlamalar</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Lokasyonlar</span>
        </div>
        <h1>Lokasyonlar</h1>
        <p class="page-hdr-sub">Depo ve depolama hücrelerini yönetin</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="/Warehouses/Details" class="btn btn-primary px-6" data-shortcut="Alt+N">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Depo
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    @* Depo seçim listesi (sol kolon) — seçili depo marka rengiyle vurgulanır *@
    <div class="lg:col-span-1 space-y-3">
        @foreach (var wh in Model.Warehouses)
        {
            <a asp-page="./Index" asp-route-whId="@wh.Id"
               class="block p-4 rounded-xl border transition-all @(wh.Id == Model.SelectedWhId ? "bg-[var(--brand-500)] border-[var(--brand-500)] text-white shadow-[var(--shadow-brand)]" : "bg-[var(--surface)] border-[var(--border)] text-[var(--text-2)] hover:border-[var(--brand-300)]")">
                <div class="text-[10px] font-bold uppercase tracking-widest @(wh.Id == Model.SelectedWhId ? "text-[var(--brand-300)]" : "text-[var(--text-4)]")">@wh.Code</div>
                <div class="font-bold">@wh.Name</div>
            </a>
        }
    </div>

    @* Seçili deponun hücreleri (sağ kolon) *@
    <div class="lg:col-span-3">
        <div class="card overflow-hidden">
            <div class="card-hdr">
                <span class="card-title">Hücreler (Depolama Alanları)</span>
                @if (Model.SelectedWhId != null)
                {
                    @* Vanilla toggle (CSP-safe inline onclick) — ekle formunu aç/kapat *@
                    <button type="button" class="btn btn-secondary btn-sm"
                            onclick="document.getElementById('addBinForm').classList.toggle('hidden')">+ Hücre Ekle</button>
                }
            </div>

            @if (Model.SelectedWhId != null)
            {
                @* Yeni hücre ekleme formu (varsayılan gizli) *@
                <form method="post" asp-page-handler="AddBin" id="addBinForm" class="hidden p-4 bg-[var(--surface-2)] border-b border-[var(--border)]">
                    <input type="hidden" name="whId" value="@Model.SelectedWhId" />
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
                        <div class="form-group">
                            <label class="form-label">Hücre Kodu <span class="req">*</span></label>
                            <input name="code" class="form-ctrl font-mono" placeholder="A-01-01" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Bölge</label>
                            <input name="zone" class="form-ctrl" placeholder="A" />
                        </div>
                        <div class="flex items-center gap-4 pb-2">
                            <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" name="isPicking" value="true" class="chk-box" /> Toplama</label>
                            <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" name="isReceiving" value="true" class="chk-box" /> Mal Kabul</label>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Ekle</button>
                    </div>
                </form>
            }

            <table class="data-table w-full">
                <thead>
                    <tr>
                        <th>Hücre Kodu</th>
                        <th>Bölge</th>
                        <th class="text-center">Toplama</th>
                        <th class="text-center">Mal Kabul</th>
                        <th class="text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bin in Model.Bins)
                    {
                        <tr>
                            <td class="font-mono font-bold">@bin.Code</td>
                            <td class="text-[var(--text-3)]">@bin.Zone</td>
                            <td class="text-center">
                                @if (bin.IsPickingArea) { <span class="w-2 h-2 rounded-full bg-[var(--success)] inline-block"></span> }
                                else { <span class="w-2 h-2 rounded-full bg-[var(--border)] inline-block"></span> }
                            </td>
                            <td class="text-center">
                                @if (bin.IsReceivingArea) { <span class="w-2 h-2 rounded-full bg-[var(--info-text)] inline-block"></span> }
                                else { <span class="w-2 h-2 rounded-full bg-[var(--border)] inline-block"></span> }
                            </td>
                            <td class="text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    @* Düzenle: satır-altı inline edit formunu aç/kapat *@
                                    <button type="button" class="btn btn-ghost btn-sm"
                                            onclick="document.getElementById('editBin-@bin.Id').classList.toggle('hidden')">Düzenle</button>
                                    <form method="post" asp-page-handler="DeleteBin" asp-route-whId="@Model.SelectedWhId" asp-route-binId="@bin.Id"
                                          onsubmit="return confirm('@bin.Code hücresini silmek istediğinize emin misiniz?')">
                                        <button type="submit" class="btn btn-ghost btn-sm text-[var(--text-4)] hover:text-[var(--danger)]">Sil</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        @* Inline düzenleme satırı (varsayılan gizli) *@
                        <tr id="editBin-@bin.Id" class="hidden">
                            <td colspan="5" class="bg-[var(--surface-2)] p-4">
                                <form method="post" asp-page-handler="EditBin">
                                    <input type="hidden" name="whId" value="@Model.SelectedWhId" />
                                    <input type="hidden" name="binId" value="@bin.Id" />
                                    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
                                        <div class="form-group">
                                            <label class="form-label">Hücre Kodu <span class="req">*</span></label>
                                            <input name="code" class="form-ctrl font-mono" value="@bin.Code" required />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Bölge</label>
                                            <input name="zone" class="form-ctrl" value="@bin.Zone" />
                                        </div>
                                        <div class="flex items-center gap-4 pb-2">
                                            <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" name="isPicking" value="true" class="chk-box" @(bin.IsPickingArea ? "checked" : "") /> Toplama</label>
                                            <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" name="isReceiving" value="true" class="chk-box" @(bin.IsReceivingArea ? "checked" : "") /> Mal Kabul</label>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-sm">Kaydet</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Bins.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-[var(--text-4)] italic">Depolama hücrelerini görmek için bir depo seçin veya hücre ekleyin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
