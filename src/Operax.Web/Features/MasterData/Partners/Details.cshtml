@page "{id:guid?}"
@using Operax.Web.Lib
@model Operax.Web.Features.MasterData.Partners.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Cari Kart" : Model.Partner.Name;

    var header = new PageHeaderVm(
        Title: Model.IsNew ? "Yeni Cari Kart" : Model.Partner.Name,
        Crumbs: new[] { "Anasayfa", "Master Veri", "Cari Kartlar", Model.IsNew ? "Yeni" : Model.Partner.Code },
        Sub: Model.IsNew ? "Yeni tedarikçi / müşteri / her ikisi" : $"{Model.Partner.Code} · {(Model.Partner.IsActive ? "Aktif" : "Pasif")}",
        ActionsHtml: $"<a href=\"/MasterData/Partners\" class=\"btn btn-ghost btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Cari Kart Detayı">
    <partial name="_PageHeader" model="header" />
    @* TempData banner _Layout'ta global render ediliyor — sayfa-içi tekrar yok *@

    @* Tab bar — yalnızca mevcut kayıtta; yeni kayıtta tek form *@
    @if (!Model.IsNew)
    {
        var pid = Model.Partner.Id;
        <div class="tabs" style="margin-bottom:14px;">
            <a class="tab @(Model.Tab == "genel" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=genel">Genel</a>
            <a class="tab @(Model.Tab == "ekstre" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=ekstre">Ekstre / Hareketler</a>
            <a class="tab @(Model.Tab == "siparisler" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=siparisler">Siparişler</a>
            <a class="tab @(Model.Tab == "faturalar" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=faturalar">Faturalar</a>
            <a class="tab @(Model.Tab == "cekssenet" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=cekssenet">Çek / Senet</a>
            <a class="tab @(Model.Tab == "mutabakat" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=mutabakat">Mutabakat</a>
            <a class="tab @(Model.Tab == "fiyatlar" ? "active" : "")" href="/MasterData/Partners/Details/@pid?tab=fiyatlar">Fiyatlar</a>
        </div>
    }

    @* ── Genel tabı (düzenleme formu) ── *@
    @if (Model.Tab == "genel" || Model.IsNew)
    {
    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Partner.Id" type="hidden" />

        <fieldset disabled="@(Model.IsEditable ? null : "disabled")" style="border:0;padding:0;margin:0;min-inline-size:0;">
        <div style="display:grid;grid-template-columns:1fr 340px;gap:14px;">

            @* Sol — ana bilgiler *@
            <div style="display:flex;flex-direction:column;gap:14px;">

                @* Kimlik & İletişim *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Kimlik &amp; İletişim</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Cari Kodu</label>
                                <input asp-for="Partner.Code" class="form-ctrl" readonly placeholder="(otomatik atanır)" />
                                <span class="form-hint">Otomatik atanır, değiştirilemez</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Cari Tipi <span class="req">*</span></label>
                                <select asp-for="Partner.Type" class="form-ctrl" required>
                                    <option value="VENDOR">Tedarikçi</option>
                                    <option value="CUSTOMER">Müşteri</option>
                                    <option value="BOTH">Her İkisi</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="form-label">Cari Ünvanı <span class="req">*</span></label>
                                <input asp-for="Partner.Name" class="form-ctrl" placeholder="Tam ticaret ünvanı" required />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Vergi No</label>
                                <input asp-for="Partner.TaxNumber" class="form-ctrl" placeholder="10 haneli VKN / TCKN" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">E-posta</label>
                                <input asp-for="Partner.Email" type="email" class="form-ctrl" placeholder="fatura@firma.com" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Telefon</label>
                                <input asp-for="Partner.Phone" class="form-ctrl" placeholder="+90 (5xx) xxx xx xx" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Adres</label>
                                <input asp-for="Partner.Address" class="form-ctrl" placeholder="İlçe / İl" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="form-label">Notlar</label>
                                <textarea asp-for="Partner.Notes" class="form-ctrl" rows="2" placeholder="İç notlar..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                @* Dinamik kullanıcı tanımlı alanlar (UDF) — Plan 34 Faz 2 *@
                @if (Model.UdfPanel.Definitions.Count > 0)
                {
                    <div class="card">
                        <div class="card-hdr">
                            <div class="card-title">Özel Alanlar</div>
                        </div>
                        <div class="card-body">
                            <partial name="_CustomFields" model="Model.UdfPanel" />
                        </div>
                    </div>
                }

                @* Mali Ayarlar *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Mali Ayarlar</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Vade Politikası</label>
                                <select asp-for="Partner.PaymentTermPolicy" class="form-ctrl">
                                    <option value="NET">Fatura tarihi + X gün</option>
                                    <option value="NET_EOM">Ay sonu + X gün</option>
                                    <option value="INSTALLMENTS">Taksitli</option>
                                </select>
                                <span class="form-hint">Vade başlangıcı: fatura tarihi mi, ay sonu mu</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Vade (Gün)</label>
                                <input asp-for="Partner.PaymentTermDays" type="number" min="0" class="form-ctrl" />
                                <span class="form-hint">Örn. Ay sonu + 30 gün</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Kredi Limiti (₺)</label>
                                <input asp-for="Partner.CreditLimit" type="number" min="0" step="0.01" class="form-ctrl" />
                            </div>
                            <div class="form-group"></div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Varsayılan Ödeme Yöntemi</label>
                                <select asp-for="Partner.DefaultPaymentMethod" class="form-ctrl">
                                    <option value="EFT">EFT / Havale</option>
                                    <option value="CHEQUE">Çek</option>
                                    <option value="CASH">Nakit</option>
                                    <option value="CARD">Kredi Kartı</option>
                                    <option value="PROMISSORY">Senet</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Maks. Gecikme (Gün)</label>
                                <input asp-for="Partner.MaxOverdueDays" type="number" min="0" class="form-ctrl" />
                                <span class="form-hint">Bu günden fazla gecikirse otomatik BLOCKED</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="chk-row">
                                    <span class="chk"><input asp-for="Partner.BlockOnLimitExceed" type="checkbox" /><span class="chk-box"></span></span>
                                    <span>Limit aşımında sipariş/sevkiyat bloke edilsin</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                @* Sorumlu Temsilci *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Sorumlu Temsilci</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Satış Temsilcisi</label>
                                <select asp-for="Partner.SalesRepUserId" class="form-ctrl">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var u in Model.Users)
                                    {
                                        <option value="@u.Id">@u.UserName</option>
                                    }
                                </select>
                                <span class="form-hint">Müşteri carisinin sorumlusu</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Satınalma Sorumlusu</label>
                                <select asp-for="Partner.PurchaseRepUserId" class="form-ctrl">
                                    <option value="">Seçiniz...</option>
                                    @foreach (var u in Model.Users)
                                    {
                                        <option value="@u.Id">@u.UserName</option>
                                    }
                                </select>
                                <span class="form-hint">Tedarikçi carisinin sorumlusu</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* e-Belge *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">e-Belge</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="chk-row">
                                    <span class="chk"><input asp-for="Partner.EFaturaMukellef" type="checkbox" /><span class="chk-box"></span></span>
                                    <span>e-Fatura mükellefi (GİB kayıtlı)</span>
                                </label>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">e-Fatura Alias / Posta Kutusu</label>
                                <input asp-for="Partner.EFaturaAlias" class="form-ctrl" placeholder="defaultpk@firma.com" />
                                <span class="form-hint">GİB'e kayıtlı iletişim adresi</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">İade IBAN</label>
                                <input asp-for="Partner.IbanForRefund" class="form-ctrl" placeholder="TR00 0000 0000 0000 0000 0000 00" />
                                <span class="form-hint">İade / havale için banka hesabı</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Sağ — durum ve risk *@
            <div style="display:flex;flex-direction:column;gap:14px;">
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Durum &amp; Risk</div>
                    </div>
                    <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">

                        <label class="chk-row">
                            <span class="chk"><input asp-for="Partner.IsActive" type="checkbox" /><span class="chk-box"></span></span>
                            <span>Aktif Cari</span>
                        </label>

                        <div class="form-group">
                            <label class="form-label">Risk Skoru (1–5)</label>
                            <input asp-for="Partner.RiskScore" type="number" min="1" max="5" class="form-ctrl" />
                            <span class="form-hint">1 = en düşük risk, 5 = en yüksek</span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Risk Kategorisi</label>
                            <select asp-for="Partner.RiskCategory" class="form-ctrl">
                                <option value="LOW">Düşük (LOW)</option>
                                <option value="MEDIUM">Orta (MEDIUM)</option>
                                <option value="HIGH">Yüksek (HIGH)</option>
                                <option value="BLOCKED">Bloke (BLOCKED)</option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        </fieldset>

        @* Aksiyon çubuğu — görüntüleme: Düzenle · düzenleme: Kaydet/İptal (fieldset dışında) *@
        <div class="row" style="gap:10px;margin-top:14px;">
            @if (Model.IsEditable)
            {
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="@(Model.IsNew ? "/MasterData/Partners" : $"/MasterData/Partners/Details/{Model.Partner.Id}?tab=genel")" class="btn btn-ghost">İptal</a>
            }
            else
            {
                <a href="/MasterData/Partners/Details/@Model.Partner.Id?tab=genel&edit=true" class="btn btn-primary">Düzenle</a>
                <a href="/MasterData/Partners" class="btn btn-ghost">Geri</a>
            }
        </div>
    </form>
    }

    @* ── Ekstre / Hareketler tabı ── *@
    @if (Model.Tab == "ekstre" && !Model.IsNew)
    {
        <partial name="Tabs/_Ekstre" model="Model" />
    }

    @* ── Siparişler tabı ── *@
    @if (Model.Tab == "siparisler" && !Model.IsNew)
    {
        <partial name="Tabs/_Siparisler" model="Model" />
    }

    @* ── Faturalar tabı ── *@
    @if (Model.Tab == "faturalar" && !Model.IsNew)
    {
        <partial name="Tabs/_Faturalar" model="Model" />
    }

    @* ── Çek / Senet tabı ── *@
    @if (Model.Tab == "cekssenet" && !Model.IsNew)
    {
        <partial name="Tabs/_CekSenet" model="Model" />
    }

    @* ── Mutabakat tabı ── *@
    @if (Model.Tab == "mutabakat" && !Model.IsNew)
    {
        <partial name="Tabs/_Mutabakat" model="Model" />
    }

    @* ── Fiyatlar tabı ── *@
    @if (Model.Tab == "fiyatlar" && !Model.IsNew)
    {
        <partial name="Tabs/_Fiyatlar" model="Model" />
    }
</div>
