@page "{id:guid?}"
@using Operax.Web.Lib
@model Operax.Web.Features.MasterData.Partners.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Cari Kart" : Model.Partner.Name;

    var header = new PageHeaderVm(
        Title: Model.IsNew ? "Yeni Cari Kart" : Model.Partner.Name,
        Crumbs: new[] { "Anasayfa", "Master Veri", "Cari Kartlar", Model.IsNew ? "Yeni" : Model.Partner.Code },
        Sub: Model.IsNew ? "Yeni tedarikçi / müşteri / her ikisi" : $"{Model.Partner.Code} · {(Model.Partner.IsActive ? "Aktif" : "Pasif")}",
        ActionsHtml: $"<a href=\"/MasterData/Partners\" class=\"btn btn-ghost btn-sm\">Geri</a>"
    );
}

<div class="page" data-screen-label="Partner Details">
    <partial name="_PageHeader" model="header" />

    @if (TempData["Error"] is string err)
    {
        <div class="alert-banner alert-danger">@err</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <div style="display:grid;grid-template-columns:1fr 340px;gap:14px;">

            @* Sol — ana bilgiler *@
            <div style="display:flex;flex-direction:column;gap:14px;">

                @* Kimlik & İletişim *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Kimlik &amp; İletişim</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Cari Kodu <span class="req">*</span></label>
                                <input asp-for="Partner.Code" class="form-ctrl" placeholder="Örn: C-001" required />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Cari Tipi <span class="req">*</span></label>
                                <select asp-for="Partner.Type" class="form-ctrl" required>
                                    <option value="VENDOR">Tedarikçi</option>
                                    <option value="CUSTOMER">Müşteri</option>
                                    <option value="BOTH">Her İkisi</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="form-label">Cari Ünvanı <span class="req">*</span></label>
                                <input asp-for="Partner.Name" class="form-ctrl" placeholder="Tam ticaret ünvanı" required />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Vergi No</label>
                                <input asp-for="Partner.TaxNumber" class="form-ctrl" placeholder="10 haneli VKN / TCKN" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">E-posta</label>
                                <input asp-for="Partner.Email" type="email" class="form-ctrl" placeholder="fatura@firma.com" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Telefon</label>
                                <input asp-for="Partner.Phone" class="form-ctrl" placeholder="+90 (5xx) xxx xx xx" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Adres</label>
                                <input asp-for="Partner.Address" class="form-ctrl" placeholder="İlçe / İl" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="form-label">Notlar</label>
                                <textarea asp-for="Partner.Notes" class="form-ctrl" rows="2" placeholder="İç notlar..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                @* Mali Ayarlar *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Mali Ayarlar</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Vade (Gün)</label>
                                <input asp-for="Partner.PaymentTermDays" type="number" min="0" class="form-ctrl" />
                                <span class="form-hint">Fatura / sipariş varsayılan vade günü</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Kredi Limiti (₺)</label>
                                <input asp-for="Partner.CreditLimit" type="number" min="0" step="0.01" class="form-ctrl" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Varsayılan Ödeme Yöntemi</label>
                                <select asp-for="Partner.DefaultPaymentMethod" class="form-ctrl">
                                    <option value="EFT">EFT / Havale</option>
                                    <option value="CHEQUE">Çek</option>
                                    <option value="CASH">Nakit</option>
                                    <option value="CARD">Kredi Kartı</option>
                                    <option value="PROMISSORY">Senet</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Maks. Gecikme (Gün)</label>
                                <input asp-for="Partner.MaxOverdueDays" type="number" min="0" class="form-ctrl" />
                                <span class="form-hint">Bu günden fazla gecikirse otomatik BLOCKED</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="chk">
                                    <input asp-for="Partner.BlockOnLimitExceed" type="checkbox" />
                                    <span>Limit aşımında sipariş/sevkiyat bloke edilsin</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                @* e-Belge *@
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">e-Belge</div>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group" style="grid-column:1/-1;">
                                <label class="chk">
                                    <input asp-for="Partner.EFaturaMukellef" type="checkbox" />
                                    <span>e-Fatura mükellefi (GİB kayıtlı)</span>
                                </label>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">e-Fatura Alias / Posta Kutusu</label>
                                <input asp-for="Partner.EFaturaAlias" class="form-ctrl" placeholder="defaultpk@firma.com" />
                                <span class="form-hint">GİB'e kayıtlı iletişim adresi</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label">İade IBAN</label>
                                <input asp-for="Partner.IbanForRefund" class="form-ctrl" placeholder="TR00 0000 0000 0000 0000 0000 00" />
                                <span class="form-hint">İade / havale için banka hesabı</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Sağ — durum ve risk *@
            <div style="display:flex;flex-direction:column;gap:14px;">
                <div class="card">
                    <div class="card-hdr">
                        <div class="card-title">Durum &amp; Risk</div>
                    </div>
                    <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">

                        <label class="chk">
                            <input asp-for="Partner.IsActive" type="checkbox" />
                            <span>Aktif Cari</span>
                        </label>

                        <div class="form-group">
                            <label class="form-label">Risk Skoru (1–5)</label>
                            <input asp-for="Partner.RiskScore" type="number" min="1" max="5" class="form-ctrl" />
                            <span class="form-hint">1 = en düşük risk, 5 = en yüksek</span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Risk Kategorisi</label>
                            <select asp-for="Partner.RiskCategory" class="form-ctrl">
                                <option value="LOW">Düşük (LOW)</option>
                                <option value="MEDIUM">Orta (MEDIUM)</option>
                                <option value="HIGH">Yüksek (HIGH)</option>
                                <option value="BLOCKED">Bloke (BLOCKED)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body" style="display:flex;flex-direction:column;gap:10px;">
                        <button type="submit" class="btn btn-primary" style="width:100%;">Kaydet</button>
                        <a href="/MasterData/Partners" class="btn btn-ghost" style="width:100%;text-align:center;">İptal</a>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @* Cari hareketler + bakiye — sadece mevcut kayıtta gösterilir *@
    @if (!Model.IsNew && Model.Balance != null)
    {
        var b = Model.Balance;

        @* Bakiye özet kartları *@
        var openOrder = b.OpenSalesOrder + b.OpenPurchaseOrder;
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:14px;">
            <div class="kpi">
                <div class="kpi-label">Toplam Alacak</div>
                <div class="kpi-value" style="font-size:20px;color:var(--success-text);">@UiHelpers.FmtTL(b.TotalReceivable)</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Toplam Borç</div>
                <div class="kpi-value" style="font-size:20px;color:var(--danger-text);">@UiHelpers.FmtTL(b.TotalPayable)</div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Net Bakiye</div>
                <div class="kpi-value" style="font-size:20px;color:@(b.NetBalance >= 0 ? "var(--success-text)" : "var(--danger-text)");">
                    @UiHelpers.FmtTL(b.NetBalance)
                </div>
            </div>
            <div class="kpi">
                <div class="kpi-label">Açık Sipariş</div>
                <div class="kpi-value" style="font-size:20px;color:var(--info-text);">@UiHelpers.FmtTL(openOrder)</div>
            </div>
        </div>

        @* Vade davranış analizi *@
        @if (Model.VadeAnalysis != null)
        {
            var v = Model.VadeAnalysis;
            <div class="card" style="margin-top:14px;">
                <div class="card-hdr">
                    <div class="card-title">Ödeme Davranışı Analizi</div>
                    <div class="card-sub">Tamamlanan @v.PaidCount ödeme</div>
                </div>
                <div class="card-body" style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;">
                    <div>
                        <div class="form-label">Ort. Gecikme (Gün)</div>
                        <div class="row-strong mono" style="margin-top:4px;color:@(v.AvgDelayDays > 5 ? "var(--danger-text)" : "var(--success-text)");">
                            @(v.AvgDelayDays.HasValue ? $"{v.AvgDelayDays.Value:0.#} gün" : "—")
                        </div>
                    </div>
                    <div>
                        <div class="form-label">Ort. Fatura Tutarı</div>
                        <div class="row-strong mono" style="margin-top:4px;">@UiHelpers.FmtTL(v.AvgInvoiceAmount ?? 0)</div>
                    </div>
                    <div>
                        <div class="form-label">Toplam Tahakkuk</div>
                        <div class="row-strong mono" style="margin-top:4px;">@UiHelpers.FmtTL(v.TotalPaidAmount)</div>
                    </div>
                    <div>
                        <div class="form-label">Son Ödeme / Tahsilat</div>
                        <div class="row-strong mono" style="margin-top:4px;">
                            @(v.LastPayment.HasValue ? UiHelpers.FmtDateShort(v.LastPayment.Value) : "—")
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Son 30 hareket *@
        <div class="card" style="margin-top:14px;">
            <div class="card-hdr">
                <div class="card-title">Cari Hareketler (Son 30)</div>
                <div class="card-sub">@Model.Transactions.Count hareket</div>
            </div>

            @if (Model.Transactions.Count == 0)
            {
                var empty = new EmptyStateVm("Hareket yok", "Bu cari için finansal hareket kaydı bulunamadı.");
                <partial name="_EmptyState" model="empty" />
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Tip</th>
                            <th>Araç</th>
                            <th>Hesap</th>
                            <th>Açıklama</th>
                            <th>Kaynak Belge</th>
                            <th class="num">Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            var isIn  = t.TransactionType is "INCOME" or "TRANSFER_IN";
                            var sign  = isIn ? "+" : "−";
                            var color = isIn ? "var(--success-text)" : "var(--danger-text)";
                            <tr>
                                <td class="mono muted">@UiHelpers.FmtDateShort(t.TransactionDate)</td>
                                <td>
                                    @if (isIn)
                                    {
                                        <span class="badge badge-success"><span class="badge-dot"></span>GELİR</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><span class="badge-dot"></span>GİDER</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.InstrumentType))
                                    {
                                        <span class="badge badge-neutral">@t.InstrumentType</span>
                                    }
                                </td>
                                <td class="muted">@(t.AccountName ?? "—")</td>
                                <td>@(t.Description ?? "")</td>
                                <td class="mono muted">@(t.SourceDocNo ?? "—")</td>
                                <td class="num">
                                    <span class="row-strong" style="color:@color;">@sign @UiHelpers.FmtTL(t.Amount)</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>
