@page "{id:guid}"
@model Operax.Web.Features.MasterData.PriceLists.ImportModel
@{
    ViewData["Title"] = "Excel İçe Aktar";
    var prev = Model.Preview;
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item">Tanımlamalar</span>
            <span class="breadcrumb-sep">/</span>
            <a asp-page="./Index" class="breadcrumb-item hover:text-[var(--brand-500)]">Fiyat Listeleri</a>
            <span class="breadcrumb-sep">/</span>
            <a asp-page="./Details" asp-route-id="@Model.ListId" class="breadcrumb-item hover:text-[var(--brand-500)]">@Model.ListName</a>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">İçe Aktar</span>
        </div>
        <h1>Excel / CSV İçe Aktar</h1>
        <p class="page-hdr-sub">@Model.ListName — toplu fiyat satırı aktarımı</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" asp-route-id="@Model.ListId" class="btn btn-secondary">Geri</a>
    </div>
</div>

<div class="card p-6 mb-6">
    <form method="post" asp-page-handler="Preview" asp-route-id="@Model.ListId" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Excel'den kopyalayıp yapıştırın</label>
            <textarea name="pasteData" class="form-ctrl font-mono text-sm" rows="8"
                      placeholder="ÜrünKodu&#9;Fiyat&#9;MinMiktar&#9;İskonto&#10;PRD-002&#9;100&#9;0&#9;10+5+3&#10;PRD-003&#9;250"></textarea>
            <span class="form-hint">Sütun sırası: <strong>Ürün Kodu · Fiyat · Min Miktar (ops.) · İskonto Zinciri (ops., "10+5+3")</strong>. Ayraç sekme, noktalı virgül veya virgül olabilir. Başlık satırı otomatik atlanır.</span>
        </div>
        <div class="flex items-center gap-3 mb-4">
            <span class="text-xs text-[var(--text-4)]">veya</span>
            <input type="file" name="file" accept=".csv,.txt" class="form-ctrl max-w-80" />
        </div>
        <button type="submit" class="btn btn-primary px-8">Önizle</button>
    </form>
</div>

@if (prev is not null)
{
    <div class="card p-6">
        <h2 class="font-bold text-[var(--text-2)] mb-3">Önizleme</h2>
        <div class="flex gap-4 mb-4">
            <div class="kpi-mini"><span class="text-2xl font-bold text-[var(--text)]">@prev.Toplam</span><div class="text-xs text-[var(--text-4)]">Toplam</div></div>
            <div class="kpi-mini"><span class="text-2xl font-bold text-[var(--success)]">@prev.Gecerli</span><div class="text-xs text-[var(--text-4)]">Geçerli</div></div>
            <div class="kpi-mini"><span class="text-2xl font-bold text-[var(--danger)]">@prev.Hatali</span><div class="text-xs text-[var(--text-4)]">Hatalı</div></div>
            @if (Model.SkippedCount > 0)
            {
                <div class="kpi-mini"><span class="text-2xl font-bold text-[var(--warn)]">@Model.SkippedCount</span><div class="text-xs text-[var(--text-4)]">Atlandı (format)</div></div>
            }
        </div>
        @if (Model.SkippedCount > 0)
        {
            <div class="alert-banner alert-info mb-3">@Model.SkippedCount satır ayrıştırılamadı (eksik kolon, boş kod veya geçersiz fiyat) ve atlandı.</div>
        }

        @if (prev.Hatalar.Any())
        {
            <div class="alert-banner alert-danger mb-3">
                Hatalı satırlar düzeltilmeden içe aktarım yapılamaz:
            </div>
            <table class="data-table w-full mb-4">
                <thead>
                    <tr class="bg-[var(--surface-2)] text-[10px] font-bold uppercase text-[var(--text-4)] tracking-widest border-b">
                        <th class="px-4 py-2 text-left">Satır</th>
                        <th class="px-4 py-2 text-left">Ürün Kodu</th>
                        <th class="px-4 py-2 text-left">Hata</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border)]">
                    @foreach (var e in prev.Hatalar)
                    {
                        <tr>
                            <td class="px-4 py-2 text-[var(--text-3)]">@e.RowNo</td>
                            <td class="px-4 py-2 font-mono text-xs text-[var(--text-2)]">@e.ItemCode</td>
                            <td class="px-4 py-2 text-[var(--danger)]">@e.Hata</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (prev.Hatali == 0 && prev.Gecerli > 0)
        {
            <form method="post" asp-page-handler="Confirm" asp-route-id="@Model.ListId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rowsJson" value="@Model.ParsedJson" />
                <button type="submit" class="btn btn-primary px-8">@prev.Gecerli satırı içe aktar</button>
            </form>
        }
    </div>
}
