@page
@model Operax.Web.Features.MasterData.PriceLists.IndexModel
@{
    ViewData["Title"] = "Fiyat Listeleri";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item hover:text-indigo-600">Tanımlamalar</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Fiyat Listeleri</span>
        </div>
        <h1>Fiyat Listeleri</h1>
        <p class="page-hdr-sub">Satış ve alış fiyat listeleri, cari/şube bazlı öncelik ve zincir iskonto</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" class="btn btn-primary px-6" data-shortcut="Alt+N">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Fiyat Listesi
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-glow brand"></div>
        <div class="kpi-label">Satış Listeleri</div>
        <div class="kpi-value">@Model.SalesCount</div>
        <div class="kpi-foot"><span class="kpi-trend">Müşteriye uygulanan fiyatlar</span></div>
    </div>
    <div class="kpi">
        <div class="kpi-glow warn"></div>
        <div class="kpi-label">Alış Listeleri</div>
        <div class="kpi-value">@Model.PurchaseCount</div>
        <div class="kpi-foot"><span class="kpi-trend">Tedarikçi beklenen fiyatlar</span></div>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert-banner alert-info">@ok</div>
}

<form method="get" class="flex items-center gap-3 mb-6 bg-white p-3 rounded-xl border border-slate-200 shadow-sm">
    <div class="relative flex-1 max-w-[320px]">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="q" value="@Model.Q" placeholder="Liste kodu veya adı ile ara..." class="form-ctrl pl-9 w-full bg-slate-50 border-slate-200">
    </div>
    <select name="directionFilter" class="form-ctrl w-44 bg-slate-50 border-slate-200 text-sm text-slate-700" onchange="this.form.submit()">
        <option value="">Tüm Yönler</option>
        <option value="@PriceDirection.Sales" selected="@(Model.DirectionFilter == PriceDirection.Sales)">Satış</option>
        <option value="@PriceDirection.Purchase" selected="@(Model.DirectionFilter == PriceDirection.Purchase)">Alış</option>
    </select>
    <select name="statusFilter" class="form-ctrl w-40 bg-slate-50 border-slate-200 text-sm text-slate-700" onchange="this.form.submit()">
        <option value="">Tüm Durumlar</option>
        <option value="active" selected="@(Model.StatusFilter == "active")">Aktif</option>
        <option value="passive" selected="@(Model.StatusFilter == "passive")">Pasif</option>
    </select>
    <div class="ml-auto text-xs font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-full border border-slate-200">@Model.Rows.Count() kayıt</div>
</form>

<div class="card overflow-hidden">
    <table class="data-table w-full">
        <thead>
            <tr class="bg-slate-50 text-[10px] font-bold uppercase text-slate-400 tracking-widest border-b">
                <th class="px-6 py-4 text-left">Kod / Ad</th>
                <th class="px-6 py-4 text-center">Yön</th>
                <th class="px-6 py-4 text-left">Cari</th>
                <th class="px-6 py-4 text-left">Şube</th>
                <th class="px-6 py-4 text-center">Öncelik</th>
                <th class="px-6 py-4 text-center">Geçerlilik</th>
                <th class="px-6 py-4 text-center">Satır</th>
                <th class="px-6 py-4 text-center">Durum</th>
                <th class="px-6 py-4 text-right">İşlem</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var r in Model.Rows)
            {
                <tr class="cursor-pointer hover:bg-slate-50/50 transition-colors" onclick="window.location='@Url.Page("./Details", new { id = r.Id })'">
                    <td class="px-6 py-4">
                        <div class="font-mono text-xs text-indigo-600 font-bold mb-0.5">@r.Code</div>
                        <div class="font-bold text-slate-800 text-sm">@r.Name</div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        @if (r.Direction == PriceDirection.Sales)
                        {
                            <span class="badge b-green">Satış</span>
                        }
                        else
                        {
                            <span class="badge b-amber">Alış</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        <span class="text-sm font-semibold text-slate-600">@(r.PartnerName ?? "Genel (tüm cariler)")</span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="text-sm font-semibold text-slate-600">@(r.BranchName ?? "Tüm Şubeler")</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="font-mono text-xs font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded">@r.Priority</span>
                    </td>
                    <td class="px-6 py-4 text-center text-xs text-slate-500">
                        @if (r.ValidFrom is null && r.ValidTo is null)
                        {
                            <span>Süresiz</span>
                        }
                        else
                        {
                            <span>@(r.ValidFrom is null ? "…" : UiHelpers.FmtDateShort(r.ValidFrom.Value)) – @(r.ValidTo is null ? "…" : UiHelpers.FmtDateShort(r.ValidTo.Value))</span>
                        }
                    </td>
                    <td class="px-6 py-4 text-center">
                        <span class="badge b-indigo">@r.LineCount</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                        @if (r.IsActive)
                        {
                            <span class="badge b-green">AKTİF</span>
                        }
                        else
                        {
                            <span class="badge b-gray">PASİF</span>
                        }
                    </td>
                    <td class="px-6 py-4 text-right" onclick="event.stopPropagation()">
                        <a asp-page="./Details" asp-route-id="@r.Id" class="btn btn-secondary btn-sm">Düzenle</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="inline" onsubmit="return confirm('Bu fiyat listesi silinsin mi?');">
                            <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr>
                    <td colspan="9" class="px-6 py-20 text-center">
                        <div class="flex flex-col items-center">
                            <svg class="w-12 h-12 text-slate-200 mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            <p class="text-slate-400 font-medium italic">Henüz fiyat listesi tanımlanmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
