@page "{id:guid?}"
@using Operax.Web.Lib
@model Operax.Web.Features.MaterialIssue.DetailsModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Sarf Fişi" : $"Sarf Fişi — {Model.Header.DocNo}";
}

@if (!Model.IsNew && Model.Header.Status == DocStatus.Posted)
{
    <form id="reverse-form" method="post" asp-page-handler="Reverse" asp-route-id="@Model.Header.Id">
        @Html.AntiForgeryToken()
    </form>
}

<div class="page" data-screen-label="Sarf Fişi Detayı">
    <div class="page-hdr">
        <div class="page-hdr-l">
            <div class="breadcrumb">
                <a asp-page="./Index" class="breadcrumb-item">Sarf Fişleri</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-current">@(Model.IsNew ? "Yeni" : Model.Header.DocNo)</span>
            </div>
            <h1>@(Model.IsNew ? "Yeni Sarf Fişi" : Model.Header.DocNo)</h1>
        </div>
        <div class="page-hdr-r flex gap-2">
            <a asp-page="./Index" class="btn btn-secondary btn-sm">Geri</a>
            @if (!Model.IsNew && Model.IsDraft)
            {
                <form method="post" asp-page-handler="Post" asp-route-id="@Model.Header.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success" onclick="return confirm('Sarf fişini onaylamak ve stoğu düşmek istiyor musunuz?')">Onayla (Stoğa İşle)</button>
                </form>
            }
            @if (!Model.IsNew && Model.Header.Status == DocStatus.Posted)
            {
                <button form="reverse-form" type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Sarf fişini iptal edip stoğu geri almak istediğinize emin misiniz?')">İptal Et</button>
            }
        </div>
    </div>

    @if (TempData["Success"] is string ok)  { <div class="alert-banner alert-info mb-4">@ok</div> }
    @if (TempData["Error"]   is string err) { <div class="alert-banner alert-danger mb-4">@err</div> }

    @if (!Model.IsNew)
    {
        <div class="row" style="gap:8px;margin-bottom:14px;">@Html.Raw(Dict.StatusBadge(Model.Header.Status))</div>
    }

    <div class="card p-6 mb-6">
        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Header.Id" />
            <div class="form-row-3">
                <div class="form-group">
                    <label class="form-label">Depo <span class="req">*</span></label>
                    <select asp-for="Header.WarehouseId" class="form-ctrl" disabled="@(!Model.IsDraft)" required>
                        <option value="">Seçiniz...</option>
                        @foreach (var w in Model.Warehouses) { <option value="@w.Id">@w.Code - @w.Name</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Tarih</label>
                    <input asp-for="Header.IssueDate" type="date" class="form-ctrl" readonly="@(!Model.IsDraft)" />
                </div>
                <div class="form-group">
                    <label class="form-label">Masraf Merkezi</label>
                    <select asp-for="Header.CostCenterId" class="form-ctrl" disabled="@(!Model.IsDraft)">
                        <option value="">— Yok —</option>
                        @foreach (var c in Model.CostCenters) { <option value="@c.Id">@c.Code - @c.Name</option> }
                    </select>
                </div>
            </div>
            @*
              Zayiat alanları seçilen nedene göre vanilla JS ile gösterilir/gizlenir.
              NEDEN Alpine DEĞİL: site CSP'si script-src'de 'unsafe-eval' içermiyor; Alpine 3 standard build
              x-data/x-show ifadelerini eval ile değerlendirdiğinden CSP altında çalışmaz. CSP'yi gevşetmek
              yerine (güvenlik) CSP-uyumlu vanilla JS kullanılır (razor-conventions vanilla fallback).
              KDV-davranış haritası (data-kdv) sözlük flag'inden render edilir — hardcoded değil.
            *@
            <div id="reason-block">
                <div class="form-group">
                    <label class="form-label">Sarf Nedeni</label>
                    <select asp-for="Header.ReasonCode" id="reason-select" class="form-ctrl" disabled="@(!Model.IsDraft)">
                        <option value="">Normal Tüketim (genel/idari sarf)</option>
                        @foreach (var r in Model.Reasons)
                        {
                            <option value="@r.Code" data-kdv="@(r.RequiresKdv ? "1" : "0")">Zayiat — @r.Name</option>
                        }
                    </select>
                    <span class="form-hint">Zayiat → stok hareketi SCRAP. Olağanüstü zayiatta indirilen KDV düzeltilir (md.30/c); normal fire KDV-nötr.</span>
                </div>
                @* KDV mevzuat açıklaması — seçilen nedenin KDV-davranışına göre (md.30/c). Bilgilendirme amaçlı.
                   İçerik tek flowing div'e sarılır ki alert-banner (flex) prose'u tek blok gibi aksın (yan-yana wrap olmasın). *@
                <div id="reason-mevzuat" class="alert-banner alert-info mb-2 hidden">
                    <div>
                        <strong>KDV Mevzuatı (md.30/c):</strong>
                        <span data-kdv-yes>Olağanüstü zayiat — bu mala ait <strong>indirilen KDV indirilemez</strong>; daha önce indirildiyse düzeltilir (ilave edilecek KDV). Belgeleme: takdir komisyonu kararı veya itfaiye/sigorta raporu. İstisna: Maliye'nin <strong>mücbir sebep</strong> ilan ettiği afet (deprem/sel/yangın) → KDV korunur.</span>
                        <span data-kdv-no>Normal fire (üretim/işletme firesi) <strong>zayiat sayılmaz</strong> — KDV md.30/c kapsamı dışındadır, indirilen KDV düzeltilmez (KDV nötr).</span>
                    </div>
                </div>
                @* Mücbir-sebep onay kutusu — checkbox + uzun açıklama; .chk (16px sabit) yerine saran flex label *@
                <div class="form-group reason-extra hidden">
                    <label class="form-label font-normal" style="display:flex;align-items:flex-start;gap:8px">
                        <input asp-for="Header.IsForceMajeure" type="checkbox" disabled="@(!Model.IsDraft)" style="width:auto;margin-top:3px;flex:none" />
                        <span>Mücbir sebep (Maliye-ilan afet: deprem/sel/yangın) — bu durumda KDV korunur</span>
                    </label>
                </div>
                <div class="form-group reason-extra hidden">
                    <label class="form-label">Yasal Belge No</label>
                    <input asp-for="Header.LegalDocRef" class="form-ctrl" readonly="@(!Model.IsDraft)" placeholder="Takdir komisyonu kararı / itfaiye / sigorta rapor no" />
                </div>
            </div>
            @* CSP-uyumlu vanilla toggle (IIFE): neden seçimine göre mevzuat metni + ek alanları gösterir/gizler *@
            <script>
                (function () {
                    var sel = document.getElementById('reason-select');
                    if (!sel) return;
                    var block = document.getElementById('reason-block');
                    var mevzuat = document.getElementById('reason-mevzuat');
                    var yes = mevzuat.querySelector('[data-kdv-yes]');
                    var no = mevzuat.querySelector('[data-kdv-no]');
                    function apply() {
                        var opt = sel.options[sel.selectedIndex];
                        var isReason = sel.value !== '';                 // bir zayiat nedeni seçili mi
                        var requiresKdv = opt && opt.getAttribute('data-kdv') === '1'; // sözlük flag'i
                        // Ek alanlar (mücbir + belge-ref) yalnız zayiat nedeninde görünür
                        block.querySelectorAll('.reason-extra').forEach(function (el) { el.classList.toggle('hidden', !isReason); });
                        // Mevzuat kutusu + doğru metin
                        mevzuat.classList.toggle('hidden', !isReason);
                        if (isReason) { yes.style.display = requiresKdv ? '' : 'none'; no.style.display = requiresKdv ? 'none' : ''; }
                    }
                    sel.addEventListener('change', apply);
                    apply(); // ilk yüklemede mevcut seçime göre uygula
                })();
            </script>
            @if (!Model.IsNew && Model.Header.Status == DocStatus.Posted && Model.Header.KdvAdjustmentAmount > 0)
            {
                <div class="alert-banner alert-warn mb-2">İlave Edilecek KDV (md.30/c — indirilen KDV düzeltmesi): <strong>@Model.Header.KdvAdjustmentAmount.ToString("N2") ₺</strong></div>
            }
            <div class="form-group">
                <label class="form-label">Açıklama</label>
                <input asp-for="Header.Notes" class="form-ctrl" readonly="@(!Model.IsDraft)" placeholder="Sarf gerekçesi" />
            </div>
            @if (Model.IsDraft)
            {
                <button type="submit" class="btn btn-primary mt-2">@(Model.IsNew ? "Oluştur" : "Kaydet")</button>
            }
        </form>
    </div>

    @if (!Model.IsNew)
    {
        <div class="card overflow-hidden">
            <div class="px-6 py-4 bg-[var(--bg-2)] border-b border-[var(--border)] flex items-center justify-between">
                <h3 class="text-sm font-bold text-[var(--text)]">Sarf Kalemleri</h3>
                @if (Model.IsDraft)
                {
                    <button type="button" onclick="document.getElementById('add-line').classList.toggle('hidden')" class="btn btn-secondary btn-sm">+ Kalem Ekle</button>
                }
            </div>

            @if (Model.IsDraft)
            {
                <div id="add-line" class="hidden p-4 bg-[var(--bg-2)] border-b border-[var(--border)]">
                    <form method="post" asp-page-handler="AddLine" asp-route-id="@Model.Header.Id" class="form-row">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label class="form-label">Ürün (sarf edilebilir)</label>
                            <select name="itemId" class="form-ctrl" required data-combobox>
                                <option value="">Seçiniz...</option>
                                @foreach (var i in Model.Items) { <option value="@i.Id">@i.Code - @i.Name</option> }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Miktar</label>
                            <input name="qty" type="number" step="0.001" class="form-ctrl" required />
                        </div>
                        <div class="form-group" style="align-self:flex-end">
                            <button type="submit" class="btn btn-primary">Ekle</button>
                        </div>
                    </form>
                </div>
            }

            <table class="data-table">
                <thead>
                    <tr><th>Ürün</th><th class="text-right">Miktar</th>@if (Model.IsDraft) { <th></th> }</tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Lines)
                    {
                        <tr>
                            <td class="font-medium text-[var(--text-2)]">@l.ItemName <span class="text-[var(--text-4)] text-xs">@l.ItemCode</span></td>
                            <td class="text-right mono">@l.Qty.ToString("N3") @l.UomCode</td>
                            @if (Model.IsDraft)
                            {
                                <td class="text-right">
                                    <form method="post" asp-page-handler="DeleteLine" asp-route-id="@Model.Header.Id" onsubmit="return confirm('Satırı sil?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lineId" value="@l.Id" />
                                        <button type="submit" class="text-[var(--danger)] text-xs font-bold">Sil</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    @if (!Model.Lines.Any())
                    {
                        <tr><td colspan="3" class="text-center text-[var(--text-4)] italic py-8">Kalem yok. "Kalem Ekle" ile başlayın.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
