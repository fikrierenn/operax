@page "{id:guid}"
@model Operax.Web.Features.Picking.DetailsModel
@{
    ViewData["Title"] = $"Toplama Görevi — {Model.Task.DocNo}";
}

<div class="flex justify-between items-start mb-6">
    <div>
        <div class="flex items-center gap-3 mb-1">
            <h2 class="text-2xl font-bold">@Model.Task.DocNo</h2>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase
                @(Model.Task.Status switch {
                    PickTaskStatus.Completed  => "bg-green-100 text-green-700",
                    PickTaskStatus.InProgress => "bg-blue-100 text-blue-700",
                    _                         => "bg-slate-100 text-slate-500"
                })">
                @Model.Task.Status
            </span>
        </div>
        <p class="text-slate-500 text-sm">Hedef Depo: <span class="font-bold text-slate-900 uppercase">Main Depo</span></p>
    </div>
    <div class="flex gap-2">
        <a asp-page="./Index" class="bg-white border text-slate-700 px-4 py-2 rounded-lg font-bold hover:bg-slate-50 transition-all text-sm">
            Geri
        </a>
        @if (Model.Task.Status == PickTaskStatus.Draft || Model.Task.Status == PickTaskStatus.Assigned)
        {
            <div class="relative group">
                <button class="bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-indigo-700 transition-all text-sm flex items-center gap-2">
                    @(Model.Task.AssignedUserId == null ? "Görevi Ata" : "Yeniden Ata")
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </button>
                <div class="absolute right-0 mt-2 w-48 bg-white border rounded-xl shadow-xl hidden group-hover:block z-50 overflow-hidden">
                    @foreach (var staff in Model.WarehouseStaff)
                    {
                        <form method="post" asp-page-handler="Assign">
                            <input type="hidden" name="id" value="@Model.Task.Id" />
                            <input type="hidden" name="userId" value="@staff.Id" />
                            <button type="submit" class="w-full text-left px-4 py-2 text-sm hover:bg-indigo-50 transition-colors font-medium">@staff.UserName</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>

<div class="bg-white rounded-xl border shadow-sm overflow-hidden">
    <div class="p-4 bg-slate-50 border-b flex justify-between items-center">
        <h3 class="font-bold text-[10px] uppercase text-slate-500 tracking-widest">Toplanacak Kalemler</h3>
        <div class="text-[10px] font-bold text-slate-400">Toplam satır: @Model.Lines.Count()</div>
    </div>
    <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 border-b">
            <tr>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Hedef Raf</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Ürün / Kod</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase text-right">İstenen</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase text-right">Toplanan</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase">Operatör</th>
                <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase text-right">İşlem</th>
            </tr>
        </thead>
        <tbody class="divide-y text-sm">
            @foreach (var line in Model.Lines)
            {
                <tr class="hover:bg-slate-50 transition-colors @(line.QtyPicked > 0 ? "bg-green-50/30" : "")">
                    <td class="px-6 py-4 font-mono font-bold text-indigo-600">
                        <span class="bg-indigo-50 px-2 py-1 rounded">@line.TargetBinCode</span>
                    </td>
                    <td class="px-6 py-4">
                        <div class="font-bold text-slate-900">@line.ItemCode</div>
                        <div class="text-[10px] text-slate-400">@line.ItemName</div>
                    </td>
                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-400">@line.QtyRequested.ToString("N0")</td>
                    <td class="px-6 py-4 text-right font-mono font-bold text-lg @(line.QtyPicked >= line.QtyRequested ? "text-green-600" : "text-amber-500")">
                        @line.QtyPicked.ToString("N0")
                    </td>
                    <td class="px-6 py-4">
                        @if (line.QtyPicked > 0)
                        {
                            <div class="flex items-center gap-2">
                                <div class="w-5 h-5 rounded-full bg-green-100 flex items-center justify-center text-[8px] font-bold text-green-700">@((line.PickedByUserName ?? "?").Substring(0,1).ToUpper())</div>
                                <div class="flex flex-col leading-none">
                                    <span class="text-[11px] font-bold text-slate-700">@line.PickedByUserName</span>
                                    <span class="text-[9px] text-slate-400 font-mono">@line.PickedAt?.ToString("HH:mm:ss")</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="text-[10px] text-slate-300 italic">Bekliyor...</span>
                        }
                    </td>
                    <td class="px-6 py-4 text-right">
                        @if (line.QtyPicked < line.QtyRequested)
                        {
                            <form method="post" asp-page-handler="PickLine">
                                <input type="hidden" name="id" value="@Model.Task.Id" />
                                <input type="hidden" name="lineId" value="@line.Id" />
                                <input type="hidden" name="qty" value="@line.QtyRequested" />
                                <button type="submit" class="bg-green-500 text-white px-4 py-1.5 rounded-lg font-bold hover:bg-green-600 transition-all text-[10px] uppercase tracking-widest shadow-lg shadow-green-100">
                                    Onayla
                                </button>
                            </form>
                        }
                        else
                        {
                             <div class="text-green-500 font-black text-xs">✓ TAMAM</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Task.Status == PickTaskStatus.Completed)
{
    <div class="mt-8 bg-green-50 border border-green-100 rounded-xl p-8 flex items-center gap-6 animate-in slide-in-from-bottom duration-500">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-sm shrink-0">
            <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
        </div>
        <div>
            <h4 class="font-bold text-green-900 text-lg">Toplama Tamamlandı!</h4>
            <p class="text-sm text-green-700">Tüm @Model.Lines.Count() kalem başarıyla toplandı ve kaydedildi. Sevkiyat paketlemeye hazır.</p>
        </div>
    </div>
}
