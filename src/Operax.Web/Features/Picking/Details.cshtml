@page "{id:guid}"
@model Operax.Web.Features.Picking.DetailsModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = $"Toplama Görevi — {Model.Task.DocNo}";
}

<div class="page" data-screen-label="Toplama Görevi">
    <div class="page-hdr">
        <div class="page-hdr-l">
            <div class="breadcrumb">
                <a asp-page="./Index" class="breadcrumb-item">Toplama Görevleri</a>
                <span class="breadcrumb-sep">/</span>
                <span class="breadcrumb-current">@Model.Task.DocNo</span>
            </div>
            <h1>@Model.Task.DocNo</h1>
            <p class="page-hdr-sub">Atanan: <strong>@(Model.Task.AssignedUserName ?? "Atanmadı")</strong></p>
        </div>
        <div class="page-hdr-r flex gap-2 items-center">
            @Html.Raw(Dict.StatusBadge(Model.Task.Status, "PICKTASK_STATUS"))
            <a asp-page="./Index" class="btn btn-secondary btn-sm">Geri</a>
            @if (Model.Task.Status == PickTaskStatus.Draft || Model.Task.Status == PickTaskStatus.Assigned)
            {
                @* Atama menüsü: hover değil CLICK-toggle (touch + klavye erişilebilir; Esc/dışarı-tık kapatır) *@
                <div class="relative" data-assign-menu>
                    <button type="button" class="btn btn-primary btn-sm flex items-center gap-2"
                            onclick="var m=this.parentElement.querySelector('[data-assign-list]');m.classList.toggle('hidden');">
                        @(Model.Task.AssignedUserId == null ? "Görevi Ata" : "Yeniden Ata")
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>
                    <div data-assign-list class="absolute right-0 mt-2 w-48 bg-[var(--surface)] border border-[var(--border)] rounded-xl shadow-xl hidden z-50 overflow-hidden">
                        @foreach (var staff in Model.WarehouseStaff)
                        {
                            <form method="post" asp-page-handler="Assign">
                                <input type="hidden" name="id" value="@Model.Task.Id" />
                                <input type="hidden" name="userId" value="@staff.Id" />
                                <button type="submit" class="w-full text-left px-4 py-2 text-sm hover:bg-[var(--brand-tint-08)] transition-colors font-medium">@staff.UserName</button>
                            </form>
                        }
                    </div>
                </div>
            }
            @* Görevi İptal (Plan 56 IMP-3): terminal-olmayan statüde. Sevkiyat PICKING'te + başka görev yoksa DRAFT'a döner. *@
            @if (Model.Task.Status != PickTaskStatus.Completed && Model.Task.Status != PickTaskStatus.Cancelled)
            {
                <form method="post" asp-page-handler="CancelTask">
                    <input type="hidden" name="id" value="@Model.Task.Id" />
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Toplama görevi iptal edilecek; bağlı sevkiyat tekrar taslağa dönebilir. Onaylıyor musunuz?')">Görevi İptal</button>
                </form>
            }
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="card-hdr">
            <div>
                <div class="card-title">Toplanacak Kalemler</div>
                <div class="card-sub">Toplam satır: @Model.Lines.Count()</div>
            </div>
        </div>
        <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Hedef Raf</th>
                    <th>Ürün / Kod</th>
                    <th class="text-right">İstenen</th>
                    <th class="text-right">Toplanan</th>
                    <th>Operatör</th>
                    <th class="text-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr class="@(line.QtyPicked > 0 ? "bg-[var(--success-bg)]" : "")">
                        <td class="font-mono font-bold text-[var(--brand-600)]">
                            <span class="badge badge-brand">@line.TargetBinCode</span>
                        </td>
                        <td>
                            <div class="font-bold text-[var(--text)]">@line.ItemCode</div>
                            <div class="text-[10px] text-[var(--text-4)]">@line.ItemName</div>
                        </td>
                        <td class="text-right font-mono font-bold text-[var(--text-4)]">@line.QtyRequested.ToString("N0")</td>
                        <td class="text-right font-mono font-bold text-lg @(line.QtyPicked >= line.QtyRequested ? "text-[var(--success)]" : "text-[var(--warn)]")">
                            @line.QtyPicked.ToString("N0")
                        </td>
                        <td>
                            @if (line.QtyPicked > 0)
                            {
                                <div class="flex items-center gap-2">
                                    <div class="w-5 h-5 rounded-full bg-[var(--success-bg)] flex items-center justify-center text-[8px] font-bold text-[var(--success-text)]">@((line.PickedByUserName ?? "?").Substring(0,1).ToUpper())</div>
                                    <div class="flex flex-col leading-none">
                                        <span class="text-[11px] font-bold text-[var(--text-2)]">@line.PickedByUserName</span>
                                        <span class="text-[9px] text-[var(--text-4)] font-mono">@line.PickedAt?.ToString("HH:mm:ss")</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-[10px] text-[var(--text-mute)] italic">Bekliyor...</span>
                            }
                        </td>
                        <td class="text-right">
                            @if (line.QtyPicked < line.QtyRequested)
                            {
                                <form method="post" asp-page-handler="PickLine">
                                    <input type="hidden" name="id" value="@Model.Task.Id" />
                                    <input type="hidden" name="lineId" value="@line.Id" />
                                    <input type="hidden" name="qty" value="@line.QtyRequested" />
                                    <button type="submit" class="btn btn-success btn-sm">Onayla</button>
                                </form>
                            }
                            else
                            {
                                <div class="text-[var(--success)] font-black text-xs">✓ TAMAM</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    @if (Model.Task.Status == PickTaskStatus.Completed)
    {
        <div class="alert-banner alert-success mt-8 flex items-center gap-4">
            <svg class="w-8 h-8 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <div>
                <h4 class="font-bold text-base">Toplama Tamamlandı!</h4>
                <p class="text-sm">Tüm @Model.Lines.Count() kalem başarıyla toplandı ve kaydedildi. Sevkiyat paketlemeye hazır.</p>
            </div>
        </div>
    }
</div>

@* Atama menüsü: Esc veya dışarı-tık ile kapat (CSP-uyumlu vanilla, eval yok) *@
<script>
    (function () {
        function closeAll() {
            document.querySelectorAll('[data-assign-list]:not(.hidden)').forEach(function (m) { m.classList.add('hidden'); });
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
        document.addEventListener('click', function (e) { if (!e.target.closest('[data-assign-menu]')) closeAll(); });
    })();
</script>
