@page
@model Operax.Web.Features.Picking.IndexModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = "Toplama Görevleri";
}

<div class="page-hdr">
    <div>
        <h2 class="text-2xl font-bold text-[var(--text)]">Toplama Görevleri</h2>
        <p class="text-sm text-[var(--text-3)] mt-0.5">Depo toplama operasyonlarını izle ve ata</p>
    </div>
    <div class="page-hdr-r">
        <button class="btn btn-secondary">Filtrele</button>
        <button class="btn btn-primary">+ Yeni Toplama Görevi</button>
    </div>
</div>

<!-- KPI Özet Kartları -->
<div class="kpi-row">
    <div class="kpi">
        <span class="kpi-label">Aktif Görevler</span>
        <div class="kpi-val text-[var(--brand-600)]">@Model.Tasks.Count(x => x.Status != PickTaskStatus.Completed)</div>
        <span class="kpi-sub">Tamamlanmamış görevler</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Atama Bekliyor</span>
        <div class="kpi-val text-[var(--warn)]">@Model.Tasks.Count(x => x.Status == PickTaskStatus.Draft)</div>
        <span class="kpi-sub">Personel atanmamış</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Devam Ediyor</span>
        <div class="kpi-val text-[var(--info-text)]">@Model.Tasks.Count(x => x.Status == PickTaskStatus.InProgress)</div>
        <span class="kpi-sub">Aktif olarak toplanan</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Bugün Tamamlanan</span>
        <div class="kpi-val text-[var(--success)]">@Model.Tasks.Count(x => x.Status == PickTaskStatus.Completed && x.CreatedAt.Date == DateTime.Today)</div>
        <span class="kpi-sub">Bugün biten görevler</span>
    </div>
</div>

<div class="card">
    <div class="table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Görev No</th>
                <th>Durum</th>
                <th>Atanan Personel</th>
                <th>İlerleme</th>
                <th>Oluşturulma</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model.Tasks)
            {
                <tr>
                    <td class="font-mono font-bold text-[var(--brand-600)] tracking-tight">@task.DocNo</td>
                    <td>@Html.Raw(Dict.StatusBadge(task.Status, "PICKTASK_STATUS"))</td>
                    <td>
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-[var(--bg-2)] flex items-center justify-center
                                        text-[10px] font-bold text-[var(--text-3)] shrink-0">
                                @((task.AssignedUserName ?? "?").Substring(0, 1).ToUpper())
                            </div>
                            <span class="@(task.AssignedUserName == null ? "text-[var(--text-4)] italic text-xs" : "font-medium text-sm")">
                                @(task.AssignedUserName ?? "Atanmadı")
                            </span>
                        </div>
                    </td>
                    <td>
                        <div class="flex items-center gap-3">
                            <div class="flex-1 h-1.5 bg-[var(--bg-2)] rounded-full overflow-hidden max-w-24">
                                <div class="h-full bg-[var(--brand-500)] rounded-full transition-all" style="width:@(task.Progress)%"></div>
                            </div>
                            <span class="text-[10px] font-bold font-mono text-[var(--text-4)]">
                                @task.PickedLineCount/@task.LineCount
                            </span>
                        </div>
                    </td>
                    <td class="text-[var(--text-3)] text-xs">@task.CreatedAt.ToString("g")</td>
                    <td class="text-right">
                        <a asp-page="./Details" asp-route-id="@task.Id" class="btn btn-secondary btn-sm">Aç</a>
                    </td>
                </tr>
            }
            @if (!Model.Tasks.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <p>Henüz toplama görevi oluşturulmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
