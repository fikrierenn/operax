@page
@model Operax.Web.Features.Production.IndexModel
@{
    ViewData["Title"] = "Üretim Emirleri";
}

<div class="page-hdr">
    <div>
        <h2 class="text-2xl font-bold text-slate-800">Üretim Planlama</h2>
        <p class="text-sm text-slate-500 mt-0.5">İş emirleri ve hammadde ihtiyaç yönetimi</p>
    </div>
    <button class="btn btn-primary">+ Yeni İş Emri</button>
</div>

<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Emir No</th>
                <th>Ürün</th>
                <th class="text-right">Hedef Miktar</th>
                <th class="text-right">Üretilen</th>
                <th class="text-center">Durum</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td class="font-mono font-bold text-indigo-600">@order.DocNo</td>
                    <td>
                        <div class="font-semibold text-slate-800">@order.ItemName</div>
                        <div class="text-[10px] text-slate-400 font-mono mt-0.5">@order.ItemCode</div>
                    </td>
                    <td class="text-right font-mono font-bold text-slate-700">@order.QtyTarget.ToString("N2")</td>
                    <td class="text-right font-mono font-bold text-green-600">@order.QtyProduced.ToString("N2")</td>
                    <td class="text-center">
                        <span class="badge @(order.Status switch {
                            ProductionStatus.Completed  => "b-green",
                            ProductionStatus.InProgress => "b-blue",
                            // RELEASED ProductionStatus'ta yok (SP DRAFT→IN_PROGRESS→COMPLETED, Plan 41 A3) — savunmacı literal
                            "RELEASED"                  => "b-indigo",
                            _                           => "b-gray"
                        })">@order.Status</span>
                    </td>
                    <td class="text-right">
                        <a asp-page="./Details" asp-route-id="@order.Id" class="btn btn-secondary btn-sm">Detay</a>
                    </td>
                </tr>
            }
            @if (!Model.Orders.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                            <p>Henüz üretim emri oluşturulmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="new Operax.Web.Lib.PagerVm(Model.Page, Model.TotalPages, Model.FilteredCount, Model.PageSize)" />
