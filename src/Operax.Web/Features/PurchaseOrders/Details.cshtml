@page "{id:guid?}"
@using Operax.Web.Lib
@model Operax.Web.Features.PurchaseOrders.DetailsModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    var titleText = Model.IsNew
        ? L.T("Yeni Satınalma Siparişi", "New Purchase Order")
        : Model.Header.OrderNo;
    ViewData["Title"] = titleText;

    var isDraft     = Model.Header.Status == DocStatus.Draft;
    var isPosted    = Model.Header.Status == DocStatus.Posted || Model.Header.Status == DocStatus.Approved;
    var isCancelled = Model.Header.Status == DocStatus.Cancelled;
    // Kapanış statüleri (Plan 54 Faz 3): tam kabul → CLOSED, kalan iptal → CLOSED_PARTIAL. İkisi de terminal (salt-okuma).
    var isClosed    = Model.Header.Status == DocStatus.Closed || Model.Header.Status == DocStatus.ClosedPartial;

    // Status flow adımları
    var flowSteps = new List<StatusStepVm>
    {
        new(L.T("Oluşturuldu", "Created"), "done", Model.Header.CreatedAt?.ToString("dd MMM HH:mm")),
        new(L.T("Taslak", "Draft"), isDraft ? "current" : "done", Model.Header.CreatedAt?.ToString("dd MMM HH:mm"))
    };
    if (isCancelled)
        flowSteps.Add(new(L.T("İptal", "Cancelled"), "cancelled", Model.Header.UpdatedAt?.ToString("dd MMM HH:mm")));
    else
        flowSteps.Add(new(L.T("Onaylı", "Posted"), isPosted ? "current" : (isClosed ? "done" : "pending"), (isPosted || isClosed) ? Model.Header.UpdatedAt?.ToString("dd MMM HH:mm") : null));
    // Kapanış adımı: tam kabul (Kapandı) veya kalan-iptal (Kısmen Kapandı)
    if (isClosed)
        flowSteps.Add(new(Model.Header.Status == DocStatus.ClosedPartial ? L.T("Kısmen Kapandı", "Partially Closed") : L.T("Kapandı", "Closed"), "current", Model.Header.UpdatedAt?.ToString("dd MMM HH:mm")));

    var flow = new StatusFlowVm(flowSteps);

    // Sayfa başlığı aksiyonları (durum bazlı)
    var actions = $"<a href=\"/PurchaseOrders\" class=\"btn btn-ghost btn-sm\"><svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><polyline points=\"15 18 9 12 15 6\"/></svg>{L.T("Geri", "Back")}</a>" +
                  $"<button class=\"btn btn-secondary btn-sm\"><svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/></svg>PDF</button>";
    if (isDraft && !Model.IsNew)
    {
        actions += $"<button type=\"submit\" form=\"po-approve\" class=\"btn btn-success btn-sm\" data-shortcut=\"Alt+S\"><svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>{L.T("Onayla", "Approve")}<span class=\"btn-kbd\">Alt+S</span></button>";
    }
    if (isPosted)
    {
        // Kalanı Kapat: kısmen teslim alınmış siparişin kalan miktarını beklemeyi bırak (CLOSED_PARTIAL)
        actions += $"<button type=\"submit\" form=\"po-close-remaining\" class=\"btn btn-secondary btn-sm\"><svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"/></svg>{L.T("Kalanı Kapat", "Close Remaining")}</button>";
        actions += $"<button type=\"submit\" form=\"po-cancel\" class=\"btn btn-secondary btn-sm btn-danger-outline\"><svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg>{L.T("İptal Et", "Cancel")}</button>";
    }

    var crumbs = Model.IsNew
        ? new[] { L.T("Anasayfa", "Home"), L.T("Satınalma", "Purchasing"), L.T("Yeni", "New") }
        : new[] { L.T("Anasayfa", "Home"), L.T("Satınalma", "Purchasing"), L.T("Siparişler", "Orders"), Model.Header.OrderNo };

    var header = new PageHeaderVm(
        Title: titleText,
        Crumbs: crumbs,
        SubHtml: Model.IsNew ? null : $"{System.Web.HttpUtility.HtmlEncode(Model.Header.PartnerName)} · {L.T("Vade", "Due")} <span class=\"mono\">{(Model.Header.DueDate.HasValue ? UiHelpers.FmtDateShort(Model.Header.DueDate.Value) : "—")}</span>",
        ActionsHtml: actions);
}

@* Sayfa header'ı için ayrı durum rozeti çubuğu (h1 yanına) *@
<div class="page" data-screen-label="Satınalma Siparişi" style="max-width:1400px;">

    <partial name="_PageHeader" model="header" />

    @if (TempData["PriceWarning"] is string priceWarn)
    {
        <div class="alert-banner alert-warning" style="margin-bottom:14px;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span>@priceWarn</span>
            <a href="/PurchaseOrders/PriceVariances" class="btn btn-ghost btn-xs" style="margin-left:auto;">Fiyat Farkları</a>
        </div>
    }

    @if (!Model.IsNew)
    {
        <div class="row" style="gap:10px;margin-top:-10px;margin-bottom:14px;">
            <span class="mono text-strong doc-no">@Model.Header.OrderNo</span>
            @Html.Raw(Dict.StatusBadge(Model.Header.Status))
        </div>

        <partial name="_StatusFlow" model="flow" />

        @* Belge zinciri smart butonları *@
        @if (Model.DocFlow is not null)
        {
            <partial name="_DocFlowButtons" model="Model.DocFlow" />
        }
    }

    <div style="display:grid;grid-template-columns:1fr 320px;gap:14px;">

        @* ───── SOL: header bilgi + satırlar ───── *@
        <div class="stack">

            <div class="card">
                <div class="card-hdr"><div class="card-title">@L.T("Evrak Bilgileri", "Document Info")</div></div>
                <form method="post" class="card-body" style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Header.Id" />

                    <div>
                        <div class="form-label">@L.T("Tedarikçi", "Supplier") <span class="req">*</span></div>
                        @if (isDraft || Model.IsNew)
                        {
                            <select class="form-ctrl" asp-for="Header.PartnerId" required data-combobox>
                                <option value="">@L.T("Seçiniz…", "Select…")</option>
                                @foreach (var v in Model.Vendors)
                                {
                                    <option value="@v.Id">@v.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="doc-val brand">@Model.Header.PartnerName</div>
                            <div class="doc-sub">
                                @if (!string.IsNullOrEmpty(Model.Header.PartnerTaxNumber))
                                {
                                    <text>VKN <span class="mono">@Model.Header.PartnerTaxNumber</span></text>
                                }
                            </div>
                        }
                    </div>

                    <div>
                        <div class="form-label">@L.T("Şehir", "City")</div>
                        <div class="doc-val">@(Model.Header.PartnerCity ?? "—")</div>
                        <div class="doc-sub">Türkiye</div>
                    </div>

                    <div>
                        <div class="form-label">@L.T("Para Birimi", "Currency")</div>
                        <div class="mono doc-val">TRY · ₺</div>
                    </div>

                    <div>
                        <div class="form-label">@L.T("Vade Tarihi", "Due Date")</div>
                        <div class="mono doc-val">@(Model.Header.DueDate.HasValue ? UiHelpers.FmtDateShort(Model.Header.DueDate.Value) : "—")</div>
                        <div class="doc-sub">@Model.Header.PaymentTermDays @L.T("gün", "days")</div>
                    </div>

                    <div>
                        <div class="form-label">@L.T("Depo", "Warehouse") <span class="req">*</span></div>
                        @if (isDraft || Model.IsNew)
                        {
                            <select class="form-ctrl" asp-for="Header.WarehouseId" required>
                                <option value="">@L.T("Seçiniz…", "Select…")</option>
                                @foreach (var w in Model.Warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="doc-val">@Model.Header.WarehouseName</div>
                        }
                    </div>

                    <div style="grid-column:span 3;">
                        <div class="form-label">@L.T("Notlar", "Notes")</div>
                        @if (isDraft || Model.IsNew)
                        {
                            <textarea class="form-ctrl" asp-for="Header.Notes" rows="2"></textarea>
                        }
                        else
                        {
                            <div class="doc-val note">@(string.IsNullOrEmpty(Model.Header.Notes) ? "—" : Model.Header.Notes)</div>
                        }
                    </div>

                    @if (isDraft || Model.IsNew)
                    {
                        <div style="grid-column:span 4;display:flex;gap:8px;justify-content:flex-end;">
                            <button type="submit" class="btn btn-primary btn-sm">@L.T("Kaydet", "Save")</button>
                        </div>
                    }
                </form>
            </div>

            <div class="card">
                <div class="card-hdr">
                    <div>
                        <div class="card-title">@L.T("Sipariş Kalemleri", "Order Lines")</div>
                        <div class="card-sub">@Model.Lines.Count() @L.T("kalem", "lines")</div>
                    </div>
                    @if (isDraft && !Model.IsNew)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('add-line-row').style.display='table-row'">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            @L.T("Kalem Ekle", "Add Line")
                        </button>
                    }
                </div>
                <div class="card-body-flush">
                    @if (!Model.Lines.Any() && !isDraft)
                    {
                        var emptyLines = new EmptyStateVm(Title: L.T("Kalem yok", "No lines"));
                        <partial name="_EmptyState" model="emptyLines" />
                    }
                    else
                    {
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="num" style="width:40px;">#</th>
                                    <th>SKU</th>
                                    <th>@L.T("Ürün Adı", "Item")</th>
                                    <th>@L.T("Birim", "UOM")</th>
                                    <th class="num">@L.T("Miktar", "Qty")</th>
                                    <th class="num">@L.T("Birim Fiyat", "Unit Price")</th>
                                    <th class="num">KDV</th>
                                    <th class="num">@L.T("Toplam", "Total")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int lineNo = 0; }
                                @foreach (var l in Model.Lines)
                                {
                                    lineNo++;
                                    <tr>
                                        <td class="num muted mono">@lineNo</td>
                                        <td><span class="mono row-strong text-brand">@l.ItemCode</span></td>
                                        <td>@l.ItemName</td>
                                        <td><span class="badge badge-neutral" style="height:18px;">@l.UomCode</span></td>
                                        <td class="num">@UiHelpers.FmtNum(l.QtyOrdered)</td>
                                        <td class="num">@UiHelpers.FmtNum(l.Price ?? 0, 2)</td>
                                        <td class="num muted">%@UiHelpers.FmtNum(l.TaxRate, 0)</td>
                                        <td class="num"><span class="row-strong">@UiHelpers.FmtTL(l.LineTotal)</span></td>
                                    </tr>
                                }
                                @if (isDraft && !Model.IsNew)
                                {
                                    <tr id="add-line-row" class="row-inset" style="display:none;">
                                        <td colspan="8">
                                            <form method="post" asp-page-handler="AddLine" class="row" style="gap:8px;padding:6px;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Header.Id" />
                                                <select name="itemId" id="po-line-item" class="form-ctrl" style="flex:2;" required data-combobox>
                                                    <option value="">@L.T("Ürün seçiniz…", "Select item…")</option>
                                                    @foreach (var i in Model.AvailableItems)
                                                    {
                                                        <option value="@i.Id">@i.Code — @i.Name</option>
                                                    }
                                                </select>
                                                <input name="qty" type="number" step="any" min="0.01" class="form-ctrl" placeholder="@L.T("Miktar", "Qty")" style="flex:1;" required />
                                                <input name="price" id="po-line-price" type="number" step="any" min="0" class="form-ctrl" placeholder="@L.T("Birim Fiyat", "Price")" style="flex:1;" />
                                                <button type="submit" class="btn btn-primary btn-sm">@L.T("Ekle", "Add")</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @* Ürün seçilince önerilen alış fiyatı (son maliyet) otomatik gelir — kullanıcı değiştirebilir *@
                        <script>
                        (function () {
                            var prices = @Html.Raw(Model.ItemPriceJson);
                            var itemSel = document.getElementById('po-line-item');
                            var priceIn = document.getElementById('po-line-price');
                            if (!itemSel || !priceIn) return;
                            itemSel.addEventListener('change', function () {
                                var v = prices[this.value];
                                // Kullanıcı elle fiyat girmediyse öneriyi doldur
                                if (v != null && v > 0 && !priceIn.value) { priceIn.value = v; }
                            });
                        })();
                        </script>
                    }
                </div>
                @if (Model.Lines.Any())
                {
                    <div class="card-foot">
                        <div class="doc-foot-note">@L.T("Tüm tutarlar TRY (₺) cinsindendir", "All amounts in TRY (₺)")</div>
                        <div class="row doc-totals">
                            <div class="doc-total">
                                <span class="text-mute">@L.T("Ara Toplam", "Subtotal")</span>
                                <span class="mono text-strong">@UiHelpers.FmtTL(Model.Subtotal)</span>
                            </div>
                            <div class="doc-total">
                                <span class="text-mute">KDV</span>
                                <span class="mono text-strong">@UiHelpers.FmtTL(Model.Vat)</span>
                            </div>
                            <div class="doc-total">
                                <span class="doc-total-cap">@L.T("Genel Toplam", "Grand Total")</span>
                                <span class="mono doc-grand">@UiHelpers.FmtTL(Model.Grand)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ───── SAĞ: aktivite ───── *@
        <div class="stack">
            <div class="card">
                <div class="card-hdr"><div class="card-title">@L.T("Aktivite", "Activity")</div></div>
                <div class="card-body" style="padding:14px 18px;">
                    @if (!Model.Activities.Any())
                    {
                        <div class="text-mute activity-text">@L.T("Henüz aktivite yok.", "No activity yet.")</div>
                    }
                    else
                    {
                        var actList = Model.Activities.ToList();
                        for (int i = 0; i < actList.Count; i++)
                        {
                            var a = actList[i];
                            var userName = a.UserName ?? L.T("Sistem", "System");
                            var color = a.Action switch
                            {
                                "CREATE"   => "var(--text-3)",
                                "POST"     => "var(--success)",
                                "APPROVE"  => "var(--success)",
                                "CANCEL"   => "var(--danger)",
                                "CLOSE_PARTIAL" => "var(--warn)",
                                "ADD_LINE" => "var(--brand-500)",
                                _          => "var(--text-3)"
                            };
                            var notLast = i < actList.Count - 1;
                            <div class="row activity-item" style="gap:10px;margin-bottom:14px;align-items:flex-start;">
                                <div style="position:relative;flex-shrink:0;">
                                    @* avatar zemini aksiyon tipine göre veri-driven *@
                                    <div class="avatar sm" style="background:@color;">@UiHelpers.Initials(userName)</div>
                                    @if (notLast)
                                    {
                                        <div class="activity-line"></div>
                                    }
                                </div>
                                <div style="flex:1;">
                                    <div class="activity-text">
                                        <span class="text-strong">@userName</span>
                                        <span class="text-mute">@UiHelpers.AuditActionLabel(a.Action)</span>
                                    </div>
                                    <div class="mono activity-time">@a.CreatedAt.ToString("dd MMM · HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* Onayla / İptal et formları (sayfa header'ındaki butonlar buraya post eder) *@
@if (!Model.IsNew)
{
    <form id="po-approve" method="post" asp-page-handler="Approve" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Header.Id" />
    </form>
    <form id="po-cancel" method="post" asp-page-handler="Cancel" style="display:none;"
          onsubmit="return confirm('Bu siparişi iptal etmek istediğinize emin misiniz?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Header.Id" />
    </form>
    <form id="po-close-remaining" method="post" asp-page-handler="CloseRemaining" style="display:none;"
          onsubmit="return confirm('Kalan miktar artık beklenmeyecek; sipariş kısmen kapatılacak. Onaylıyor musunuz?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Header.Id" />
    </form>
}
