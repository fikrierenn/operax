@page "{id:guid?}"
@model Operax.Web.Features.Receiving.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Mal Kabul" : $"Mal Kabul Belgesi {Model.Header.DocNo}";
}

<form method="post" class="fade-in">
    <div class="page-hdr">
        <div>
            <div class="flex items-center gap-2 mb-2 text-xs">
                <a asp-page="./Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                    <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                    Mal Kabul Listesi
                </a>
                <span class="text-slate-400">/</span>
                <span class="text-slate-600 font-semibold">Belge Girişi</span>
            </div>
            <h1>@(Model.IsNew ? "Yeni Mal Kabul Belgesi" : $"Mal Kabul: {Model.Header.DocNo}")</h1>
            <p class="page-hdr-sub">@(Model.IsNew ? "Mal kabul işlemine başlamak için belge başlık bilgilerini giriniz" : Model.Header.PartnerName)</p>
        </div>
        <div class="page-hdr-r flex gap-2">
            <a asp-page="./Index" class="btn btn-secondary">
                Listeye Dön
            </a>
            @if (Model.IsNew || Model.Header.Status == DocStatus.Draft)
            {
                <button type="submit" class="btn btn-primary" data-shortcut="Alt+S">
                    Taslak Kaydet
                </button>
            }
            @if (!Model.IsNew && Model.Header.Status == DocStatus.Draft)
            {
                <button type="submit" asp-page-handler="Post" class="btn btn-success" data-shortcut="Alt+P">
                    Stoğa Aktar (Onayla)
                </button>
                <button type="submit" asp-page-handler="Delete" class="btn btn-danger"
                        onclick="return confirm('Bu taslak mal kabul belgesi silinsin mi?');">
                    Sil
                </button>
            }
        </div>
    </div>

    <!-- Belge Başlığı -->
    <div class="card p-6 mb-8 grid grid-cols-1 md:grid-cols-4 gap-6 bg-white">
        <div class="form-group mb-0">
            <label class="form-label">Kabul Modu</label>
            @if (Model.IsNew)
            {
                <select asp-for="Header.Mode" id="rcv-mode" class="form-ctrl w-full">
                    <option value="@Operax.Web.Lib.ReceivingMode.SinglePo">Tek Sipariş (Kontrollü)</option>
                    <option value="@Operax.Web.Lib.ReceivingMode.BulkSupplier">Toplu Kabul (Tedarikçi — Kör)</option>
                    <option value="@Operax.Web.Lib.ReceivingMode.Free">Serbest (Siparişsiz)</option>
                </select>
                <span class="form-hint">Tek sipariş: PO satırına karşı kontrol. Toplu: tüm açık siparişler, fatura aşamasında eşleştirilir. Serbest: yetkili kullanıcı.</span>
            }
            else
            {
                <div class="mt-1">
                    <span class="badge badge-neutral font-mono font-bold">
                        @(Model.Header.Mode switch {
                            Operax.Web.Lib.ReceivingMode.BulkSupplier => "TOPLU KABUL",
                            Operax.Web.Lib.ReceivingMode.Free => "SERBEST",
                            _ => "TEK SİPARİŞ" })
                    </span>
                </div>
                <input type="hidden" asp-for="Header.Mode" />
            }
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Depo</label>
            <select asp-for="Header.WarehouseId" class="form-ctrl w-full" required>
                <option value="">Depo Seçiniz...</option>
                @foreach (var wh in Model.Warehouses)
                {
                    <option value="@wh.Id">@wh.Code - @wh.Name</option>
                }
            </select>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Tedarikçi</label>
            <select asp-for="Header.PartnerId" class="form-ctrl w-full" required>
                <option value="">Tedarikçi Seçiniz...</option>
                @foreach (var p in Model.Partners)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Satınalma Siparişi (Opsiyonel)</label>
            <input type="text" id="po-search" class="form-ctrl w-full mb-2" placeholder="Sipariş no ile ara..." autocomplete="off" />
            <select asp-for="Header.PurchaseOrderId" id="po-select" class="form-ctrl w-full">
                <option value="">Doğrudan Kabul (Siparişsiz)</option>
                @foreach (var po in Model.OpenPurchaseOrders)
                {
                    <option value="@po.Id" data-partner="@po.PartnerId" data-warehouse="@po.WarehouseId" data-orderno="@po.Code.ToLower()">
                        @po.Code — @po.PartnerName (@po.OrderDate.ToString("dd MMM yyyy"))
                    </option>
                }
            </select>
            <span class="form-hint" id="po-empty-hint" style="display:none">Seçili tedarikçinin açık siparişi yok.</span>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Tedarikçi İrsaliye No</label>
            <input asp-for="Header.SupplierWaybillNo" class="form-ctrl w-full" placeholder="Gelen sevk irsaliyesi no" maxlength="50" />
            <span class="form-hint">VUK md.230 — mal kabulün dayanağı sevk irsaliyesi.</span>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">İrsaliye Tarihi</label>
            <input asp-for="Header.SupplierWaybillDate" type="date" class="form-ctrl w-full" />
            <span class="form-hint">Fiili sevk/teslim tarihi (stok hareket tarihi).</span>
        </div>
        <div class="form-group mb-0 flex flex-col justify-between items-start md:items-end">
            <label class="form-label md:text-right">Belge Durumu</label>
            <div class="mt-1">
                <span class="badge @(Model.Header.Status == DocStatus.Posted ? "b-green" : "b-amber") font-mono font-bold">
                    @Model.Header.Status
                </span>
            </div>
        </div>
    </div>
</form>

@* Belge zinciri smart butonları — form DIŞINDA (iç içe form geçersiz; aksi halde buton header formunu submit eder) *@
@if (Model.DocFlow is not null)
{
    <partial name="_DocFlowButtons" model="Model.DocFlow" />
}

@* Açık sipariş seçici: tedarikçi seçimine + arama metnine göre option'ları filtreler *@
<script>
(function () {
    var partnerSel = document.getElementById('Header_PartnerId');
    var poSelect   = document.getElementById('po-select');
    var poSearch   = document.getElementById('po-search');
    var emptyHint  = document.getElementById('po-empty-hint');
    if (!poSelect) return;

    function applyFilter() {
        var partnerId = partnerSel ? partnerSel.value : '';
        var term      = (poSearch ? poSearch.value : '').trim().toLowerCase();
        var visible   = 0;
        for (var i = 0; i < poSelect.options.length; i++) {
            var opt = poSelect.options[i];
            if (!opt.value) { continue; } // "Doğrudan Kabul" her zaman görünür
            var matchPartner = !partnerId || opt.getAttribute('data-partner') === partnerId;
            var matchTerm    = !term || (opt.getAttribute('data-orderno') || '').indexOf(term) !== -1;
            var show = matchPartner && matchTerm;
            opt.hidden = !show;
            if (show) { visible++; }
        }
        // Seçili option gizlendiyse seçimi sıfırla
        if (poSelect.selectedOptions.length && poSelect.selectedOptions[0].hidden) {
            poSelect.value = '';
        }
        if (emptyHint) { emptyHint.style.display = (partnerId && visible === 0) ? '' : 'none'; }
    }

    // Sipariş seçilince o siparişin deposu + tedarikçisi otomatik gelir
    function fillFromPo() {
        var opt = poSelect.selectedOptions[0];
        if (!opt || !opt.value) return;
        var wh = opt.getAttribute('data-warehouse');
        var pt = opt.getAttribute('data-partner');
        var whSel = document.getElementById('Header_WarehouseId');
        // Yalnızca dropdown'da eşleşen option varsa set et (yoksa select boşalır → FK ihlali)
        if (whSel && wh && hasOption(whSel, wh)) { whSel.value = wh; }
        if (partnerSel && pt && hasOption(partnerSel, pt)) { partnerSel.value = pt; }
    }

    function hasOption(sel, val) {
        for (var i = 0; i < sel.options.length; i++) {
            if (sel.options[i].value === val) return true;
        }
        return false;
    }

    if (partnerSel) { partnerSel.addEventListener('change', applyFilter); }
    if (poSearch)   { poSearch.addEventListener('input', applyFilter); }
    poSelect.addEventListener('change', fillFromPo);
    applyFilter();

    // Plan 28: kabul moduna göre sipariş seçici görünürlüğü (yalnız tek-sipariş modunda)
    var modeSel = document.getElementById('rcv-mode');
    var poGroup = poSelect.closest('.form-group');
    function applyMode() {
        if (!modeSel || !poGroup) return;
        var single = modeSel.value === 'SINGLE_PO';
        poGroup.style.display = single ? '' : 'none';
        poSelect.required = single;
        if (!single) { poSelect.value = ''; }
    }
    if (modeSel) { modeSel.addEventListener('change', applyMode); applyMode(); }
})();
</script>

@if (!Model.IsNew)
{
    <!-- Kabul Edilen Satırlar -->
    <div class="card mb-6">
        <div class="card-hdr bg-slate-50/50">
            <span class="card-ttl">KABUL EDİLEN ÜRÜNLER</span>
            @if (Model.Header.Status == DocStatus.Draft)
            {
                <button onclick="document.getElementById('add-line-modal').classList.remove('hidden')" class="btn btn-primary btn-sm" type="button" data-shortcut="Alt+N">
                    + Ürün Ekle
                </button>
            }
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>Miktar (Orijinal)</th>
                        <th>Miktar (Temel)</th>
                        <th>Parti (Lot) No</th>
                        <th class="text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <div class="font-bold text-slate-800">@line.ItemName</div>
                                <div class="text-xs text-slate-400 font-mono">@line.ItemCode</div>
                            </td>
                            <td class="font-semibold text-slate-700">@line.QtyOriginal.ToString("N2") @line.UomCode</td>
                            <td class="font-bold text-indigo-600 font-mono">@line.QtyBase.ToString("N2") @line.BaseUomCode</td>
                            <td class="text-slate-500 font-mono text-xs">
                                @(string.IsNullOrEmpty(line.LotNo) ? "-" : line.LotNo)
                            </td>
                            <td class="text-right">
                                @if (Model.Header.Status == DocStatus.Draft)
                                {
                                    <button class="btn btn-secondary btn-sm !text-red-500 hover:!bg-red-50/50 hover:!border-red-200 transition" type="button">Çıkar</button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Lines.Any())
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="w-10 h-10 text-slate-300">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                                    </svg>
                                    <p class="text-slate-400 font-medium">Henüz ürün eklenmemiş. Başlamak için "+ Ürün Ekle" düğmesine tıklayın.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Ürün Ekleme Modalı (Simple Modal) -->
    <div id="add-line-modal" class="hidden fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200 border border-slate-200">
            <div class="p-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                <h3 class="font-bold text-base text-slate-800">Mal Kabulüne Ürün Ekle</h3>
                <button onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition-all text-2xl font-light" type="button">&times;</button>
            </div>
            <form method="post" asp-page-handler="AddLine">
                <div class="p-6 space-y-4">
                    <div class="form-group mb-0">
                        <label class="form-label">
                            @(Model.Header.PurchaseOrderId.HasValue ? "Sipariş Satırından Seçin" : "Ürün / Barkod Arama")
                        </label>
                        <select name="itemId" id="rcv-line-item" class="form-ctrl w-full" required data-combobox>
                            <option value="">Seçiniz...</option>
                            @foreach (var item in Model.AvailableItems)
                            {
                                <option value="@item.Id" data-uom="@item.BaseUomId">[@item.Code] @item.Name</option>
                            }
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="form-group mb-0">
                            <label class="form-label">Birim</label>
                            <select name="uomId" id="rcv-line-uom" class="form-ctrl w-full" required>
                                <option value="">Birim Seçiniz...</option>
                                @foreach (var u in Model.AllUoms)
                                {
                                    <option value="@u.Id">@u.Name (@u.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">Miktar</label>
                            <input name="qty" type="number" step="0.0001" class="form-ctrl w-full" required />
                        </div>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Parti (Lot) Numarası</label>
                        <input name="lotNo" type="text" class="form-ctrl w-full" placeholder="İsteğe bağlı lot/parti no girin" />
                    </div>
                </div>
                <div class="p-5 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
                    <button type="button" onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="btn btn-secondary">İptal</button>
                    <button type="submit" class="btn btn-primary">Ürünü Kabul Et</button>
                </div>
            </form>
        </div>
    </div>

    @* Ürün seçilince temel birim (BaseUomId) otomatik seçilir *@
    <script>
    (function () {
        var itemSel = document.getElementById('rcv-line-item');
        var uomSel  = document.getElementById('rcv-line-uom');
        if (!itemSel || !uomSel) return;
        itemSel.addEventListener('change', function () {
            var uom = this.options[this.selectedIndex].getAttribute('data-uom');
            if (uom) { uomSel.value = uom; }
        });
    })();
    </script>
}

