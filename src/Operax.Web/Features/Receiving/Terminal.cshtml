@page
@model Operax.Web.Features.Receiving.TerminalModel
@{
    Layout = "_TerminalLayout";
    ViewData["Title"] = "Mal Kabul Terminali";
}

<div class="h-full overflow-y-auto p-4 space-y-4">

@if (Model.ActiveDoc == null)
{
    <!-- Belge Seç -->
    <div class="bg-slate-800 rounded-2xl p-4">
        <h2 class="text-xs font-bold uppercase text-slate-400 tracking-widest mb-3">Mal Kabul Belgesi Seç</h2>
        <div class="space-y-2">
            @foreach (var d in Model.PendingDocs)
            {
                <a href="?docId=@d.Id" class="flex items-center justify-between bg-slate-700 hover:bg-slate-600 active:bg-slate-500 rounded-xl p-4 transition-colors">
                    <div>
                        <div class="font-black text-white">@d.DocNo</div>
                        <div class="text-slate-400 text-xs">@(d.PartnerName ?? "—")</div>
                    </div>
                    <div class="text-right">
                        <div class="text-indigo-400 font-bold text-sm">@d.LineCount satır</div>
                        <div class="text-slate-500 text-xs">→</div>
                    </div>
                </a>
            }
            @if (!Model.PendingDocs.Any())
            {
                <div class="text-center py-8 text-slate-500 italic text-sm">Bekleyen mal kabul belgesi yok.</div>
            }
        </div>
    </div>
}
else
{
    var doc = Model.ActiveDoc;

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-500 rounded-xl p-3 text-center font-bold text-white text-sm">✓ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-500 rounded-xl p-3 text-center font-bold text-white text-sm">✗ @TempData["Error"]</div>
    }

    <!-- Aktif Belge Başlık -->
    <div class="bg-indigo-900 rounded-2xl p-4 border border-indigo-700">
        <div class="flex justify-between items-start">
            <div>
                <div class="text-[10px] text-indigo-300 uppercase font-bold">Aktif Belge</div>
                <div class="text-2xl font-black text-white">@doc.DocNo</div>
                <div class="text-indigo-300 text-sm">@(doc.PartnerName ?? "—")</div>
            </div>
            <a href="?" class="bg-slate-700 text-slate-300 text-xs px-3 py-1.5 rounded-lg font-bold">← Geri</a>
        </div>
    </div>

    <!-- Barkod Okutma Formu -->
    <form method="post" asp-page-handler="Scan" asp-route-docId="@doc.Id" class="bg-slate-800 rounded-2xl p-4 space-y-3">
        <div>
            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Barkod</label>
            <input name="barcode" type="text" autofocus autocomplete="off" required
                   class="w-full bg-slate-700 border border-slate-600 rounded-xl px-4 py-4 text-white font-mono text-lg focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                   placeholder="Barkod okut veya gir..." />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Lot No (opsiyonel)</label>
                <input name="lotNo" type="text" autocomplete="off"
                       class="w-full bg-slate-700 border border-slate-600 rounded-xl px-4 py-3 text-white font-mono text-sm focus:outline-none focus:border-indigo-500"
                       placeholder="LOT-001" />
            </div>
            <div>
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Miktar</label>
                <input name="qty" type="number" inputmode="decimal" step="0.001" min="0.001" value="1" required
                       class="w-full bg-slate-700 border border-slate-600 rounded-xl px-4 py-3 text-white font-mono text-lg focus:outline-none focus:border-indigo-500" />
            </div>
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white py-4 rounded-2xl text-lg font-black uppercase tracking-wide transition-all">
            Ekle ✓
        </button>
    </form>

    <!-- Satır Listesi -->
    <div class="bg-slate-800 rounded-2xl overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-700">
            <h3 class="text-xs font-bold uppercase text-slate-400 tracking-widest">Satırlar (@doc.Lines.Count)</h3>
        </div>
        <div class="divide-y divide-slate-700">
            @foreach (var line in doc.Lines)
            {
                <div class="px-4 py-3 flex items-center justify-between @(line.IsComplete ? "opacity-60" : "")">
                    <div>
                        <div class="font-bold text-white text-sm">@line.ItemCode</div>
                        <div class="text-slate-400 text-xs">@line.ItemName@(line.LotNo != null ? $" · {line.LotNo}" : "")</div>
                    </div>
                    <div class="text-right">
                        <div class="font-mono font-bold @(line.IsComplete ? "text-green-400" : "text-amber-400")">
                            @line.QtyReceived.ToString("N2") / @line.QtyExpected.ToString("N2")
                        </div>
                        <div class="text-[10px] @(line.IsComplete ? "text-green-500" : "text-slate-500")">
                            @(line.IsComplete ? "✓ Tamamlandı" : "Bekliyor")
                        </div>
                    </div>
                </div>
            }
            @if (!doc.Lines.Any())
            {
                <div class="px-4 py-8 text-center text-slate-500 italic text-sm">Henüz satır eklenmedi.</div>
            }
        </div>
    </div>
}
</div>

@section Scripts {
<script>
    // Barkod input'u her sayfa yüklenmesinde otomatik fokusla
    document.addEventListener('DOMContentLoaded', () => {
        const bc = document.querySelector('input[name="barcode"]');
        if (bc) bc.focus();
    });
</script>
}
