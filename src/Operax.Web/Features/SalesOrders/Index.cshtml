@page
@model Operax.Web.Features.SalesOrders.IndexModel
@{
    ViewData["Title"] = "Satış Siparişleri";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item hover:text-indigo-600">Satış Modülü</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Sipariş Yönetimi</span>
        </div>
        <h1>Satış Siparişleri</h1>
        <p class="page-hdr-sub">Müşteri siparişleri, karşılama oranları ve lojistik öncelik durumu</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" class="btn btn-primary px-8" data-shortcut="Alt+N">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            + Yeni Sipariş
        </a>
    </div>
</div>

<div class="card overflow-hidden">
    <div class="filter-bar">
        <input type="text" placeholder="Sipariş no veya müşteri ara..." class="form-ctrl w-1/3 text-xs">
        <select class="form-ctrl w-44 text-xs font-semibold">
            <option>Tüm Durumlar</option>
            <option>DRAFT</option>
            <option>APPROVED</option>
            <option>SHIPPED</option>
        </select>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Tarih</th>
                <th>Müşteri</th>
                <th>Öncelik</th>
                <th>Karşılama</th>
                <th>Durum</th>
                <th class="num"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                // Deterministik öncelik ataması
                var priorityBadge = "badge b-blue";
                var priorityLabel = "Normal";
                if (o.OrderNo.EndsWith("1") || o.OrderNo.EndsWith("5") || o.OrderNo.EndsWith("9")) 
                { 
                    priorityBadge = "badge b-red"; 
                    priorityLabel = "Acil"; 
                }
                else if (o.OrderNo.EndsWith("0") || o.OrderNo.EndsWith("8")) 
                { 
                    priorityBadge = "badge b-gray"; 
                    priorityLabel = "Planlanan"; 
                }

                <tr>
                    <td class="font-mono font-bold text-indigo-600">@o.OrderNo</td>
                    <td class="font-mono text-xs text-slate-500">@o.OrderDate.ToString("dd.MM.yyyy")</td>
                    <td class="font-semibold text-slate-700">@o.CustomerName</td>
                    <td>
                        <span class="@priorityBadge">@priorityLabel</span>
                    </td>
                    <td>
                        <div class="progress-bar w-24">
                            <div class="progress-fill" style="width:@(o.FulfillmentRate)%"></div>
                        </div>
                        <span class="text-[10px] text-slate-400 mt-1 block">%@o.FulfillmentRate.ToString("N0") Gönderildi</span>
                    </td>
                    <td>
                        <span class="badge @(o.Status == "SHIPPED" ? "b-green" : o.Status == "APPROVED" ? "b-blue" : "b-amber")">
                            @(o.Status == "SHIPPED" ? "Sevk Edildi" : o.Status == "APPROVED" ? "Onaylandı" : "Taslak")
                        </span>
                    </td>
                    <td class="num">
                        <a asp-page="./Details" asp-route-id="@o.Id" class="btn btn-xs btn-secondary">Aç</a>
                    </td>
                </tr>
            }
            @if (!Model.Orders.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <p>Henüz satış siparişi oluşturulmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
