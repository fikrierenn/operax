@page "{id:guid}"
@model Operax.Web.Features.Serial.DetailsModel
@using Operax.Web.Lib
@{
    ViewData["Title"] = $"Seri No: {Model.Serial.SerialNo}";
    var s = Model.Serial;
}

@if (s.Id == Guid.Empty)
{
    <div class="empty-state"><p>Seri numara bulunamadı.</p></div>
    return;
}

<div class="page-hdr">
    <div>
        <div class="flex items-center gap-3 mb-1">
            <h2 class="text-2xl font-bold font-mono tracking-tight text-[var(--text)]">@s.SerialNo</h2>
            @Html.Raw(UiHelpers.StatusBadgeHtml(s.Status, s.Status switch {
                SerialStatus.InStock    => "Depoda",
                SerialStatus.Shipped    => "Sevk Edildi",
                SerialStatus.Scrapped   => "Hurda",
                SerialStatus.Quarantine => "Karantina",
                _                       => s.Status
            }))
        </div>
        <p class="text-sm text-[var(--text-3)]">
            <span class="font-bold text-[var(--text)]">@s.ItemCode</span> — @s.ItemName
        </p>
    </div>
    <a asp-page="./Index" class="btn btn-secondary">← Listeye Dön</a>
</div>

<!-- Güncel Durum Kartı -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="card p-5">
        <div class="text-xs font-bold uppercase text-[var(--text-3)] tracking-widest mb-2">Güncel Konum</div>
        @if (s.WhCode != null)
        {
            <div class="text-lg font-mono font-bold text-[var(--brand-600)]">@s.WhCode / @(s.BinCode ?? "—")</div>
        }
        else
        {
            <div class="text-lg text-[var(--text-4)] italic">Depo dışı</div>
        }
    </div>
    <div class="card p-5">
        <div class="text-xs font-bold uppercase text-[var(--text-3)] tracking-widest mb-2">Bağlı Lot</div>
        <div class="text-lg font-mono font-bold text-[var(--text-2)]">@(s.LotNo ?? "—")</div>
    </div>
    <div class="card p-5">
        <div class="text-xs font-bold uppercase text-[var(--text-3)] tracking-widest mb-2">Sisteme Giriş</div>
        <div class="text-lg font-bold text-[var(--text-2)]">@s.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
</div>

<!-- Yaşam Döngüsü Zaman Çizelgesi -->
<div class="card">
    <div class="px-4 py-3 border-b bg-[var(--bg-2)]">
        <h3 class="font-bold text-xs uppercase text-[var(--text-3)] tracking-widest">Yaşam Döngüsü Geçmişi</h3>
    </div>
    <div class="divide-y">
        @foreach (var mv in Model.Movements)
        {
            <div class="px-4 py-4 flex items-start gap-4">
                <!-- Zaman çizelgesi noktası -->
                <div class="flex flex-col items-center pt-1">
                    <div class="w-3 h-3 rounded-full shrink-0 @(mv.MovementType switch {
                        MovementType.Receipt  => "bg-[var(--success)]",
                        MovementType.Issue    => "bg-[var(--danger)]",
                        MovementType.Transfer => "bg-[var(--info-text)]",
                        "CONSUMPTION"         => "bg-[var(--warn-text)]",
                        MovementType.CountAdj => "bg-[var(--warn-text)]",
                        _                     => "bg-[var(--text-mute)]"
                    })"></div>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5">
                        @Html.Raw(UiHelpers.StatusBadgeHtml(mv.MovementType, mv.MovementType switch {
                            MovementType.Receipt    => "Mal Kabul Girişi",
                            MovementType.Issue      => "Sevkiyat Çıkışı",
                            MovementType.Transfer   => "Transfer",
                            "CONSUMPTION"           => "Üretim Tüketimi",
                            MovementType.Production  => "Üretim Kabulü",
                            MovementType.CountAdj   => "Sayım Düzeltmesi",
                            _                       => mv.MovementType
                        }))
                        @if (mv.SourceDoc != null)
                        {
                            <span class="text-xs font-mono text-[var(--text-3)]">@mv.SourceDoc</span>
                        }
                    </div>
                    <div class="flex items-center gap-4 text-xs text-[var(--text-4)]">
                        <span>@mv.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        @if (mv.WhCode != null)
                        {
                            <span class="font-mono">@mv.WhCode@(mv.BinCode != null ? $" / {mv.BinCode}" : "")</span>
                        }
                        @if (mv.LotNo != null)
                        {
                            <span>Lot: <span class="font-mono font-bold text-[var(--text-2)]">@mv.LotNo</span></span>
                        }
                    </div>
                </div>
                <div class="font-mono font-bold @(mv.QtyBase >= 0 ? "text-[var(--success)]" : "text-[var(--danger)]") text-sm shrink-0">
                    @(mv.QtyBase >= 0 ? "+" : "")@mv.QtyBase.ToString("N2")
                </div>
            </div>
        }
        @if (!Model.Movements.Any())
        {
            <div class="empty-state"><p>Hareket kaydı bulunamadı.</p></div>
        }
    </div>
</div>
