@page
@model Operax.Web.Features.Serial.IndexModel
@using Operax.Web.Lib
@{
    ViewData["Title"] = "Seri No Yönetimi";
}

<div class="page-hdr">
    <div>
        <h2 class="text-2xl font-bold text-[var(--text)]">Seri Numara Takibi</h2>
        <p class="text-sm text-[var(--text-3)] mt-0.5">Tekil ürün bazlı seri numarası ve konum izleme</p>
    </div>
</div>

<!-- KPI Özet Kartları -->
<div class="kpi-row">
    <div class="kpi">
        <span class="kpi-label">Toplam Seri No</span>
        <div class="kpi-val text-[var(--brand-600)]">@Model.Serials.Count()</div>
        <span class="kpi-sub">Kayıtlı seriler</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Depoda</span>
        <div class="kpi-val text-[var(--success)]">@Model.Serials.Count(x => x.Status == SerialStatus.InStock)</div>
        <span class="kpi-sub">Stokta bulunan</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Sevk Edildi</span>
        <div class="kpi-val text-[var(--text-3)]">@Model.Serials.Count(x => x.Status == SerialStatus.Shipped)</div>
        <span class="kpi-sub">Müşteriye gönderilen</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">Karantina</span>
        <div class="kpi-val text-[var(--warn-text)]">@Model.Serials.Count(x => x.Status == SerialStatus.Quarantine)</div>
        <span class="kpi-sub">Kontrol bekleyen</span>
    </div>
</div>

<!-- Arama Formu -->
<form method="get" class="mb-4">
    <div class="flex gap-2">
        <input type="text" name="q" value="@Model.Filter"
               placeholder="Seri no, ürün kodu veya ürün adı..."
               class="form-ctrl flex-1" />
        <button type="submit" class="btn btn-primary">Ara</button>
        @if (!string.IsNullOrEmpty(Model.Filter))
        {
            <a asp-page="./Index" class="btn btn-secondary">Temizle</a>
        }
    </div>
</form>

<div class="card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Seri No</th>
                <th>Ürün</th>
                <th>Durum</th>
                <th>Lot</th>
                <th>Konum</th>
                <th>Kayıt Tarihi</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Serials)
            {
                <tr>
                    <td class="font-mono font-bold text-[var(--brand-600)] tracking-tight">@s.SerialNo</td>
                    <td>
                        <div class="font-bold text-[var(--text)] text-sm">@s.ItemCode</div>
                        <div class="text-[10px] text-[var(--text-4)]">@s.ItemName</div>
                    </td>
                    <td>
                        @Html.Raw(UiHelpers.StatusBadgeHtml(s.Status, s.Status switch {
                            SerialStatus.InStock    => "Depoda",
                            SerialStatus.Shipped    => "Sevk Edildi",
                            SerialStatus.Scrapped   => "Hurda",
                            SerialStatus.Quarantine => "Karantina",
                            _                       => s.Status
                        }))
                    </td>
                    <td class="font-mono text-[var(--text-2)] text-xs">@(s.LotNo ?? "—")</td>
                    <td>
                        @if (s.WhCode != null)
                        {
                            <span class="font-mono text-[var(--text-3)] text-xs">@s.WhCode</span>
                            @if (s.BinCode != null)
                            {
                                <span class="text-[var(--text-4)] text-xs"> / </span>
                                <span class="font-mono font-bold text-[var(--brand-600)] text-xs">@s.BinCode</span>
                            }
                        }
                        else { <span class="text-[var(--text-mute)] text-xs italic">Konum yok</span> }
                    </td>
                    <td class="text-[var(--text-3)] text-xs">@s.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td class="text-right">
                        <a asp-page="./Details" asp-route-id="@s.Id" class="btn btn-secondary btn-sm">Geçmiş</a>
                    </td>
                </tr>
            }
            @if (!Model.Serials.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zm0 9.75c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zm9.75-9.75c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/>
                            </svg>
                            @if (!string.IsNullOrEmpty(Model.Filter))
                            {
                                <p>"@Model.Filter" için sonuç bulunamadı.</p>
                            }
                            else
                            {
                                <p>Henüz seri numara kaydı yok. Seri numaraları mal kabul sırasında oluşturulur.</p>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Serials.Count() == 500)
    {
        <div class="px-4 py-2 bg-[var(--warn-bg)] border-t border-[var(--warn-border)] text-xs text-[var(--warn-text)] font-medium">
            ⚠ En fazla 500 kayıt gösteriliyor. Listeyi daraltmak için arama yapın.
        </div>
    }
</div>
