@*
    Operax Ortak Boş Durum Partial
    Liste sayfalarında veri yokken gösterilir.
*@
@model Operax.Web.Lib.EmptyStateVm

<div class="empty-state">
    <div class="empty-state-icon">
        @if (!string.IsNullOrEmpty(Model.IconSvg))
        {
            @Html.Raw(Model.IconSvg)
        }
        else
        {
            <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="3"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
        }
    </div>
    <h3>@Model.Title</h3>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <p>@Model.Message</p>
    }
</div>
