@using Operax.Web.Lib
@using Dapper
@inject ICurrentUser CurrentUser
@inject ICurrentCompany CurrentCompany
@inject Db Db
@{
    IEnumerable<dynamic> userCompanies = Array.Empty<dynamic>();
    if (CurrentUser.IsAuthenticated)
    {
        using var conn = Db.Open();
        userCompanies = conn.Query("SELECT Id, Name FROM Company WHERE IsActive = 1 AND IsDeleted = 0 ORDER BY Name");
    }

    var displayCompanyName = string.IsNullOrEmpty(CurrentCompany.Name) || CurrentCompany.Name == "OPERAX"
        ? "Aydın Endüstri A.Ş."
        : CurrentCompany.Name;
        
    var displayCompanyLogo = string.IsNullOrEmpty(CurrentCompany.Name) || CurrentCompany.Name == "OPERAX"
        ? "AY"
        : (CurrentCompany.Name.Length >= 2 ? CurrentCompany.Name.Substring(0, 2).ToUpper() : CurrentCompany.Name[0].ToString().ToUpper());
        
    var displayCompanySub = string.IsNullOrEmpty(CurrentCompany.Name) || CurrentCompany.Name == "OPERAX"
        ? "TR · İstanbul"
        : L.T("Aktif Şirket", "Active Company");
}
<!DOCTYPE html>
<html lang="@(L.IsEn ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — OPERAX</title>

    <!-- Premium Typography: Plus Jakarta Sans (modern, geometric, readable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="height:100%;overflow:hidden;">

<div class="app">

    <!-- ════════════════════ SIDEBAR ════════════════════ -->
    <aside class="side">

        <!-- Logo & Brand Block -->
        <div class="side-brand">
            <!-- Brand mark: OX in indigo gradient -->
            <div class="side-brand-mark">OX</div>
            <div>
                <div class="side-brand-name">OPERAX</div>
                <div class="side-brand-sub">ERP & WMS Platform</div>
            </div>
        </div>

        <!-- Active Company Block -->
        <div class="side-company">
            <div class="side-company-logo">@displayCompanyLogo</div>
            <div style="flex:1;min-width:0;">
                <div class="side-company-name">@displayCompanyName</div>
                <div class="side-company-sub">@displayCompanySub</div>
            </div>
            <svg class="side-company-chevron" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </div>

        <!-- Navigation Menu -->
        <nav class="side-nav">

            <!-- ==================== GENEL ==================== -->
            <span class="side-group-label">@L.T("Genel", "General")</span>
            <a asp-page="/Dashboard/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                    <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                    <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                    <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                </svg>
                @L.T("Anasayfa", "Dashboard")
            </a>

            <!-- ==================== OPERASYON ==================== -->
            <span class="side-group-label">@L.T("Operasyon", "Operations")</span>
            
            <a asp-page="/PurchaseOrders/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                @L.T("Satınalma", "Purchasing")
            </a>
            
            <a asp-page="/SalesOrders/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                </svg>
                @L.T("Satış", "Sales")
            </a>

            <!-- Depo / WMS Collapsible -->
            <details class="side-group">
                <summary class="side-item">
                    <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    @L.T("Depo / WMS", "Warehouse / WMS")
                    <svg class="side-chevron" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </summary>
                <div class="side-sub-list">
                    <a asp-page="/Warehouses/Index" class="side-sub-item">@L.T("Depolar & Raflar", "Warehouses & Bins")</a>
                    <a asp-page="/Receiving/Index" class="side-sub-item">@L.T("Mal Kabul", "Receiving")</a>
                    <a asp-page="/Shipping/Index" class="side-sub-item">@L.T("Sevkiyat", "Shipping")</a>
                    <a asp-page="/Picking/Index" class="side-sub-item">@L.T("Toplama", "Picking")</a>
                    <a asp-page="/Transfer/Index" class="side-sub-item">@L.T("Transfer", "Transfer")</a>
                    <a asp-page="/CycleCount/Index" class="side-sub-item">@L.T("Stok Sayımı", "Cycle Count")</a>
                </div>
            </details>

            <!-- Stok / Envanter Collapsible -->
            <details class="side-group">
                <summary class="side-item">
                    <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                        <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    @L.T("Stok / Envanter", "Stock / Inventory")
                    <svg class="side-chevron" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </summary>
                <div class="side-sub-list">
                    <a asp-page="/Inventory/Balance/Index" class="side-sub-item">@L.T("Stok Bakiyesi", "Stock Balance")</a>
                    <a asp-page="/MasterData/Items/Index" class="side-sub-item">@L.T("Ürün Kartları", "Item Cards")</a>
                    <a asp-page="/LPN/Index" class="side-sub-item">@L.T("Palet (LPN)", "Pallet (LPN)")</a>
                    <a asp-page="/Lot/Index" class="side-sub-item">@L.T("Lot & SKT", "Lot & Expiry")</a>
                    <a asp-page="/Serial/Index" class="side-sub-item">@L.T("Seri Numaralar", "Serial Numbers")</a>
                </div>
            </details>

            <a asp-page="/Inventory/Movements/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/>
                </svg>
                @L.T("Stok Hareketleri", "Stock Movements")
            </a>

            <!-- Üretim Collapsible -->
            <details class="side-group">
                <summary class="side-item">
                    <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                        <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    @L.T("Üretim", "Production")
                    <svg class="side-chevron" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </summary>
                <div class="side-sub-list">
                    <a asp-page="/Production/Index" class="side-sub-item">@L.T("İş Emirleri", "Production Orders")</a>
                    <a asp-page="/Manufacturing/BOM/Index" class="side-sub-item">@L.T("BOM / Reçeteler", "BOM / Recipes")</a>
                    <a asp-page="/Manufacturing/WorkCenters/Index" class="side-sub-item">@L.T("İş Merkezleri", "Work Centers")</a>
                    <a asp-page="/Manufacturing/WorkOrders/Index" class="side-sub-item">@L.T("Üretim Rotaları", "Routings")</a>
                </div>
            </details>

            <!-- ==================== FİNANS ==================== -->
            <span class="side-group-label">@L.T("Finans", "Finance")</span>
            
            <a asp-page="/MasterData/Partners/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                @L.T("Cari Kartlar", "Partners")
            </a>
            
            <a asp-page="/Expenses/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/>
                </svg>
                @L.T("Muhasebe", "Accounting")
            </a>
            
            <a asp-page="/Budget/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zm9.75-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.625c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.25zM9 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125H10.125A1.125 1.125 0 019 19.875V8.625z"/>
                </svg>
                @L.T("Kasa / Banka", "Treasury")
            </a>

            <!-- ==================== SİSTEM ==================== -->
            <span class="side-group-label">@L.T("Sistem", "System")</span>
            
            <a asp-page="/Admin/Settings/Index" class="side-item">
                <svg class="side-item-icon" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
                @L.T("Ayarlar", "Settings")
            </a>

            <!-- Bottom padding for scroll safety -->
            <div style="height:12px;"></div>
        </nav>

        <!-- User Footer Block -->
        <div class="side-foot">
            @{
                var parts = CurrentUser.UserName.Split(' ', '@').Where(p => p.Length > 0).ToArray();
                var initials = parts.Length >= 2
                    ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
                    : (parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant() : "?");
                var adminRoles = new[] { "Admin", "Administrator" };
                var roleLabel = CurrentUser.Roles.Any(r => adminRoles.Contains(r))
                    ? L.T("Yönetici", "Admin")
                    : CurrentUser.Roles.FirstOrDefault() ?? L.T("Kullanıcı", "User");
            }
            <!-- Avatar -->
            <div class="side-foot-avatar">@initials</div>
            <div style="flex:1;min-width:0;">
                <div class="side-foot-name">@CurrentUser.UserName</div>
                <div class="side-foot-role">@roleLabel</div>
            </div>
            <!-- Logout Action -->
            <a asp-page="/Auth/Logout" title="@L.T("Çıkış", "Sign Out")" class="side-foot-action">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </a>
        </div>

    </aside>
    <!-- ════════════════════ /SIDEBAR ════════════════════ -->


    <!-- ════════════════════ MAIN CONTENT AREA ════════════════════ -->
    <div class="main">

        <!-- TOP BAR -->
        <header class="topbar">
            <!-- Search bar -->
            <div class="topbar-search">
                <span class="topbar-search-icon">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <input type="text" placeholder="@L.T("Evrak, ürün, tedarikçi, kullanıcı ara...", "Search document, item, partner...")" />
                <span class="topbar-search-kbd">⌘ K</span>
            </div>

            <div class="topbar-actions" style="display:flex;align-items:center;gap:6px;">

                <!-- Quick Action Plus Button -->
                <button class="icon-btn" title="@L.T("Hızlı Ekle", "Quick Add")">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>

                <!-- Notifications Bell -->
                <button class="icon-btn" title="@L.T("Bildirimler", "Notifications")">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <span class="icon-btn-dot"></span>
                </button>

                <!-- System Info Icon -->
                <button class="icon-btn" title="@L.T("Sistem Bilgisi", "System Info")">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>

                <!-- Company Switcher -->
                @if (CurrentUser.IsAuthenticated && userCompanies.Any())
                {
                    <form method="POST" action="/api/switch-company" style="display:inline-flex;align-items:center;margin:0;">
                        @Html.AntiForgeryToken()
                        <div style="display:flex;align-items:center;gap:6px;background:hsl(220,14%,96%);border:1px solid hsl(220,14%,90%);border-radius:9px;padding:5px 10px;height:32px;">
                            <!-- Company icon -->
                            <svg width="12" height="12" fill="none" stroke="hsl(215,16%,47%)" stroke-width="1.75" viewBox="0 0 24 24">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                            <select name="companyId" onchange="this.form.submit()" style="
                                background:transparent;border:none;outline:none;
                                font-size:12px;font-weight:600;
                                color:hsl(222,47%,20%);
                                cursor:pointer;
                                font-family:inherit;
                                max-width:140px;
                            ">
                                @foreach (var comp in userCompanies)
                                {
                                    bool isSelected = comp.Id == CurrentCompany.Id;
                                    <option value="@comp.Id" selected="@(isSelected ? "selected" : null)">@comp.Name</option>
                                }
                            </select>
                        </div>
                    </form>
                }

                <!-- Language Switcher -->
                <div style="display:flex;align-items:center;background:hsl(220,14%,96%);border:1px solid hsl(220,14%,90%);border-radius:9px;padding:3px;height:32px;">
                    <button id="lang-tr" onclick="setLanguage('tr-TR')" title="Türkçe" style="
                        padding:4px 9px;border-radius:6px;border:none;cursor:pointer;
                        font-size:11px;font-weight:700;font-family:inherit;
                        background:@(L.IsEn ? "transparent" : "white");
                        color:@(L.IsEn ? "hsl(215,16%,55%)" : "hsl(243,75%,50%)" );
                        box-shadow:@(L.IsEn ? "none" : "0 1px 3px hsl(0,0%,0%,0.08)");
                        transition:all 150ms ease;
                    ">TR</button>
                    <button id="lang-en" onclick="setLanguage('en-US')" title="English" style="
                        padding:4px 9px;border-radius:6px;border:none;cursor:pointer;
                        font-size:11px;font-weight:700;font-family:inherit;
                        background:@(L.IsEn ? "white" : "transparent");
                        color:@(L.IsEn ? "hsl(243,75%,50%)" : "hsl(215,16%,55%)" );
                        box-shadow:@(L.IsEn ? "0 1px 3px hsl(0,0%,0%,0.08)" : "none");
                        transition:all 150ms ease;
                    ">EN</button>
                </div>

                <!-- Date chip -->
                <div style="
                    font-size:11px;font-weight:600;
                    color:hsl(215,16%,50%);
                    background:hsl(220,14%,96%);
                    border:1px solid hsl(220,14%,90%);
                    border-radius:9px;
                    padding:5px 10px;
                    font-variant-numeric:tabular-nums;
                    display:flex;align-items:center;gap:5px;
                    height:32px;
                ">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                    @DateTime.Now.ToString(L.T("dd MMM yyyy", "yyyy-MM-dd"))
                </div>

            </div>
        </header>
        <!-- /TOP BAR -->

        <!-- PAGE CONTENT -->
        <main class="fade-in" style="flex:1;overflow-y:auto;padding:24px;background:hsl(220,14%,97%);">
            @RenderBody()
        </main>

    </div>
    <!-- ════════════════════ /MAIN CONTENT AREA ════════════════════ -->

</div>

<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/Shortcuts.js" asp-append-version="true"></script>
<script>
    // Language switcher (cookie-based)
    function setLanguage(culture) {
        const value = encodeURIComponent(`c=${culture}|uic=${culture}`);
        document.cookie = `.AspNetCore.Culture=${value};path=/;max-age=31536000`;
        window.location.reload();
    }

    // Active nav item detection — based on URL path
    (function () {
        const p = window.location.pathname.toLowerCase();
        document.querySelectorAll('a.side-item, a.side-sub-item').forEach(function(a) {
            const h = (a.getAttribute('href') || '').toLowerCase();
            if (h && (h === p || (h !== '/' && p.startsWith(h)))) {
                a.classList.add('active');
                // Auto-expand parent details group
                const group = a.closest('details.side-group');
                if (group) {
                    group.setAttribute('open', '');
                }
            }
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
