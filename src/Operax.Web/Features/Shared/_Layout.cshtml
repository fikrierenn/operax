@using Operax.Web.Lib
@inject ICurrentUser CurrentUser
@inject ICurrentCompany CurrentCompany
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — OPERAX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Inter font ailesi ve tam yükseklik zorunlu — Tailwind'e bırakılmıyor */
        html, body { height: 100%; font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 overflow-hidden h-full">

    <div class="flex h-screen">

        <!-- ===================== SIDEBAR ===================== -->
        <aside class="w-60 bg-white border-r border-slate-200 flex flex-col shrink-0">

            <!-- Logo -->
            <div class="flex items-center gap-3 px-5 py-4 border-b border-slate-200">
                <div class="w-9 h-9 bg-indigo-600 rounded-lg flex items-center justify-center
                            text-white font-black text-sm shadow-lg shadow-indigo-200 shrink-0">OX</div>
                <div>
                    <div class="font-black text-slate-800 tracking-tighter text-sm leading-none">OPERAX</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">v2.5 · Kurumsal ERP</div>
                </div>
            </div>

            <!-- Navigasyon -->
            <nav class="flex-1 overflow-y-auto py-2 px-2">
                <span class="nav-label">Ana Menü</span>
                <a asp-page="/Dashboard/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                    </svg>
                    Panel
                </a>

                <span class="nav-label">Tanımlamalar</span>
                <a asp-page="/MasterData/Items/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                    </svg>
                    Ürünler
                </a>
                <a asp-page="/MasterData/Partners/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                    Cari Hesaplar
                </a>
                <a asp-page="/Warehouses/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    Depolar & Raflar
                </a>

                <span class="nav-label">Satın Alma & Satış</span>
                <a asp-page="/PurchaseOrders/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Satın Alma Siparişi
                </a>
                <a asp-page="/SalesOrders/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                    </svg>
                    Satış Siparişleri
                </a>

                <span class="nav-label">Depo Operasyonu</span>
                <a asp-page="/Inventory/Balance/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                        <line x1="8" y1="18" x2="21" y2="18"/>
                        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/>
                        <line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                    Stok Bakiyesi
                </a>
                <a asp-page="/Receiving/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    Mal Kabul
                </a>
                <a asp-page="/Shipping/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="1" y="3" width="15" height="13" rx="1"/>
                        <path d="M16 8h4l3 5v3h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                    Sevkiyat
                </a>
                <a asp-page="/Picking/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/>
                        <path d="M9 12l2 2 4-4"/>
                    </svg>
                    Toplama
                </a>
                <a asp-page="/Transfer/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/>
                    </svg>
                    Transfer
                </a>
                <a asp-page="/CycleCount/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
                    </svg>
                    Stok Sayımı
                </a>

                <span class="nav-label">İzlenebilirlik</span>
                <a asp-page="/LPN/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    Palet (LPN)
                </a>
                <a asp-page="/Lot/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                        <path d="M8 14h.01M12 14h.01M16 14h.01"/>
                    </svg>
                    Lot & SKT
                </a>
                <a asp-page="/Serial/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zm0 9.75c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zm9.75-9.75c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/>
                    </svg>
                    Seri Numaralar
                </a>

                <span class="nav-label">Üretim</span>
                <a asp-page="/Production/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    İş Emirleri
                </a>
                <a asp-page="/Manufacturing/BOM/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    BOM / Reçeteler
                </a>
                <a asp-page="/Manufacturing/WorkCenters/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/>
                    </svg>
                    İş Merkezleri
                </a>
                <a asp-page="/Manufacturing/WorkOrders/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
                    </svg>
                    Üretim Rotaları
                </a>

                <span class="nav-label">Finans</span>
                <a asp-page="/Expenses/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/>
                    </svg>
                    Gider Faturaları
                </a>
                <a asp-page="/Budget/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zm9.75-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.625c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.25zM9 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125H10.125A1.125 1.125 0 019 19.875V8.625z"/>
                    </svg>
                    Bütçe & Nakit
                </a>

                <span class="nav-label">Sistem</span>
                <a asp-page="/Admin/Settings/Index" class="nav-item">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    Ayarlar
                </a>
            </nav>

            <!-- Kullanıcı bilgisi -->
            <div class="px-4 py-3 border-t border-slate-200 flex items-center gap-3">
                @{
                    // Kullanıcı adından en fazla 2 baş harf üretilir
                    var parts = CurrentUser.UserName.Split(' ', '@').Where(p => p.Length > 0).ToArray();
                    var initials = parts.Length >= 2
                        ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
                        : (parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant() : "?");
                    // Admin rolü varsa "Yönetici", yoksa ilk rol gösterilir
                    var adminRoles = new[] { "Admin", "Administrator" };
                    var roleLabel = CurrentUser.Roles.Any(r => adminRoles.Contains(r)) ? "Yönetici"
                        : CurrentUser.Roles.FirstOrDefault() ?? "Kullanıcı";
                }
                <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center
                            text-xs font-bold text-slate-600 shrink-0">@initials</div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs font-bold text-slate-800 truncate">@CurrentUser.UserName</div>
                    <div class="text-[10px] text-slate-400">@roleLabel</div>
                </div>
            </div>

        </aside>
        <!-- ================== /SIDEBAR ================== -->

        <!-- =================== ANA ALAN =================== -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

            <!-- Üst bar -->
            <header class="h-14 bg-white border-b border-slate-200 flex items-center gap-3 px-5 shrink-0">
                <div class="flex-1 font-bold text-slate-800 text-sm">@ViewData["Title"]</div>
                <div class="flex items-center gap-2">
                    <div class="px-3 py-1 bg-slate-50 border border-slate-200 rounded-full text-[11px] font-medium text-slate-500">
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </div>
                    @if (CurrentCompany.Id != Guid.Empty)
                    {
                        <!-- Aktif şirket adı cookie claim'inden gösterilir -->
                        <div class="px-3 py-1 bg-indigo-50 border border-indigo-100 rounded-full text-[11px] font-bold text-indigo-600">
                            @CurrentCompany.Name
                        </div>
                    }
                </div>
            </header>

            <!-- Sayfa içeriği -->
            <main class="flex-1 overflow-y-auto p-6 bg-slate-50">
                @RenderBody()
            </main>

        </div>
        <!-- ================= /ANA ALAN ================= -->

    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Shortcuts.js" asp-append-version="true"></script>
    <script>
        // URL path ile eşleşen nav item'a .active sınıfı eklenir
        const p = window.location.pathname.toLowerCase();
        document.querySelectorAll('a.nav-item').forEach(a => {
            const h = (a.getAttribute('href') || '').toLowerCase();
            if (h && (h === p || (h !== '/' && p.startsWith(h)))) a.classList.add('active');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
