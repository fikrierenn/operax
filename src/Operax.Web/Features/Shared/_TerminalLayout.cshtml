<!DOCTYPE html>
<html lang="tr" class="h-full bg-slate-900">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>TERM - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full text-slate-100 antialiased overflow-hidden select-none touch-none">
    <div class="flex flex-col h-full bg-slate-900">
        <!-- Terminal Header -->
        <header class="h-12 bg-slate-800 flex items-center justify-between px-4 shrink-0 border-b border-slate-700">
            <div class="flex items-center gap-2">
                <span class="bg-indigo-600 px-1.5 py-0.5 rounded text-[10px] font-bold">TERM</span>
                <h1 class="font-bold text-sm">@ViewData["Title"]</h1>
            </div>
            <div class="flex items-center gap-3">
                <span id="term-clock" class="text-[10px] font-mono opacity-60">00:00</span>
                <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
            </div>
        </header>

        <!-- Terminal Main Area -->
        <main class="flex-1 overflow-hidden">
            @* El-terminali tarama/aksiyon geri bildirimi — TempData bayrağı (flash+titreşim+bip) *@
            @if (TempData["Success"] is string termOk)
            {
                <div data-term-feedback="success" data-term-msg="@termOk" hidden></div>
            }
            @if (TempData["Error"] is string termErr)
            {
                <div data-term-feedback="error" data-term-msg="@termErr" hidden></div>
            }
            @RenderBody()
        </main>

        <!-- Terminal Quick Navbar (Optional) -->
        <footer class="h-14 bg-slate-800 grid grid-cols-4 gap-px shrink-0 border-t border-slate-700">
            <button onclick="history.back()" class="flex flex-col items-center justify-center hover:bg-slate-700 active:bg-slate-600 transition-colors">
                <div class="text-[10px] uppercase font-bold text-slate-400">Esc</div>
                <div class="text-[10px]">Geri</div>
            </button>
            <button onclick="document.querySelector('input,select')?.focus()" class="flex flex-col items-center justify-center hover:bg-slate-700 active:bg-slate-600 transition-colors">
                <div class="text-[10px] uppercase font-bold text-slate-400">F2</div>
                <div class="text-[10px]">Bul</div>
            </button>
            <a href="/Dashboard" class="flex flex-col items-center justify-center hover:bg-slate-700 active:bg-slate-600 transition-colors">
                <div class="text-[10px] uppercase font-bold text-slate-400">Alt+L</div>
                <div class="text-[10px]">Liste</div>
            </a>
            <button onclick="var f=document.querySelector('form'); if(f) f.requestSubmit();" class="col-span-1 bg-indigo-600 flex flex-col items-center justify-center active:bg-indigo-500 transition-colors">
                <div class="text-[10px] uppercase font-bold text-white/60">Enter</div>
                <div class="text-[10px] font-bold">Tamam</div>
            </button>
        </footer>
    </div>

    <script src="~/js/Shortcuts.js" asp-append-version="true"></script>
    <script src="~/js/terminal-scan.js" asp-append-version="true"></script>
    <script>
        // Terminal Clock
        function updateClock() {
            const now = new Date();
            document.getElementById('term-clock').textContent = 
                now.getHours().toString().padStart(2, '0') + ':' + 
                now.getMinutes().toString().padStart(2, '0');
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
