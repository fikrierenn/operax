@page "{id:guid?}"
@model Operax.Web.Features.Shipping.DetailsModel
@inject Operax.Web.Lib.IDictionaryLabels Dict
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Sevkiyat" : $"Sevkiyat {Model.Header.DocNo}";
}

<form method="post" id="main-form" class="fade-in">
    <input type="hidden" asp-for="Header.Id" />
    <div class="page-hdr">
        <div>
            <div class="flex items-center gap-2 mb-2 text-xs">
                <a asp-page="./Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                    <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                    Sevkiyat Listesi
                </a>
                <span class="text-[var(--text-4)]">/</span>
                <span class="text-[var(--text-2)] font-semibold">Sevkiyat Girişi</span>
            </div>
            <h1>@(Model.IsNew ? "Yeni Sevkiyat Kaydı" : $"Sevkiyat: {Model.Header.DocNo}")</h1>
            <p class="page-hdr-sub">Lojistik, taşıyıcı ve araç sevkiyat detayları</p>
        </div>
        <div class="page-hdr-r flex gap-2">
            <a asp-page="./Index" class="btn btn-secondary">
                Listeye Dön
            </a>
            @if (Model.IsNew || Model.Header.Status == DocStatus.Draft)
            {
                <button type="submit" class="btn btn-primary" data-shortcut="Alt+S">
                    Sevkiyatı Kaydet
                </button>
            }
            @* Plan 56 Faz D: POST hem DRAFT (doğrudan) hem PICKING/PICKED'ten. Stok burada çıkar (çıkış kapısı). *@
            @if (!Model.IsNew && (Model.Header.Status == DocStatus.Draft
                 || Model.Header.Status == DocStatus.Picking || Model.Header.Status == DocStatus.Picked))
            {
                <button type="submit" asp-page-handler="Post" class="btn btn-success" data-shortcut="Alt+P">
                    Sevkiyatı Tamamla (Onayla)
                </button>
            }
            @* İptal: POSTED → ters stok-flag; PICKING/PICKED → stok yok, sadece status+görev iptal (çıkış kapısı). *@
            @if (!Model.IsNew && (Model.Header.Status == DocStatus.Posted
                 || Model.Header.Status == DocStatus.Picking || Model.Header.Status == DocStatus.Picked))
            {
                var revMsg = Model.Header.Status == DocStatus.Posted
                    ? "Bu sevkiyat iptal edilecek ve ters stok hareketi yazılacak. Onaylıyor musunuz?"
                    : "Bu sevkiyat iptal edilecek (stok henüz çıkmadı, bağlı toplama görevi de iptal olur). Onaylıyor musunuz?";
                <button type="submit" asp-page-handler="Reverse" class="btn btn-danger"
                        onclick="return confirm('@revMsg');">
                    Sevkiyatı İptal Et
                </button>
            }
        </div>
    </div>

    <!-- Belge Başlığı -->
    <div class="card p-6 mb-8 grid grid-cols-1 md:grid-cols-4 gap-6 bg-[var(--surface)]">
        <div class="form-group mb-0">
            <label class="form-label">Çıkış Deposu</label>
            <select asp-for="Header.WarehouseId" class="form-ctrl w-full" required>
                <option value="">Depo Seçiniz...</option>
                @foreach (var wh in Model.Warehouses)
                {
                    <option value="@wh.Id">@wh.Code - @wh.Name</option>
                }
            </select>
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Taşıyıcı Firma</label>
            <input asp-for="Header.CarrierName" type="text" class="form-ctrl w-full" placeholder="Örn. Aras, Yurtiçi vb." />
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Araç Plakası</label>
            <input asp-for="Header.VehiclePlate" type="text" class="form-ctrl w-full" placeholder="34 ABC 123" />
        </div>
        <div class="form-group mb-0 flex flex-col justify-between items-start md:items-end">
            <label class="form-label md:text-right">Sevkiyat Durumu</label>
            <div class="mt-1">
                @Html.Raw(Dict.StatusBadge(Model.Header.Status))
            </div>
        </div>
    </div>
</form>

@if (!Model.IsNew)
{
    <!-- Sevkiyat Satırları -->
    <div class="card mb-6">
        <div class="card-hdr bg-[var(--bg-2)]">
            <span class="card-ttl">SEVKİYAT SATIRLARI</span>
            @if (Model.Header.Status == DocStatus.Draft)
            {
                <button onclick="document.getElementById('add-line-modal').classList.remove('hidden')" class="btn btn-primary btn-sm" type="button" data-shortcut="Alt+N">
                    + Ürün Ekle
                </button>
            }
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Ürün / SKU</th>
                        <th>Sipariş No</th>
                        <th class="text-right">Miktar (Sevk)</th>
                        <th class="text-right">Birim</th>
                        <th class="text-right">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <div class="font-bold text-[var(--text)]">@line.ItemName</div>
                                <div class="text-xs text-[var(--text-4)] font-mono">@line.ItemCode</div>
                              </td>
                              <td><span class="text-[var(--brand-600)] font-bold font-mono">@line.SourceOrderNo</span></td>
                              <td class="text-right font-bold text-[var(--text-2)]">@line.QtyOriginal.ToString("N2")</td>
                              <td class="text-right text-[var(--text-3)] font-semibold text-xs">@line.UomCode</td>
                              <td class="text-right">
                                  @if (Model.Header.Status == DocStatus.Draft)
                                  {
                                      <button class="btn btn-secondary btn-sm !text-[var(--danger)] hover:!bg-[var(--danger-bg)] hover:!border-[var(--danger-border)] transition" type="button">Çıkar</button>
                                  }
                              </td>
                          </tr>
                      }
                      @if (!Model.Lines.Any())
                      {
                          <tr>
                              <td colspan="5">
                                  <div class="empty-state">
                                      <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="w-10 h-10 text-[var(--text-mute)]">
                                          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                                      </svg>
                                      <p class="text-[var(--text-4)] font-medium">Bu sevkiyata henüz ürün eklenmedi. Başlamak için "+ Ürün Ekle" düğmesine tıklayın.</p>
                                  </div>
                              </td>
                          </tr>
                      }
                  </tbody>
              </table>
          </div>
      </div>

      <!-- Ürün Ekle Modal -->
      <div id="add-line-modal" class="hidden fixed inset-0 bg-[var(--overlay)] backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div class="bg-[var(--surface)] rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200 border border-[var(--border)]">
              <div class="p-5 border-b border-[var(--border)] flex justify-between items-center bg-[var(--bg-2)]">
                  <h3 class="font-bold text-base text-[var(--text)]">Sevkiyata Ürün Ekle</h3>
                  <button onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="text-[var(--text-4)] hover:text-[var(--text-2)] transition-all text-2xl font-light" type="button">&times;</button>
              </div>
              <form method="post" asp-page-handler="AddLine">
                  <div class="p-6 space-y-4">
                      <input type="hidden" name="id" value="@Model.Header.Id" />
                      <div class="form-group mb-0">
                          <label class="form-label">Açık Satış Siparişi</label>
                          <select name="soLineId" class="form-ctrl w-full" required>
                              <option value="">Sipariş Seçin...</option>
                              @foreach (var order in Model.OpenSalesOrders) { <option value="@order.Id">@order.Code</option> }
                          </select>
                          <p class="text-xs text-[var(--text-4)] mt-1 italic">Not: Seçilen satış siparişindeki tüm açık kalemler otomatik olarak sevkiyata aktarılacaktır.</p>
                      </div>
                  </div>
                  <div class="p-5 bg-[var(--bg-2)] border-t border-[var(--border)] flex justify-end gap-3">
                      <button type="button" onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="btn btn-secondary">İptal</button>
                      <button type="submit" class="btn btn-primary">Ekle</button>
                  </div>
              </form>
          </div>
      </div>
}
