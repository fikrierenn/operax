@page
@model Operax.Web.Features.Shipping.IndexModel
@{
    ViewData["Title"] = "Sevkiyat Yönetimi";
}

<div class="flex items-start justify-between mb-8">
    <div>
        <h1 class="text-2xl font-black text-slate-800 tracking-tight">Sevkiyat & Çıkış İşlemleri</h1>
        <p class="text-sm text-slate-500 mt-1">Sipariş paketleme ve müşteriye gönderim süreçleri</p>
    </div>
    <a asp-page="./Details" class="btn btn-primary px-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Sevkiyat
    </a>
</div>

<div class="card overflow-hidden">
    <div class="p-4 bg-slate-50 border-b">
        <input type="text" placeholder="Sevkiyat No veya Plaka ara..." class="w-1/3 bg-white border rounded-lg px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-indigo-600 transition-all" />
    </div>
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-[10px] font-bold uppercase text-slate-400">
            <tr>
                <th class="px-6 py-4 text-left">Sevkiyat No</th>
                <th class="px-6 py-4 text-left">Depo</th>
                <th class="px-6 py-4 text-left">Taşıyıcı / Plaka</th>
                <th class="px-6 py-4 text-center">Durum</th>
                <th class="px-6 py-4 text-right"></th>
            </tr>
        </thead>
        <tbody class="divide-y">
            @foreach (var s in Model.Shipments)
            {
                <tr class="hover:bg-slate-50/50">
                    <td class="px-6 py-4 font-bold text-slate-700">#@s.DocNo</td>
                    <td class="px-6 py-4 font-semibold text-slate-600">@s.WarehouseCode</td>
                    <td class="px-6 py-4">
                        <div class="font-medium text-slate-700">@s.CarrierName</div>
                        <div class="text-[10px] text-slate-400 uppercase tracking-wider font-bold">@s.VehiclePlate</div>
                    </td>
                    <td class="px-6 py-4 text-center">
                        @{ var sBadge = s.Status == "POSTED" ? "badge b-green" : s.Status == "CANCELLED" ? "badge b-red" : "badge b-indigo";
                           var sLabel = s.Status == "POSTED" ? "Tamamlandı" : s.Status == "CANCELLED" ? "İptal" : "Taslak"; }
                        <span class="@sBadge">@sLabel</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <a asp-page="./Details" asp-route-id="@s.Id" class="text-indigo-600 font-bold hover:underline">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
