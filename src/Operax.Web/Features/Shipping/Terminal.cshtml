@page
@model Operax.Web.Features.Shipping.TerminalModel
@{
    Layout = "_TerminalLayout";
    ViewData["Title"] = "Sevkiyat Terminali";
}

<div class="h-full overflow-y-auto p-4 space-y-4">

@if (Model.ActiveDoc == null)
{
    <div class="bg-slate-800 rounded-2xl p-4">
        <h2 class="text-xs font-bold uppercase text-slate-400 tracking-widest mb-3">Sevkiyat Belgesi Seç</h2>
        <div class="space-y-2">
            @foreach (var d in Model.PendingDocs)
            {
                <a href="?docId=@d.Id" class="flex items-center justify-between bg-slate-700 hover:bg-slate-600 active:bg-slate-500 rounded-xl p-4 transition-colors">
                    <div>
                        <div class="font-black text-white">@d.DocNo</div>
                    </div>
                    <div class="text-right">
                        <div class="text-indigo-400 font-bold text-sm">@d.LineCount satır</div>
                    </div>
                </a>
            }
            @if (!Model.PendingDocs.Any())
            {
                <div class="text-center py-8 text-slate-500 italic text-sm">Bekleyen sevkiyat belgesi yok.</div>
            }
        </div>
    </div>
}
else
{
    var doc = Model.ActiveDoc;

    @if (TempData["Success"] != null) { <div class="bg-green-500 rounded-xl p-3 text-center font-bold text-white">✓ @TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="bg-red-500 rounded-xl p-3 text-center font-bold text-white">✗ @TempData["Error"]</div> }

    <div class="bg-indigo-900 rounded-2xl p-4 border border-indigo-700 flex justify-between items-start">
        <div>
            <div class="text-[10px] text-indigo-300 uppercase font-bold">Sevkiyat</div>
            <div class="text-2xl font-black text-white">@doc.DocNo</div>
        </div>
        <a href="?" class="bg-slate-700 text-slate-300 text-xs px-3 py-1.5 rounded-lg font-bold">← Geri</a>
    </div>

    <form method="post" asp-page-handler="Scan" asp-route-docId="@doc.Id" class="bg-slate-800 rounded-2xl p-4 space-y-3">
        <div>
            <label class="text-[10px] font-bold text-slate-400 uppercase">Barkod</label>
            <input name="barcode" type="text" autofocus autocomplete="off" required
                   class="w-full bg-slate-700 border border-slate-600 rounded-xl px-4 py-4 text-white font-mono text-lg focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                   placeholder="Ürün barkodunu okut..." />
        </div>
        <div>
            <label class="text-[10px] font-bold text-slate-400 uppercase">Miktar</label>
            <input name="qty" type="number" inputmode="decimal" step="0.001" min="0.001" value="1" required
                   class="w-full bg-slate-700 border border-slate-600 rounded-xl px-4 py-3 text-white font-mono text-lg focus:outline-none focus:border-indigo-500" />
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white py-4 rounded-2xl text-lg font-black uppercase transition-all">
            Onayla ✓
        </button>
    </form>

    <div class="bg-slate-800 rounded-2xl overflow-hidden">
        <div class="px-4 py-3 border-b border-slate-700">
            <h3 class="text-xs font-bold uppercase text-slate-400 tracking-widest">Sevkiyat Satırları</h3>
        </div>
        <div class="divide-y divide-slate-700">
            @foreach (var line in doc.Lines)
            {
                <div class="px-4 py-3 flex items-center justify-between">
                    <div>
                        <div class="font-bold text-white text-sm">@line.ItemCode</div>
                        <div class="text-slate-400 text-xs">@line.ItemName</div>
                    </div>
                    <div class="text-right">
                        <div class="font-mono font-bold text-amber-400">
                            @line.QtyToShip.ToString("N2") @line.UomCode
                        </div>
                        <div class="text-[10px] text-slate-500">Sevk edilecek</div>
                    </div>
                </div>
            }
        </div>
    </div>
}
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const bc = document.querySelector('input[name="barcode"]');
        if (bc) bc.focus();
    });
</script>
}
