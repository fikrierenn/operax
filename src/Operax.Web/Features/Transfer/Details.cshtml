@page "{id:guid?}"
@model Operax.Web.Features.Transfer.DetailsModel
@{
    ViewData["Title"] = "Transfer Detayı";
}

<div class="flex items-start justify-between mb-8">
    <div>
        <div class="flex items-center gap-2 mb-2">
            <a asp-page="./Index" class="btn btn-secondary py-1 px-3 text-xs">Geri</a>
            <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">Transfer #@Model.Header.DocNo</span>
        </div>
        <h1 class="text-2xl font-black text-slate-800 tracking-tight">Stok Hareket Detayı</h1>
    </div>
    <form method="post">
        <input type="hidden" asp-for="Header.Id" />
        <button type="submit" class="btn btn-primary">Bilgileri Kaydet</button>
    </form>
</div>

<div class="grid grid-cols-3 gap-6">
    <div class="col-span-1">
        <div class="card p-6">
            <div class="text-[10px] font-bold uppercase text-slate-400 mb-4 pb-2 border-b">Genel Ayarlar</div>
            <div class="space-y-4">
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Transfer Tipi</label>
                    <select class="w-full px-3 py-2 border rounded-lg text-sm font-semibold outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="WH_TO_WH">Depolar Arası Transfer</option>
                        <option value="BIN_TO_BIN">Raf/Hücre Arası Transfer</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Kaynak Depo</label>
                    <select asp-for="Header.FromWarehouseId" class="w-full px-3 py-2 border rounded-lg text-sm font-semibold">
                        @foreach (var wh in Model.Warehouses) { <option value="@wh.Id">@wh.Code - @wh.Name</option> }
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Hedef Depo</label>
                    <select asp-for="Header.ToWarehouseId" class="w-full px-3 py-2 border rounded-lg text-sm font-semibold">
                        @foreach (var wh in Model.Warehouses) { <option value="@wh.Id">@wh.Code - @wh.Name</option> }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="col-span-2">
        <div class="card overflow-hidden">
            <div class="px-6 py-4 bg-slate-50 border-b flex justify-between items-center">
                <span class="text-sm font-bold text-slate-800">Transfer Satırları</span>
                <button onclick="document.getElementById('add-line-modal').classList.remove('hidden')" class="text-indigo-600 font-bold text-xs uppercase">+ Hareket Ekle</button>
            </div>
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-[10px] font-bold text-slate-400 uppercase">
                    <tr>
                        <th class="px-6 py-3 text-left">Ürün</th>
                        <th class="px-6 py-3 text-left">Kaynak Raf</th>
                        <th class="px-6 py-3 text-left">Hedef Raf</th>
                        <th class="px-6 py-3 text-right">Miktar</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td class="px-6 py-4">
                                <div class="font-bold">@line.ItemName</div>
                                <div class="text-[10px] text-slate-400">@line.ItemCode</div>
                            </td>
                            <td class="px-6 py-4 font-mono text-xs">@line.FromBinCode</td>
                            <td class="px-6 py-4 font-mono text-xs font-bold text-indigo-600">@line.ToBinCode</td>
                            <td class="px-6 py-4 text-right font-bold text-slate-700">@line.Qty.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="add-line-modal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl">
        <div class="p-6 border-b">
            <h3 class="font-bold text-lg">Stok Hareketi Ekle</h3>
        </div>
        <form method="post" asp-page-handler="AddLine">
            <div class="p-6 space-y-4">
                <input type="hidden" name="id" value="@Model.Header.Id" />
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Ürün</label>
                    <select name="itemId" class="w-full px-3 py-2 border rounded-lg text-sm">
                        @foreach (var item in Model.Items) { <option value="@item.Id">[@item.Code] @item.Name</option> }
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Kaynak Raf</label>
                        <select name="fromBinId" class="w-full px-3 py-2 border rounded-lg text-sm">
                            @foreach (var bin in Model.Bins.Where(b => b.WarehouseId == Model.Header.FromWarehouseId)) { <option value="@bin.Id">@bin.Code</option> }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Hedef Raf</label>
                        <select name="toBinId" class="w-full px-3 py-2 border rounded-lg text-sm">
                            @foreach (var bin in Model.Bins.Where(b => b.WarehouseId == Model.Header.ToWarehouseId)) { <option value="@bin.Id">@bin.Code</option> }
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-400 mb-1">Miktar</label>
                    <input type="number" name="qty" step="0.01" class="w-full px-3 py-2 border rounded-lg text-sm" required />
                </div>
            </div>
            <div class="p-4 bg-slate-50 border-t flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="px-4 py-2 text-sm font-bold text-slate-500">İptal</button>
                <button type="submit" class="btn btn-primary">Hareketi Ekle</button>
            </div>
        </form>
    </div>
</div>
