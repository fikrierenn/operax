@page "{id:guid?}"
@model Operax.Web.Features.Transfer.DetailsModel
@{
    ViewData["Title"] = "Transfer Detayı";
}

<form method="post" id="main-form" class="fade-in">
    <input type="hidden" asp-for="Header.Id" />
    <div class="page-hdr">
        <div>
            <div class="flex items-center gap-2 mb-2 text-xs">
                <a asp-page="./Index" class="btn btn-secondary btn-sm py-1 px-2.5 min-h-0">
                    <svg fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3" viewBox="0 0 24 24">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                    Transfer Listesi
                </a>
                <span class="text-slate-400">/</span>
                <span class="text-slate-600 font-semibold">Transfer Detayı</span>
            </div>
            <h1>Transfer Hareketi: #@Model.Header.DocNo</h1>
            <p class="page-hdr-sub">Depolar arası veya raflar arası stok hareket planlaması</p>
        </div>
        <div class="page-hdr-r flex gap-2">
            <a asp-page="./Index" class="btn btn-secondary">
                Listeye Dön
            </a>
            @if (Model.IsNew || Model.Header.Status == DocStatus.Draft)
            {
                <button type="submit" class="btn btn-primary" data-shortcut="Alt+S">
                    Bilgileri Kaydet
                </button>
            }
            @if (!Model.IsNew && Model.Header.Status == DocStatus.Posted)
            {
                <button type="submit" asp-page-handler="Reverse" class="btn btn-danger"
                        onclick="return confirm('Bu transfer iptal edilecek ve ters stok hareketi yazılacak. Onaylıyor musunuz?');">
                    Transferi İptal Et
                </button>
            }
          </div>
      </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="lg:col-span-1">
            <div class="card p-6 bg-white h-full">
                <div class="card-ttl mb-4 pb-2 border-b border-slate-100">TRANSFER AYARLARI</div>
                <div class="space-y-4">
                    @* Transfer tipi: kaynak/hedef depo seçilince JS türetir — hidden field DB'ye gider *@
                    <input type="hidden" asp-for="Header.TransferType" id="transfer-type-code" />
                    <div class="form-group mb-0">
                        <label class="form-label">Transfer Tipi</label>
                        <div id="transfer-type-badge" class="badge b-indigo text-sm px-3 py-1.5">—</div>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Kaynak Depo</label>
                        <select asp-for="Header.FromWarehouseId" id="from-wh" class="form-ctrl w-full" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var wh in Model.Warehouses)
                            {
                                <option value="@wh.Id" data-branch="@wh.BranchId">@wh.Code - @wh.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Hedef Depo</label>
                        <select asp-for="Header.ToWarehouseId" id="to-wh" class="form-ctrl w-full" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var wh in Model.Warehouses)
                            {
                                <option value="@wh.Id" data-branch="@wh.BranchId">@wh.Code - @wh.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div class="card mb-6 h-full flex flex-col">
                <div class="card-hdr bg-slate-50/50">
                    <span class="card-ttl">TRANSFER SATIRLARI</span>
                    <button onclick="document.getElementById('add-line-modal').classList.remove('hidden')" class="btn btn-primary btn-sm" type="button" data-shortcut="Alt+N">
                        + Hareket Ekle
                    </button>
                </div>
                <div class="overflow-x-auto flex-1">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Ürün</th>
                                <th>Kaynak Raf</th>
                                <th>Hedef Raf</th>
                                <th class="text-right">Miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>
                                        <div class="font-bold text-slate-800">@line.ItemName</div>
                                        <div class="text-xs text-slate-400 font-mono">@line.ItemCode</div>
                                    </td>
                                    <td><span class="font-mono text-xs text-slate-500 bg-slate-100 px-2 py-0.5 rounded">@line.FromBinCode</span></td>
                                    <td><span class="font-mono text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">@line.ToBinCode</span></td>
                                    <td class="text-right font-bold text-slate-700">@line.Qty.ToString("N2")</td>
                                </tr>
                            }
                            @if (!Model.Lines.Any())
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="empty-state">
                                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="w-10 h-10 text-slate-300">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                                            </svg>
                                            <p class="text-slate-400 font-medium">Henüz transfer satırı eklenmedi. Başlamak için "+ Hareket Ekle" düğmesine tıklayın.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Modal -->
<div id="add-line-modal" class="hidden fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-200 border border-slate-200">
        <div class="p-5 border-b border-slate-200 flex justify-between items-center bg-slate-50">
            <h3 class="font-bold text-base text-slate-800">Stok Hareketi Ekle</h3>
            <button onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 transition-all text-2xl font-light" type="button">&times;</button>
        </div>
        <form method="post" asp-page-handler="AddLine">
            <div class="p-6 space-y-4">
                <input type="hidden" name="id" value="@Model.Header.Id" />
                <div class="form-group mb-0">
                    <label class="form-label">Ürün</label>
                    <select name="itemId" class="form-ctrl w-full" required>
                        <option value="">Ürün Seçiniz...</option>
                        @foreach (var item in Model.Items)
                        {
                            <option value="@item.Id">[@item.Code] @item.Name</option>
                        }
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group mb-0">
                        <label class="form-label">Kaynak Raf</label>
                        <select name="fromBinId" class="form-ctrl w-full" required>
                            <option value="">Raf Seçiniz...</option>
                            @foreach (var bin in Model.Bins.Where(b => b.WarehouseId == Model.Header.FromWarehouseId))
                            {
                                <option value="@bin.Id">@bin.Code</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Hedef Raf</label>
                        <select name="toBinId" class="form-ctrl w-full" required>
                            <option value="">Raf Seçiniz...</option>
                            @foreach (var bin in Model.Bins.Where(b => b.WarehouseId == Model.Header.ToWarehouseId))
                            {
                                <option value="@bin.Id">@bin.Code</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Miktar</label>
                    <input type="number" name="qty" step="0.01" class="form-ctrl w-full" required />
                </div>
            </div>
            <div class="p-5 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('add-line-modal').classList.add('hidden')" class="btn btn-secondary">İptal</button>
                <button type="submit" class="btn btn-primary">Hareketi Ekle</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Transfer tipi türetme: kaynak/hedef depo BranchId karşılaştırması
    const BIN_TO_BIN = '@TransferTypeHelper.BinToBin';
    const WH_TO_WH   = '@TransferTypeHelper.WhToWh';
    const fromSel  = document.getElementById('from-wh');
    const toSel    = document.getElementById('to-wh');
    const badge    = document.getElementById('transfer-type-badge');
    const codeInp  = document.getElementById('transfer-type-code');

    function deriveType() {
        const fromOpt = fromSel.selectedOptions[0];
        const toOpt   = toSel.selectedOptions[0];
        if (!fromOpt?.value || !toOpt?.value) { badge.textContent = '—'; return; }

        const fromId     = fromOpt.value;
        const toId       = toOpt.value;
        const fromBranch = fromOpt.dataset.branch || '';
        const toBranch   = toOpt.dataset.branch   || '';

        let label, code;
        if (fromId === toId) {
            label = 'Raf / Hücre Arası';      code = BIN_TO_BIN;
        } else if (fromBranch && toBranch && fromBranch !== toBranch) {
            label = 'Şubeler Arası';           code = WH_TO_WH;
        } else if (fromBranch && fromBranch === toBranch) {
            label = 'Depo Arası (Aynı Şube)'; code = WH_TO_WH;
        } else {
            label = 'Depolar Arası';           code = WH_TO_WH;
        }
        badge.textContent = label;
        codeInp.value     = code;
    }

    fromSel.addEventListener('change', deriveType);
    toSel.addEventListener('change',   deriveType);
    deriveType(); // sayfa yüklendiğinde mevcut seçimden türet
})();
</script>
}

