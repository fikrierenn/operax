@page
@model Operax.Web.Features.Transfer.IndexModel
@{
    ViewData["Title"] = "Stok Transferleri";
}

<div class="flex items-start justify-between mb-8">
    <div>
        <h1 class="text-2xl font-black text-slate-800 tracking-tight">Stok Transfer & Hareketler</h1>
        <p class="text-sm text-slate-500 mt-1">Depolar ve raflar arası stok kaydırma işlemleri</p>
    </div>
    <a asp-page="./Details" class="btn btn-primary px-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Transfer
    </a>
</div>

<div class="card overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-slate-50 text-[10px] font-bold uppercase text-slate-400">
            <tr>
                <th class="px-6 py-3 text-left">Transfer No</th>
                <th class="px-6 py-3 text-left">Kaynak</th>
                <th class="px-6 py-3 text-center">Yön</th>
                <th class="px-6 py-3 text-left">Hedef</th>
                <th class="px-6 py-3 text-center">Durum</th>
                <th class="px-6 py-3 text-right"></th>
            </tr>
        </thead>
        <tbody class="divide-y">
            @foreach (var t in Model.Transfers)
            {
                <tr class="hover:bg-slate-50/50">
                    <td class="px-6 py-4 font-bold text-slate-700">#@t.DocNo</td>
                    <td class="px-6 py-4"><span class="font-bold">@t.FromWhCode</span></td>
                    <td class="px-6 py-4 text-center text-slate-300">
                        <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </td>
                    <td class="px-6 py-4"><span class="font-bold">@t.ToWhCode</span></td>
                    <td class="px-6 py-4 text-center">
                        <span class="badge b-gray">TASLAK</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <a asp-page="./Details" asp-route-id="@t.Id" class="text-indigo-600 font-bold hover:underline">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
