@page
@model Operax.Web.Features.Transfer.IndexModel
@{
    ViewData["Title"] = "Stok Transferleri";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item hover:text-indigo-600">Stok Modülü</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Depolar Arası Transfer</span>
        </div>
        <h1>Stok Transfer & Hareketler</h1>
        <p class="page-hdr-sub">Depolar ve raflar arası stok kaydırma işlemleri</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" class="btn btn-primary px-8" data-shortcut="Alt+N">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Transfer
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-glow brand"></div>
        <div class="kpi-icon bg-indigo-50 text-indigo-600">⏱️</div>
        <span class="kpi-label">Aktif Talepler</span>
        <div class="kpi-val text-slate-800">@Model.DraftCount</div>
        <span class="kpi-sub">Onay bekleyen taslaklar</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <div class="kpi-icon bg-emerald-50 text-emerald-600">✅</div>
        <span class="kpi-label">Tamamlanan Transferler</span>
        <div class="kpi-val text-slate-800">@Model.PostedCount</div>
        <span class="kpi-sub">Depolar arası sevk edilen</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <div class="kpi-icon bg-sky-50 text-sky-600">📦</div>
        <span class="kpi-label">Toplam Transfer Edilen</span>
        <div class="kpi-val text-slate-800">@Model.TotalTransferQty.ToString("N0")</div>
        <span class="kpi-sub">Adet bazında sevk edilen</span>
    </div>
</div>

<div class="card overflow-hidden mt-6">
    <form method="get" class="filter-bar">
        <input type="text" name="q" value="@Model.Q"
               placeholder="Transfer no ara..." class="form-ctrl w-1/3 text-xs" />
        <select name="statusFilter" class="form-ctrl w-44 text-xs font-semibold"
                onchange="this.form.submit()">
            <option value="">Tüm Durumlar</option>
            <option value="@DocStatus.Draft"  selected="@(Model.StatusFilter == DocStatus.Draft)">Taslak</option>
            <option value="@DocStatus.Posted" selected="@(Model.StatusFilter == DocStatus.Posted)">Onaylı</option>
        </select>
        <select name="branchFilter" class="form-ctrl w-48 text-xs font-semibold"
                onchange="this.form.submit()">
            <option value="">Tüm Şubeler</option>
            @foreach (var b in Model.Branches)
            {
                <option value="@b.Id" selected="@(Model.BranchFilter == b.Id)">@b.Text</option>
            }
        </select>
    </form>

    <table class="data-table">
        <thead>
            <tr>
                <th>Transfer No</th>
                <th>Tarih</th>
                <th>Kaynak Depo</th>
                <th class="text-center">Yön</th>
                <th>Hedef Depo</th>
                <th>Tip</th>
                <th>Kalem</th>
                <th>Durum</th>
                <th class="num"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Transfers)
            {
                <tr>
                    <td class="font-mono font-bold text-indigo-600">#@t.DocNo</td>
                    <td class="font-mono text-xs text-slate-500">@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="badge b-indigo font-bold">@t.FromWhCode</span>
                        @if (t.FromBranchName != null) { <div class="text-[10px] text-slate-400 mt-0.5">@t.FromBranchName</div> }
                    </td>
                    <td class="text-center text-slate-400">
                        <svg class="w-4 h-4 mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    </td>
                    <td>
                        <span class="badge b-teal font-bold">@t.ToWhCode</span>
                        @if (t.ToBranchName != null) { <div class="text-[10px] text-slate-400 mt-0.5">@t.ToBranchName</div> }
                    </td>
                    <td><span class="badge b-gray text-xs">@t.TypeLabel</span></td>
                    <td class="font-semibold text-slate-700">@t.LineCount Kalem</td>
                    <td>
                        <span class="badge @(t.Status == DocStatus.Posted ? "b-green" : "b-amber")">
                            @(t.Status == DocStatus.Posted ? "Tamamlandı" : "Taslak")
                        </span>
                    </td>
                    <td class="num">
                        <a asp-page="./Details" asp-route-id="@t.Id" class="btn btn-xs btn-secondary">Aç</a>
                    </td>
                </tr>
            }
            @if (!Model.Transfers.Any())
            {
                <tr>
                    <td colspan="8">
                        <div class="empty-state">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <p>Henüz stok transferi oluşturulmamış.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
