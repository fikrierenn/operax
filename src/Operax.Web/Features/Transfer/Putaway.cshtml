@page
@model Operax.Web.Features.Transfer.PutawayModel
@{
    ViewData["Title"] = "Raf Yerleştirme";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <h1>Raf Adresleme (Putaway)</h1>
        <p class="page-hdr-sub">Mal kabul alanındaki ürünleri uygun raf adreslerine yerleştirin.</p>
    </div>
</div>

<div class="card overflow-hidden">
    <div class="card-hdr">
        <div class="card-title">Mal Kabul Alanındaki Bekleyen Ürünler</div>
    </div>
    <div class="table-scroll">
    <table class="data-table min-w-[680px]">
        <thead>
            <tr>
                <th>Ürün / Palet</th>
                <th>Mevcut Raf</th>
                <th class="text-right">Miktar</th>
                <th>Hedef Raf Seçimi</th>
                <th class="text-right">İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.ItemsAtReceiving)
            {
                <tr>
                    <td>
                        <div class="font-bold text-[var(--brand-600)]">@s.ItemName</div>
                        <div class="text-[10px] text-[var(--text-4)] font-mono">@s.ItemCode</div>
                    </td>
                    <td class="font-mono text-[var(--text-3)] italic">@s.BinCode</td>
                    <td class="text-right font-mono font-bold">@s.Qty.ToString("N2")</td>
                    <td>
                        <form method="post" asp-page-handler="Putaway" class="flex gap-2 items-center" id="pa-@s.BinId">
                            <input type="hidden" name="itemId" value="@s.ItemId" />
                            <input type="hidden" name="fromBinId" value="@s.BinId" />
                            <input type="hidden" name="qty" value="@s.Qty" />
                            <select name="toBinId" class="form-ctrl text-xs" required>
                                <option value="">Raf Seç...</option>
                                @foreach (var bin in Model.StorageBins) { <option value="@bin.Id">@bin.Code</option> }
                            </select>
                        </form>
                    </td>
                    <td class="text-right">
                        <button type="submit" form="pa-@s.BinId" class="btn btn-primary btn-sm">Adresle</button>
                    </td>
                </tr>
            }
            @if (!Model.ItemsAtReceiving.Any())
            {
                <tr>
                    <td colspan="5"><div class="empty-state"><p>Mal kabul alanında bekleyen stok bulunmuyor.</p></div></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
