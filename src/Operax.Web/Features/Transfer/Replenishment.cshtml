@page
@model Operax.Web.Features.Transfer.ReplenishmentModel
@{
    ViewData["Title"] = "Replenishment Wizard";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h2 class="text-2xl font-bold italic tracking-tight uppercase text-indigo-900">Besleme Sihirbazı (Replenishment)</h2>
        <p class="text-slate-500 text-sm">Toplama raflarında kritik seviyenin altına düşen ürünleri ana stoktan besleyin.</p>
    </div>
    <div class="px-4 py-2 bg-indigo-50 border border-indigo-100 rounded-lg flex items-center gap-3">
        <div class="w-2 h-2 bg-indigo-500 rounded-full animate-pulse"></div>
        <span class="text-xs font-bold text-indigo-700 uppercase tracking-widest">Canlı İhtiyaç Analizi Aktif</span>
    </div>
</div>

<div class="grid grid-cols-1 gap-4">
    @foreach (var s in Model.Suggestions)
    {
        <div class="bg-white border rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-500 text-[10px] font-bold rounded">@s.ItemCode</span>
                    <h3 class="font-bold text-slate-800">@s.ItemName</h3>
                </div>
                <div class="flex items-center gap-6 text-sm">
                    <div class="flex flex-col">
                        <span class="text-[10px] text-slate-400 font-bold uppercase">Toplama Rafı</span>
                        <span class="font-mono font-bold text-indigo-600 uppercase">@s.PickingBinCode</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] text-slate-400 font-bold uppercase">Mevcut / Kritik</span>
                        <span class="font-mono font-bold text-red-500">@s.CurrentQty.ToString("N0") / @s.MinQty.ToString("N0")</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] text-slate-400 font-bold uppercase">Max Seviye</span>
                        <span class="font-mono font-bold text-slate-700">@s.MaxQty.ToString("N0")</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-4 border-l pl-6 border-slate-100">
                <div class="text-right">
                    <div class="text-[10px] text-slate-400 font-bold uppercase">Besleme İhtiyacı</div>
                    <div class="text-2xl font-black text-indigo-900">@s.NeededQty.ToString("N0") <span class="text-xs text-slate-400 font-normal">EACH</span></div>
                </div>
                <form method="post" asp-page-handler="CreateTransfer">
                    <input type="hidden" name="itemId" value="@s.ItemId" />
                    <input type="hidden" name="pickingBinId" value="@s.PickingBinId" />
                    <input type="hidden" name="neededQty" value="@s.NeededQty" />
                    <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-indigo-700 active:scale-95 transition-all text-sm shadow-lg shadow-indigo-100 uppercase tracking-widest">
                        Besleme Emri Oluştur
                    </button>
                </form>
            </div>
        </div>
    }

    @if (!Model.Suggestions.Any())
    {
        <div class="bg-slate-50 border-2 border-dashed border-slate-200 rounded-2xl p-24 text-center">
            <div class="text-slate-300 mb-4 flex justify-center">
                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-400">Harika! Tüm raflarınız dolu.</h3>
            <p class="text-slate-400 text-sm">Şu an besleme ihtiyacı olan bir toplama rafı bulunmuyor.</p>
        </div>
    }
</div>
