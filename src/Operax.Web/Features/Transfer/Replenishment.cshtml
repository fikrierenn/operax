@page
@model Operax.Web.Features.Transfer.ReplenishmentModel
@{
    ViewData["Title"] = "Raf Besleme";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <h1>Besleme Sihirbazı (Replenishment)</h1>
        <p class="page-hdr-sub">Toplama raflarında kritik seviyenin altına düşen ürünleri ana stoktan besleyin.</p>
    </div>
    <div class="page-hdr-r">
        <span class="badge badge-info"><span class="badge-dot"></span>Canlı İhtiyaç Analizi Aktif</span>
    </div>
</div>

<div class="grid grid-cols-1 gap-4">
    @foreach (var s in Model.Suggestions)
    {
        <div class="card p-6 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                    <span class="badge badge-neutral text-[10px]">@s.ItemCode</span>
                    <h3 class="font-bold text-[var(--text)]">@s.ItemName</h3>
                </div>
                <div class="flex flex-wrap items-center gap-6 text-sm">
                    <div class="flex flex-col">
                        <span class="text-[10px] text-[var(--text-4)] font-bold uppercase">Toplama Rafı</span>
                        <span class="font-mono font-bold text-[var(--brand-600)] uppercase">@s.PickingBinCode</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] text-[var(--text-4)] font-bold uppercase">Mevcut / Kritik</span>
                        <span class="font-mono font-bold text-[var(--danger)]">@s.CurrentQty.ToString("N0") / @s.MinQty.ToString("N0")</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] text-[var(--text-4)] font-bold uppercase">Max Seviye</span>
                        <span class="font-mono font-bold text-[var(--text-2)]">@s.MaxQty.ToString("N0")</span>
                    </div>
                    @if (s.PreferredSupplierName != null)
                    {
                        <div class="flex flex-col">
                            <span class="text-[10px] text-[var(--text-4)] font-bold uppercase">Tercih Tedarikçi</span>
                            <span class="font-bold text-[var(--text-2)]">
                                @s.PreferredSupplierName
                                @if (s.SupplierItemCode != null)
                                {
                                    <span class="font-mono text-[11px] text-[var(--text-4)]">(@s.SupplierItemCode)</span>
                                }
                                @if (s.LeadTimeDays != null)
                                {
                                    <span class="text-[11px] text-[var(--warn-text)] font-semibold">· @s.LeadTimeDays gün</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center gap-4 border-l border-[var(--border)] pl-6">
                <div class="text-right">
                    <div class="text-[10px] text-[var(--text-4)] font-bold uppercase">Besleme İhtiyacı</div>
                    <div class="text-2xl font-black text-[var(--brand-600)]">@s.NeededQty.ToString("N0") <span class="text-xs text-[var(--text-4)] font-normal">@s.UomCode</span></div>
                </div>
                <form method="post" asp-page-handler="CreateTransfer">
                    <input type="hidden" name="itemId" value="@s.ItemId" />
                    <input type="hidden" name="pickingBinId" value="@s.PickingBinId" />
                    <input type="hidden" name="neededQty" value="@s.NeededQty" />
                    <button type="submit" class="btn btn-primary">Besleme Emri Oluştur</button>
                </form>
            </div>
        </div>
    }

    @if (!Model.Suggestions.Any())
    {
        <div class="card p-16 text-center">
            <div class="text-[var(--text-mute)] mb-4 flex justify-center">
                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-[var(--text-3)]">Harika! Tüm raflarınız dolu.</h3>
            <p class="text-[var(--text-4)] text-sm">Şu an besleme ihtiyacı olan bir toplama rafı bulunmuyor.</p>
        </div>
    }
</div>
