@page
@model Operax.Web.Features.Transfer.TerminalModel
@{
    Layout = "_TerminalLayout";
    ViewData["Title"] = "Transfer Terminali";
}

<div class="h-full overflow-y-auto p-4 space-y-4">

@if (Model.ActiveTransfer == null)
{
    <div class="bg-slate-800 rounded-2xl p-4">
        <h2 class="text-xs font-bold uppercase text-slate-400 tracking-widest mb-3">Transfer Belgesi Seç</h2>
        <div class="space-y-2">
            @foreach (var t in Model.PendingTransfers)
            {
                <a href="?transferId=@t.Id" class="flex items-center justify-between bg-slate-700 hover:bg-slate-600 active:bg-slate-500 rounded-xl p-4 transition-colors">
                    <div>
                        <div class="font-black text-white">@t.DocNo</div>
                    </div>
                    <div class="text-indigo-400 font-bold text-sm">@t.LineCount satır →</div>
                </a>
            }
            @if (!Model.PendingTransfers.Any())
            {
                <div class="text-center py-8 text-slate-500 italic text-sm">Bekleyen transfer belgesi yok.</div>
            }
        </div>
    </div>
}
else
{
    var tr = Model.ActiveTransfer;

    @if (TempData["Success"] != null) { <div class="bg-green-500 rounded-xl p-3 text-center font-bold text-white">✓ @TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="bg-red-500 rounded-xl p-3 text-center font-bold text-white">✗ @TempData["Error"]</div> }

    <!-- Başlık -->
    <div class="bg-indigo-900 rounded-2xl p-4 border border-indigo-700 flex justify-between items-start">
        <div>
            <div class="text-[10px] text-indigo-300 uppercase font-bold">Transfer</div>
            <div class="text-2xl font-black text-white">@tr.DocNo</div>
            <div class="text-indigo-300 text-sm font-mono">@tr.FromWhCode → @tr.ToWhCode</div>
        </div>
        <a href="?" class="bg-slate-700 text-slate-300 text-xs px-3 py-1.5 rounded-lg font-bold">← Geri</a>
    </div>

    <!-- Onaylanmamış ilk satır -->
    var pendingLine = tr.Lines.FirstOrDefault(l => !l.IsConfirmed);
    @if (pendingLine != null)
    {
        <div class="bg-slate-800 rounded-2xl p-5">
            <div class="text-[10px] text-amber-400 uppercase font-bold mb-1">Taşı</div>
            <div class="text-2xl font-black text-white">@(pendingLine.FromBinCode ?? "—") → @(pendingLine.ToBinCode ?? "—")</div>
            <div class="bg-slate-700 rounded-xl p-3 my-3">
                <div class="font-black text-white text-lg">@pendingLine.ItemCode</div>
                <div class="text-slate-400 text-sm">@pendingLine.ItemName</div>
                @if (pendingLine.LotNo != null) { <div class="text-indigo-300 text-xs font-mono">Lot: @pendingLine.LotNo</div> }
                <div class="text-3xl font-black text-amber-400 mt-2">× @pendingLine.QtyBase.ToString("N2")</div>
            </div>

            <form method="post" asp-page-handler="ConfirmLine" asp-route-transferId="@tr.Id">
                <input type="hidden" name="lineId" value="@pendingLine.Id" />
                <input name="barcode" type="text" autofocus autocomplete="off" required
                       class="w-full bg-slate-700 border border-slate-600 rounded-xl px-4 py-4 text-white font-mono text-lg focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500 mb-3"
                       placeholder="Ürün barkodunu okut..." />
                <button type="submit" class="w-full bg-green-600 hover:bg-green-500 active:scale-95 text-white py-5 rounded-2xl text-xl font-black uppercase tracking-wide transition-all">
                    Onayla ✓
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="bg-green-900 border border-green-700 rounded-2xl p-8 text-center">
            <div class="text-5xl mb-3">🎉</div>
            <div class="text-green-300 font-black text-xl uppercase tracking-widest">Tüm Satırlar Onaylandı!</div>
            <p class="text-green-400 text-sm mt-2">Masaüstünden belgeyi onaylayın.</p>
            <a href="?" class="mt-4 inline-block bg-slate-700 text-white px-6 py-3 rounded-xl font-bold text-sm">Ana Menüye Dön</a>
        </div>
    }

    <!-- Onaylanan satırlar -->
    @if (tr.Lines.Any(l => l.IsConfirmed))
    {
        <div class="bg-slate-800 rounded-2xl overflow-hidden">
            <div class="px-4 py-3 border-b border-slate-700">
                <h3 class="text-xs font-bold uppercase text-green-400 tracking-widest">Onaylananlar (@tr.Lines.Count(l => l.IsConfirmed))</h3>
            </div>
            <div class="divide-y divide-slate-700">
                @foreach (var line in tr.Lines.Where(l => l.IsConfirmed))
                {
                    <div class="px-4 py-2 flex items-center justify-between opacity-60">
                        <div>
                            <div class="text-white text-sm font-bold">@line.ItemCode</div>
                            <div class="text-slate-400 text-xs">@line.FromBinCode → @line.ToBinCode</div>
                        </div>
                        <div class="font-mono text-green-400 text-sm font-bold">✓ @line.QtyBase.ToString("N2")</div>
                    </div>
                }
            </div>
        </div>
    }
}
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const bc = document.querySelector('input[name="barcode"]');
        if (bc) bc.focus();
    });
</script>
}
