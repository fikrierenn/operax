@page "{id:guid?}"
@model Operax.Web.Features.Warehouses.DetailsModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Depo" : $"Depo — {Model.Warehouse.Code}";
}
@* TempData banner _Layout'ta global render ediliyor — sayfa-içi tekrar yok *@

<div class="flex items-start justify-between mb-8">
    <div>
        <div class="flex items-center gap-2 mb-2">
            <a asp-page="./Index" class="btn btn-secondary py-1 px-3 text-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Geri
            </a>
            <span class="text-[10px] uppercase font-bold tracking-widest text-[var(--text-4)]">Depo Yönetimi / @(Model.IsNew ? "Yeni" : Model.Warehouse.Code)</span>
        </div>
        <h1 class="text-2xl font-bold text-[var(--text)] tracking-tight">@(Model.IsNew ? "Yeni Depo Kartı" : Model.Warehouse.Name)</h1>
        <p class="text-sm text-[var(--text-3)] mt-1">Depo bilgileri ve raf (hücre) organizasyonu</p>
    </div>
    <div>
        <button type="submit" form="warehouse-form" class="btn btn-primary px-8">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Kaydet
        </button>
    </div>
</div>

<div class="grid grid-cols-3 gap-6">
    <!-- SOL KOLON: Depo Bilgileri -->
    <div class="col-span-1">
        <div class="card p-6">
            <div class="text-xs font-bold uppercase tracking-wider text-[var(--text-4)] mb-6 pb-2 border-b">Genel Bilgiler</div>
            <form id="warehouse-form" method="post">
                <input type="hidden" asp-for="Warehouse.Id" />
                <div class="space-y-4">
                    <div>
                        <label class="form-label">Depo Kodu *</label>
                        <input asp-for="Warehouse.Code" class="form-ctrl" placeholder="örn. W01" required />
                    </div>
                    <div>
                        <label class="form-label">Depo Adı *</label>
                        <input asp-for="Warehouse.Name" class="form-ctrl" placeholder="örn. Merkez Lojistik" required />
                    </div>
                    <div>
                        <label class="form-label">Bağlı Şube</label>
                        <select asp-for="Warehouse.BranchId" class="form-ctrl">
                            <option value="">— Şubesiz / Merkez —</option>
                            @foreach (var b in Model.BranchDdl)
                            {
                                <option value="@b.Id">@b.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-8 p-4 bg-[var(--brand-tint-08)] rounded-2xl border border-[var(--brand-tint-15)] flex items-center justify-between">
                    <div>
                        <div class="text-xs font-bold text-[var(--brand-600)]">Aktif Durum</div>
                        <div class="text-[10px] text-[var(--brand-500)] font-medium">Bu depo kullanıma açık mı?</div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" asp-for="Warehouse.IsActive" class="w-5 h-5 accent-[var(--brand-500)] rounded">
                    </label>
                </div>
            </form>
        </div>
    </div>

    <!-- SAĞ KOLON: Hücre / Raf Yönetimi -->
    <div class="col-span-2">
        @if (!Model.IsNew)
        {
            <div class="card overflow-hidden">
                <div class="card-hdr">
                    <div>
                        <h3 class="text-sm font-bold text-[var(--text)]">Tanımlı Hücreler (Raflar)</h3>
                        <p class="text-[11px] text-[var(--text-3)]">@Model.Bins.Count() adet adres kayıtlı</p>
                    </div>
                    <button type="button" onclick="document.getElementById('bin-modal').style.display='flex'" class="btn btn-secondary hover:bg-[var(--surface)] py-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                        Yeni Hücre Ekle
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="data-table w-full">
                        <thead class="bg-[var(--surface-2)] text-[10px] font-bold uppercase text-[var(--text-4)]">
                            <tr>
                                <th class="px-6 py-3 text-left">Hücre Kodu</th>
                                <th class="px-6 py-3 text-left">Bölge</th>
                                <th class="px-6 py-3 text-center">İşlev</th>
                                <th class="px-6 py-3 text-right"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y border-t">
                            @foreach (var bin in Model.Bins)
                            {
                                <tr class="hover:bg-[var(--surface-2)] transition-colors">
                                    <td class="px-6 py-4 font-bold font-mono text-[var(--brand-500)]">@bin.Code</td>
                                    <td class="px-6 py-4 text-[var(--text-3)]">@(string.IsNullOrEmpty(bin.Zone) ? "-" : bin.Zone)</td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center justify-center gap-1.5">
                                            @if (bin.IsPickingArea) { <span class="px-2 py-0.5 bg-[var(--info-bg)] text-[var(--info-text)] rounded text-[9px] font-bold" title="Toplama Alanı">T</span> }
                                            @if (bin.IsReceivingArea) { <span class="px-2 py-0.5 bg-[var(--warn-bg)] text-[var(--warn)] rounded text-[9px] font-bold" title="Mal Kabul Alanı">M</span> }
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <form method="post" asp-page-handler="DeleteBin" onsubmit="return confirm('Bu hücreyi silmek istediğinize emin misiniz?')">
                                            <input type="hidden" name="id" value="@Model.Warehouse.Id" />
                                            <input type="hidden" name="binId" value="@bin.Id" />
                                            <button type="submit" class="text-[var(--text-mute)] hover:text-[var(--danger)] p-1 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Bins.Any())
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-12 text-center text-[var(--text-4)] italic">
                                        Bu depoda henüz tanımlanmış bir hücre bulunmuyor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="h-full flex flex-col items-center justify-center border-2 border-dashed rounded-3xl p-12 text-center bg-[var(--surface)]">
                <div class="w-16 h-16 bg-[var(--surface-2)] rounded-full flex items-center justify-center mb-4">
                    <svg class="w-8 h-8 text-[var(--text-mute)]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                </div>
                <h4 class="font-bold text-[var(--text)]">Hücre Yönetimi Pasif</h4>
                <p class="text-sm text-[var(--text-4)] max-w-[280px] mt-1">Önce depo bilgilerini kaydederek raf adreslerini tanımlamaya başlayabilirsiniz.</p>
            </div>
        }
    </div>
</div>

<!-- Yeni Hücre Modal -->
<div id="bin-modal" class="fixed inset-0 z-50 bg-[var(--overlay)] backdrop-blur-sm flex items-center justify-center p-4" style="display:none">
    <div class="bg-[var(--surface)] rounded-3xl shadow-2xl w-full max-w-md overflow-hidden animate-in fade-in zoom-in duration-200">
        <div class="p-6 bg-[var(--surface-2)] border-b">
            <h3 class="font-bold text-[var(--text)] tracking-tight">Yeni Hücre Ekle</h3>
            <p class="text-xs text-[var(--text-3)]">Raf adresini ve özelliklerini belirleyin</p>
        </div>
        <form method="post" asp-page-handler="AddBin">
            <div class="p-6 space-y-5">
                <input type="hidden" name="id" value="@Model.Warehouse.Id" />
                <div class="form-row">
                    <div>
                        <label class="form-label">Hücre Kodu</label>
                        <input name="code" class="form-ctrl" placeholder="A-01-01" required />
                    </div>
                    <div>
                        <label class="form-label">Bölge</label>
                        <input name="zone" class="form-ctrl" placeholder="Raf Kat-1" />
                    </div>
                </div>
                <div class="space-y-3 pt-2">
                    <label class="flex items-center gap-3 p-3 bg-[var(--surface-2)] rounded-xl cursor-pointer hover:bg-[var(--brand-tint-08)] transition-colors group">
                        <input type="checkbox" name="isPicking" value="true" checked class="w-5 h-5 accent-[var(--brand-500)] rounded">
                        <div>
                            <div class="text-[11px] font-bold text-[var(--text-2)] group-hover:text-[var(--brand-600)]">Toplama Alanı</div>
                            <div class="text-[9px] text-[var(--text-4)]">Sipariş sevkiyatları için kullanılır</div>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 p-3 bg-[var(--surface-2)] rounded-xl cursor-pointer hover:bg-[var(--warn-bg)] transition-colors group">
                        <input type="checkbox" name="isReceiving" value="true" class="w-5 h-5 accent-[var(--warn)] rounded">
                        <div>
                            <div class="text-[11px] font-bold text-[var(--text-2)] group-hover:text-[var(--warn-text)]">Mal Kabul Alanı</div>
                            <div class="text-[9px] text-[var(--text-4)]">Hazırlık ve giriş alanları için</div>
                        </div>
                    </label>
                </div>
            </div>
            <div class="p-4 bg-[var(--surface-2)] border-t flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('bin-modal').style.display='none'" class="px-4 py-2 text-sm font-bold text-[var(--text-3)] hover:text-[var(--text)]">İptal</button>
                <button type="submit" class="btn btn-primary px-6">Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
window.addEventListener('click', e => {
    const m = document.getElementById('bin-modal');
    if (e.target === m) m.style.display = 'none';
});
</script>
}
