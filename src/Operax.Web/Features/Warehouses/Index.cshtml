@page
@model Operax.Web.Features.Warehouses.IndexModel
@{
    ViewData["Title"] = "Depolar & Raflar";
}

<div class="page-hdr">
    <div class="page-hdr-l">
        <div class="breadcrumb">
            <span class="breadcrumb-item hover:text-indigo-600">Tanımlamalar</span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-current">Depolar & Raflar</span>
        </div>
        <h1>Depo & Raf Yönetimi</h1>
        <p class="page-hdr-sub">Stok alanlarınızın, rafların ve hücrelerin merkezi yönetimi</p>
    </div>
    <div class="page-hdr-r">
        <a asp-page="./Details" class="btn btn-primary px-6" data-shortcut="Alt+N">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Yeni Depo
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-glow brand"></div>
        <div class="kpi-icon bg-indigo-50 text-indigo-600">🏭</div>
        <span class="kpi-label">Aktif Depolar</span>
        <div class="kpi-val text-slate-800">@Model.ActiveWarehouses</div>
        <span class="kpi-sub">Kullanımdaki fiziki depolar</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <div class="kpi-icon bg-emerald-50 text-emerald-600">🔢</div>
        <span class="kpi-label">Toplam Hücre / Raf</span>
        <div class="kpi-val text-slate-800">@Model.TotalBins</div>
        <span class="kpi-sub">Aktif tanımlı lokasyonlar</span>
    </div>
    <div class="kpi">
        <div class="kpi-glow success"></div>
        <div class="kpi-icon bg-sky-50 text-sky-600">📈</div>
        <span class="kpi-label">Lokasyonel Doluluk</span>
        <div class="kpi-val text-slate-800">%@Model.AverageCapacity.ToString("F1")</div>
        <span class="kpi-sub">Hücre doluluk simülasyonu</span>
    </div>
</div>

<div class="card overflow-hidden mt-6">
    <div class="filter-bar">
        <input type="text" placeholder="Depo kodu veya adı ara..." class="form-ctrl w-1/3 text-xs" />
        <select class="form-ctrl w-44 text-xs font-semibold">
            <option>Tüm Durumlar</option>
            <option>AKTİF</option>
            <option>PASİF</option>
        </select>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Depo Kodu</th>
                <th>Depo Tanımı</th>
                <th class="text-center">Durum</th>
                <th class="text-right">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wh in Model.Warehouses)
            {
                <tr class="cursor-pointer hover:bg-slate-50/50 transition-colors" onclick="window.location='@Url.Page("./Details", new { id = wh.Id })'">
                    <td>
                        <span class="badge b-indigo font-bold font-mono">@wh.Code</span>
                    </td>
                    <td>
                        <div class="font-bold text-slate-700 text-sm">@wh.Name</div>
                    </td>
                    <td class="text-center">
                        @if (wh.IsActive)
                        {
                            <span class="badge b-green">AKTİF</span>
                        }
                        else
                        {
                            <span class="badge b-gray">PASİF</span>
                        }
                    </td>
                    <td class="text-right" onclick="event.stopPropagation()">
                        <a asp-page="./Details" asp-route-id="@wh.Id" class="btn btn-secondary btn-sm">
                            Hücreler / Düzenle
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Warehouses.Any())
            {
                <tr>
                    <td colspan="4">
                        <div class="empty-state">
                            <svg class="w-12 h-12 text-slate-200 mb-4" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            <p>Henüz tanımlanmış bir depo bulunmuyor.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
