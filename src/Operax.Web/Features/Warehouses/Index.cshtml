@page
@model Operax.Web.Features.Warehouses.IndexModel
@{
    ViewData["Title"] = "Depolar & Raflar";
}

<div class="flex items-start justify-between mb-10">
    <div>
        <div class="flex items-center gap-2 mb-2">
            <a asp-page="/Admin/Settings/Index" class="btn btn-secondary py-1 px-3 text-xs">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Ayarlar
            </a>
            <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">Master Data / Depolar</span>
        </div>
        <h1 class="text-3xl font-black text-slate-800 tracking-tight">Depo & Raf Yönetimi</h1>
        <p class="text-sm text-slate-500 mt-1">Stok alanlarınızın, rafların ve hücrelerin merkezi yönetimi</p>
    </div>
    <a asp-page="./Details" class="btn btn-primary px-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Yeni Depo
    </a>
</div>

<div class="card overflow-hidden">
    <table class="w-full">
        <thead>
            <tr class="bg-slate-50 text-[10px] font-bold uppercase text-slate-400 tracking-widest">
                <th class="px-8 py-4 text-left">Depo Kodu</th>
                <th class="px-8 py-4 text-left">Depo Tanımı</th>
                <th class="px-8 py-4 text-center">Durum</th>
                <th class="px-8 py-4 text-right">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 italic-last">
            @foreach (var wh in Model.Warehouses)
            {
                <tr class="hover:bg-slate-50/50 transition-colors group">
                    <td class="px-8 py-5">
                        <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded font-mono text-xs font-bold ring-1 ring-slate-200">@wh.Code</span>
                    </td>
                    <td class="px-8 py-5">
                        <div class="font-bold text-slate-700">@wh.Name</div>
                    </td>
                    <td class="px-8 py-5 text-center">
                        @if (wh.IsActive)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/10">AKTİF</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-black bg-rose-50 text-rose-700 ring-1 ring-rose-600/10">PASİF</span>
                        }
                    </td>
                    <td class="px-8 py-5 text-right">
                        <a asp-page="./Details" asp-route-id="@wh.Id" class="inline-flex items-center gap-2 text-indigo-600 hover:text-indigo-900 font-bold text-xs uppercase tracking-tight group-hover:translate-x-1 transition-transform">
                            Düzenle / Hücreler
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Warehouses.Any())
            {
                <tr>
                    <td colspan="4" class="px-8 py-20 text-center">
                        <div class="flex flex-col items-center">
                            <svg class="w-12 h-12 text-slate-200 mb-4" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            <p class="text-slate-400 font-medium italic">Henüz tanımlanmış bir depo bulunmuyor.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
